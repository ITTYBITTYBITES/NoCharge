# NoCharge environment
#
# Both advertising networks are OFF by default and the shipped site renders no
# ad, no placeholder and no ad consent tag. See docs/ADVERTISING_STATE.md.
# Copy the lines you need into `.env` (gitignored) or your deploy environment.

# --- Google AdSense: one manual banner on eligible calm pages ---------------
# true  = render the single labeled banner + Google Privacy & messaging tag
# unset = no banner, no ad tag, no consent tag, no ad-choices footer control
# PUBLIC_ADSENSE_ENABLED=true

# --- Adsterra: Lab-only banner slots (requires its own consent basis) -------
# Nothing is rendered unless this is exactly 'true' AND the key is set.
# PUBLIC_ADSTERRA_ENABLED=true
# PUBLIC_ADSTERRA_KEY_MOBILE=
# PUBLIC_ADSTERRA_KEY_LEADERBOARD=
# PUBLIC_ADSTERRA_KEY_RAIL=
