# NoCharge environment
#
# Display advertising is off; monetization is affiliate links only (Awin +
# Amazon Associates). See docs/AWIN_INTEGRATION.md and docs/ADVERTISING_STATE.md.
# Copy the lines you need into `.env` (gitignored) or your deploy environment.
# Never commit real MIDs or publisher secrets.

# --- Awin affiliate program -------------------------------------------------
# true = load the consent-gated MasterTag and render paid merchant links.
# unset/false = no Awin request, no Awin link, no CSP widening (shipped default).
# PUBLIC_AWIN_ENABLED=true
# PUBLISHER ID IS NOT AN ENV VAR: it is the committed constant 3025417 in
# src/config/awin.ts.
# Merchant MIDs from Awin → Advertisers. A merchant without a valid numeric MID
# cannot render a link (a guessed MID pays nobody).
# PUBLIC_AWIN_MID_BRKOX=
# PUBLIC_AWIN_MID_CANGYU=

# --- Legacy Google AdSense (retired) ----------------------------------------
# Kept only so the old banner can be restored deliberately. Advertising is off.
# PUBLIC_ADSENSE_ENABLED=true
