# Optional GitHub Pages project-site path. Leave unset for a root/custom domain.
# VITE_BASE_PATH=/repository-name/

# AdSense / H5 Games Ads intentionally remain inactive by default.
# No values below load a provider in Phase 6A; production activation requires a
# separately approved code/policy change and a verified live ca-pub-... account ID.
VITE_ADSENSE_CLIENT_ID=
VITE_ADS_ENABLED=false
VITE_H5_ADS_ENABLED=false

# Per-brand external Square Online destinations are configured independently
# in src/integrations/storefronts.ts when that future phase is authorized.
