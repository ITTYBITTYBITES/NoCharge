{
  "name": "nocharge",
  "type": "module",
  "version": "1.0.0",
  "description": "Quick browser games, clear player guides, and no account required.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "check": "npm run test:unit && astro check",
    "build": "astro build",
    "test:e2e": "npm run build && playwright test",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "art:memory": "node scripts/generate-memory-match-art.mjs",
    "test:unit": "vitest run",
    "art:word": "node scripts/generate-word-tile-rush-art.mjs",
    "art:color": "node scripts/generate-color-flip-art.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITTYBITTYBITES/NoCharge.git"
  },
  "keywords": [
    "games",
    "browser-games",
    "astro"
  ],
  "author": "NoCharge",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ITTYBITTYBITES/NoCharge/issues"
  },
  "homepage": "https://nocharge.net",
  "dependencies": {
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
