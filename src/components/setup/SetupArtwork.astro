---
interface Props { name:'hero'|'keyboards'|'pointing'|'screens-stands'|'puzzles-desk'; sizes?:string; eager?:boolean; alt?:string }
const {name,sizes='(max-width: 48rem) calc(100vw - 2rem), 48rem',eager=false,alt=''}=Astro.props;
---
<picture class="setup-artwork" data-setup-artwork={name}>
 <source srcset={`/setup-art/${name}-800.webp 800w, /setup-art/${name}-1200.webp 1200w, /setup-art/${name}-1600.webp 1600w`} sizes={sizes} type="image/webp" />
 <img src={`/setup-art/${name}-1600.jpg`} srcset={`/setup-art/${name}-800.jpg 800w, /setup-art/${name}-1200.jpg 1200w, /setup-art/${name}-1600.jpg 1600w`} sizes={sizes} alt={alt} width="1600" height="900" loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async" />
</picture>
<style>.setup-artwork{display:block;overflow:hidden;aspect-ratio:16/9;border:1px solid var(--line);border-radius:var(--radius);background:#202527}.setup-artwork img{width:100%;height:100%;object-fit:cover}</style>
