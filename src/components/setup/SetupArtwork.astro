---
import type { SetupTopicId } from '../../lib/setup-topics';

export type SetupArtworkName =
  | 'hero'
  | 'keyboards'
  | 'pointing'
  | 'screens-stands'
  | 'puzzles-desk'
  | 'switches'
  | 'zoom-display'
  | 'desk-noise'
  | 'monitor'
  | 'speakers'
  | 'posture'
  | 'footrest'
  | 'lamp'
  | 'bias-light'
  | 'cables'
  | 'room-lighting'
  | 'screen-film'
  | 'monitor-calibration'
  | 'chair-posture'
  | 'lamp-light'
  | 'footrest-mat'
  | 'headphones'
  | 'large-dual-monitors';

interface Props {
  name: SetupArtworkName;
  /**
   * Must describe the width the image actually renders at for each grid
   * breakpoint. Defaults to the article reading column.
   */
  sizes?: string;
  eager?: boolean;
  alt?: string;
  /**
   * `panel` is a standalone framed illustration (index hero, article hero).
   * `card` sits flush at the top of a Setup card, so it drops its own border
   * and rounds only its top corners. That lets the card remove
   * `overflow: hidden`, which was clipping focus outlines.
   */
  variant?: 'panel' | 'card';
  topic?: SetupTopicId;
}

const {
  name,
  sizes = '(max-width: 54rem) calc(100vw - 2rem), 52rem',
  eager = false,
  alt,
  variant = 'panel',
  topic,
} = Astro.props;

const topicAltMap: Record<string, string> = {
  'keyboards': `Keyboards topic: ${name} editorial illustration showing compact layout, key feel, and sound sources on a calm desk`,
  'pointing-devices': `Pointing devices topic: ${name} illustration comparing mouse, trackpad, trackball, and touch tradeoffs`,
  'screens-and-stands': `Screens and stands topic: ${name} illustration showing monitor zoom, orientation, and stand stability`,
  'desk-and-comfort': `Desk and comfort topic: ${name} illustration of low-noise desk setup and comfort choices`,
  'offline-puzzles': `Offline puzzles topic: ${name} illustration of paper puzzle formats, binding, and answer keys`,
  'audio': `Audio topic: ${name} illustration showing headphones, speakers, and quiet-listening tradeoffs`,
  'lighting': `Lighting topic: ${name} illustration showing color temperature, bias lighting, and evening comfort`,
};

const defaultAltMap: Record<string, string> = {
  'hero': 'Quiet Setup hero: calm desk with keyboard, monitor, lamp, and puzzle book, 16:9 editorial illustration',
  'keyboards': 'Compact keyboard layout on a calm desk, 16:9 editorial illustration',
  'pointing': 'Pointing devices on a desk: mouse, trackpad, and trackball, 16:9',
  'screens-stands': 'Screens and stands: monitor and tablet stands on a desk, 16:9',
  'puzzles-desk': 'Offline puzzle book open on a desk with pencil, 16:9',
  'switches': 'Keyboard switches close-up showing linear, tactile, clicky types, 16:9',
  'zoom-display': 'Browser zoom versus larger display comparison, 16:9',
  'desk-noise': 'Low-noise desk setup without gaming extras, 16:9',
  'monitor': 'Monitor on a desk at eye level, 16:9 editorial illustration',
  'speakers': 'Small desk speakers for quiet play, 16:9',
  'posture': 'Desk posture illustration: upright seated figure at desk, 16:9',
  'footrest': 'Foot rest under a desk, 16:9 editorial illustration',
  'lamp': 'Desk lamp with adjustable arm on a calm desk, 16:9',
  'bias-light': 'Bias lighting strip behind monitor with warm glow, 16:9',
  'cables': 'Cable management tray under desk with organized cables, 16:9',
  'room-lighting': 'Ambient room lighting with monitor bias glow, 16:9',
  'screen-film': 'Anti-glare screen film with lifted corner on monitor, 16:9',
  'monitor-calibration': 'Monitor calibration settings for quiet gaming, 16:9',
  'chair-posture': 'Desk chair posture for long quiet sessions, 16:9',
  'lamp-light': 'Desk lamp warm versus cool light comparison, 16:9',
  'footrest-mat': 'Foot rest and floor mat comfort at desk, 16:9',
  'headphones': 'Open-back versus closed-back headphones for long sessions, 16:9',
  'large-dual-monitors': 'Large monitor versus dual monitors comparison, 16:9',
};

const computedAlt = alt ?? (topic ? topicAltMap[topic] : undefined) ?? defaultAltMap[name] ?? `Quiet Setup illustration: ${name} concept, 16:9 editorial art`;

const webpSrcset = [800, 1200, 1600].map((w) => `/setup-art/${name}-${w}.webp ${w}w`).join(', ');
const jpegSrcset = [800, 1200, 1600].map((w) => `/setup-art/${name}-${w}.jpg ${w}w`).join(', ');
---

<picture class:list={['setup-artwork', `setup-artwork--${variant}`]} data-setup-artwork={name} data-setup-topic={topic}>
  <source srcset={webpSrcset} sizes={sizes} type="image/webp" />
  <img
    src={`/setup-art/${name}-1200.jpg`}
    srcset={jpegSrcset}
    sizes={sizes}
    alt={computedAlt}
    width="1600"
    height="900"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<style>
  /* `display:block` is mandatory on a styled <picture>: an inline box ignores
     aspect-ratio and overflow, and a descendant `height:100%` then resolves
     against an ancestor instead of this frame. */
  .setup-artwork {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #202527;
  }

  .setup-artwork img {
    display: block;
    width: 100%;
    height: 100%;
    /* Sources and frames are both 16:9, so `cover` never crops. The rule is
       kept as a guard against sub-pixel rounding, not as a crop strategy. */
    object-fit: cover;
    object-position: center;
  }

  .setup-artwork--panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .setup-artwork--card {
    border-bottom: 1px solid var(--line);
    border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
  }

  /* A quiet, topic-specific hairline keeps repeated concepts distinguishable
     without adding decoration or a second nested panel. */
  .setup-artwork--card[data-setup-topic='keyboards'] {
    box-shadow: inset 0 -2px 0 rgba(136, 212, 203, 0.45);
  }
  .setup-artwork--card[data-setup-topic='pointing-devices'] {
    box-shadow: inset 0 -2px 0 rgba(122, 165, 209, 0.45);
  }
  .setup-artwork--card[data-setup-topic='screens-and-stands'] {
    box-shadow: inset 0 -2px 0 rgba(214, 164, 90, 0.45);
  }
  .setup-artwork--card[data-setup-topic='desk-and-comfort'] {
    box-shadow: inset 0 -2px 0 rgba(160, 176, 168, 0.45);
  }
  .setup-artwork--card[data-setup-topic='offline-puzzles'] {
    box-shadow: inset 0 -2px 0 rgba(211, 124, 106, 0.45);
  }

  @media (forced-colors: active) {
    .setup-artwork--panel,
    .setup-artwork--card {
      border: 1px solid CanvasText;
    }
  }
</style>
