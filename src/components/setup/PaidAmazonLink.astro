---
import { AMAZON_ALLOWED_HOSTS, AMAZON_ASSOCIATE_TAG } from '../../config/affiliate';

interface Props {
  label: string;
  url: string;
  purpose: string;
  suitableFor: string;
  limitations: string;
}

const { label, url, purpose, suitableFor, limitations } = Astro.props;
const parsed = new URL(url);
if (
  parsed.protocol !== 'https:' ||
  !AMAZON_ALLOWED_HOSTS.includes(parsed.hostname as (typeof AMAZON_ALLOWED_HOSTS)[number]) ||
  parsed.searchParams.get('tag') !== AMAZON_ASSOCIATE_TAG
) {
  throw new Error(`Invalid Amazon affiliate URL: ${url}`);
}
if (!/Amazon/i.test(label) || !/(paid link)/i.test(label)) {
  throw new Error('Paid-link text must identify Amazon and paid status.');
}
---

<div class="paid-recommendation" data-paid-recommendation>
  <a class="paid-link" href={url} rel="sponsored nofollow" data-amazon-paid-link>{label}</a>
  <dl>
    <div><dt>Why this link</dt><dd>{purpose}</dd></div>
    <div><dt>May suit</dt><dd>{suitableFor}</dd></div>
    <div><dt>Limitations</dt><dd>{limitations}</dd></div>
  </dl>
</div>

<style>
  .paid-recommendation {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid rgba(201, 139, 44, 0.55);
    border-radius: var(--radius);
    background: color-mix(in srgb, #b7791f 8%, var(--panel));
  }

  /* A plain underlined text link, never a filled yellow retail button. */
  .paid-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
    color: #ffd58a;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    overflow-wrap: break-word;
  }

  .paid-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  /* Terms stack above their descriptions by default. The previous 6rem
     label column left "Limitations" almost touching its value and squeezed
     the description into a very narrow column at 360-390px, so the two-column
     form is now opt-in from 34rem and uses a content-sized label track with a
     wide column gap. */
  .paid-recommendation dl {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .paid-recommendation dl div {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .paid-recommendation dt {
    color: var(--text);
    font-weight: 700;
    line-height: 1.45;
  }

  .paid-recommendation dd {
    margin: 0;
    min-width: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (min-width: 34rem) {
    .paid-recommendation dl div {
      /* `minmax(0, 1fr)` for the value: a fixed minimum would force the row
         wider than a narrow container (for example a 200%-zoom column that
         still matches this breakpoint) and push the block into horizontal
         overflow. The 34rem breakpoint already guarantees a wide value
         column; the floor is not needed to get one. */
      grid-template-columns: minmax(7rem, max-content) minmax(0, 1fr);
      gap: 0.35rem 1.5rem;
    }
  }

  @media (forced-colors: active) {
    .paid-recommendation {
      border: 1px solid CanvasText;
    }
    .paid-link {
      color: LinkText;
    }
  }
</style>
