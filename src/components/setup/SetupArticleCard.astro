---
import EvidenceLabel from './EvidenceLabel.astro';import SetupArtwork from './SetupArtwork.astro';
interface Props {slug:string;title:string;description:string;publishedDate:string;reviewedDate:string;topic:string;evidenceLevel:'editorial-research'|'personally-used'|'hands-on-tested';hasAffiliateLinks:boolean;artwork:'hero'|'keyboards'|'pointing'|'screens-stands'|'puzzles-desk'}
const p=Astro.props;const fmt=(d:string)=>new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});const topicLabels:Record<string,string>={keyboards:'Keyboards','pointing-devices':'Pointing devices','screens-and-stands':'Screens and stands','desk-and-comfort':'Desk and comfort','offline-puzzles':'Offline puzzles'};
---
<article class="setup-card">
 <SetupArtwork name={p.artwork} sizes="(max-width: 44rem) calc(100vw - 2rem), (max-width: 70rem) 50vw, 34rem" />
 <div class="setup-card__body"><p class="setup-card__topic">{topicLabels[p.topic]}</p><h3><a href={`/setup/${p.slug}/`}>{p.title}</a></h3><p>{p.description}</p><div class="setup-card__labels"><EvidenceLabel level={p.evidenceLevel}/>{p.hasAffiliateLinks&&<span class="paid-indicator">Contains paid links</span>}</div><footer><span>Published <time datetime={p.publishedDate}>{fmt(p.publishedDate)}</time></span><span>Reviewed <time datetime={p.reviewedDate}>{fmt(p.reviewedDate)}</time></span></footer></div>
</article>
<style>
.setup-card{position:relative;display:grid;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel)}.setup-card__body{display:grid;gap:.7rem;padding:1rem}.setup-card__topic{color:#88d4cb!important;font-size:.74rem!important;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.setup-card h3{font-size:1.2rem;line-height:1.25}.setup-card h3 a::after{content:'';position:absolute;inset:0}.setup-card h3 a{position:relative}.setup-card__body>p{color:var(--muted)}.setup-card__labels,.setup-card footer{display:flex;flex-wrap:wrap;gap:.45rem}.paid-indicator{padding:.22rem .55rem;border:1px solid #b7791f;border-radius:999px;color:#ffd58a;font-size:.73rem;font-weight:700}.setup-card footer{gap:.35rem 1rem;padding-top:.3rem;color:var(--muted);font-size:.76rem}
</style>
