---
import EvidenceLabel from './EvidenceLabel.astro';
import SetupArtwork from './SetupArtwork.astro';
import type { SetupArtworkName } from './SetupArtwork.astro';
import { SETUP_TOPIC_LABELS, type SetupTopicId } from '../../lib/setup-topics';

interface Props {
  slug: string;
  title: string;
  description: string;
  publishedDate: string;
  reviewedDate: string;
  topic: SetupTopicId;
  evidenceLevel: 'editorial-research' | 'personally-used' | 'hands-on-tested';
  hasAffiliateLinks: boolean;
  artwork: SetupArtworkName;
}

const p = Astro.props;
const fmt = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<article class="setup-card" data-setup-card>
  <SetupArtwork
    name={p.artwork}
    variant="card"
    topic={p.topic}
    sizes="(max-width: 47.99rem) calc(100vw - 2rem), (max-width: 70rem) calc(50vw - 2.4rem), 33rem"
  />
  <div class="setup-card__body">
    <p class="setup-card__topic">{SETUP_TOPIC_LABELS[p.topic]}</p>
    <h3 class="setup-card__title"><a href={`/setup/${p.slug}/`}>{p.title}</a></h3>
    <p class="setup-card__description">{p.description}</p>
    <div class="setup-card__labels">
      <EvidenceLabel level={p.evidenceLevel} />
      {p.hasAffiliateLinks && <span class="paid-indicator" data-paid-indicator>Contains paid links</span>}
    </div>
    <footer class="setup-card__dates">
      <span>Published <time datetime={p.publishedDate}>{fmt(p.publishedDate)}</time></span>
      <span>Reviewed <time datetime={p.reviewedDate}>{fmt(p.reviewedDate)}</time></span>
    </footer>
  </div>
</article>

<style>
  /* No `overflow: hidden` and no full-card `::after` overlay.
     The overlay used to sit above the evidence and paid-link chips and the
     published/reviewed dates, so disclosure metadata behaved like a link,
     text could not be selected, and the real click target was ambiguous.
     The title link is now the single, honest target; the card reacts to its
     hover and focus so the affordance is still obvious. Dropping
     `overflow: hidden` also stops the card from clipping the focus ring. */
  .setup-card {
    display: grid;
    align-content: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    transition: border-color 160ms ease;
  }

  .setup-card:has(.setup-card__title a:hover),
  .setup-card:focus-within {
    border-color: color-mix(in srgb, var(--accent-strong) 45%, var(--line));
  }

  .setup-card__body {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
    padding: 1rem;
  }

  .setup-card__topic {
    color: #88d4cb !important;
    font-size: 0.74rem !important;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .setup-card__title {
    font-size: 1.18rem;
    line-height: 1.3;
    /* Long titles wrap over as many lines as they need; nothing is truncated
       and no fixed card height forces an ellipsis. */
    overflow-wrap: break-word;
  }

  .setup-card__title a {
    color: inherit;
  }

  .setup-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .setup-card__title a:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .setup-card__description {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Row gap keeps a visible band between the evidence chip and the paid-link
     chip when they wrap onto separate rows; the column gap keeps them apart
     when they share one. */
  .setup-card__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    min-width: 0;
  }

  .paid-indicator {
    display: inline-block;
    max-width: 100%;
    padding: 0.25rem 0.6rem;
    border: 1px solid #b7791f;
    border-radius: 0.55rem;
    color: #ffd58a;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  /* Dates move to their own rows before they can collide. */
  .setup-card__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.5rem;
    padding-top: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (forced-colors: active) {
    .paid-indicator {
      border: 1px solid CanvasText;
    }
  }
</style>
