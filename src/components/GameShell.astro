---
import type { GameArtworkData } from '../types/content';
import GameArtwork from './GameArtwork.astro';
import HandoffScreen from './HandoffScreen.astro';

interface Props {
  title: string;
  tagline: string;
  slug: string;
  accent?: string;
  artwork?: GameArtworkData;
  /** Pass &amp; Play games embed the shared handoff template once. */
  passPlay?: boolean;
}

const { title, tagline, slug, accent = '#12b66a', artwork, passPlay = false } = Astro.props;
---

<section class="game-shell" data-game={slug}>
  {passPlay && <HandoffScreen />}
  <div class:list={['game-shell__top', { 'game-shell__top--artwork': artwork }]}>
    <a class="back-link" href="/arcade/">← Arcade</a>
    <div class="game-shell__heading">
      {artwork && <p class="eyebrow">Quiet Arcade · {title}</p>}
      <h1 class="page-title">{title}</h1>
      <p class="lede">{tagline}</p>
      <div class="game-shell__play-action">
        <button
          type="button"
          class="btn btn--primary game-shell__play-btn"
          data-game-play-btn
          aria-controls="game-viewport"
        >
          Play {title}
        </button>
      </div>
    </div>
    {
      artwork && (
        <GameArtwork
          class="game-shell__artwork"
          src={artwork.coverLandscapeFallback}
          webpSrc={artwork.coverLandscape}
          mobileSrc={artwork.coverSquareFallback}
          mobileWebpSrc={artwork.coverSquare}
          alt={artwork.alt}
          width={1280}
          height={720}
          variant="landscape"
          mobileVariant="square"
          accent={accent}
          priority
        />
      )
    }
  </div>

  <section class="game-viewport panel" data-game-viewport id="game-viewport" aria-label={`${title} game area`}>
    <div class="game-toolbar" role="toolbar" aria-label="Game controls">
      <div class="game-toolbar__primary">
        <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="pause" aria-pressed="false">
          Pause game
        </button>
        <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="mute" aria-pressed="false">
          Mute sound
        </button>
        <button
          type="button"
          class="btn btn--ghost btn--sm"
          data-game-toolbar="settings"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-controls="game-settings"
        >
          Game settings
        </button>
      </div>
      <div class="game-toolbar__panel" id="game-settings" data-game-settings-panel role="dialog" aria-label="Game settings" hidden>
        <p class="game-toolbar__panel-title">Game settings</p>
        <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="sound" aria-pressed="true">Sound on</button>
        <label class="game-toolbar__volume">Sound volume
          <input data-game-toolbar="volume" type="range" min="0" max="100" value="60" aria-label="Sound volume" />
        </label>
        <label class="game-toolbar__ambient">Ambient
          <select data-game-toolbar="ambient" aria-label="Ambient sound"><option value="none">None</option><option value="rainfall">Rainfall</option><option value="cafe">Cafe</option><option value="white-noise">White noise</option></select>
        </label>
        <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="focus-in-menu" aria-pressed="false">
          Focus mode
        </button>
        <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="restart-in-menu">
          New game
        </button>
      </div>
      <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="restart">
        New game
      </button>
      <button type="button" class="btn btn--ghost btn--sm" data-game-toolbar="fullscreen" aria-pressed="false">
        Focus mode
      </button>
      <p class="game-toolbar__status" data-game-toolbar-status aria-live="polite" aria-atomic="true"></p>
    </div>
    <div class="game-viewport__settings-catch" data-game-settings-catch hidden aria-hidden="true"></div>
    <div class="game-viewport__content">
      <slot name="game" />
    </div>
    <div class="game-viewport__pause" data-game-pause-overlay hidden>
      <div role="status" aria-live="polite">
        <p class="game-viewport__pause-label">Game paused</p>
        <p>Your current game is waiting exactly where you left it.</p>
        <button type="button" class="btn" data-game-pause-resume>Resume game</button>
      </div>
    </div>
  </section>

  <div class="game-shell__details">
    <slot />
  </div>
</section>

<script>
  import { mountRenderedGameShells } from '../games/shared/shell';

  // Astro hoists component scripts. Waiting for the parsed document keeps the
  // game mount reliable in WebKit when an external module arrives before this
  // component's viewport markup has been parsed.
  const mount = () => mountRenderedGameShells();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount, { once: true });
  else mount();
</script>

<style>
  .game-shell {
    display: grid;
    gap: 1rem;
  }

  .game-shell__top {
    display: grid;
    gap: 0.85rem;
  }

  .game-shell__top--artwork {
    align-items: center;
    gap: 1rem 2rem;
  }

  .game-shell__top--artwork .back-link {
    grid-column: 1 / -1;
  }

  .game-shell__heading .lede {
    margin-top: 0.45rem;
  }

  .game-shell__heading .eyebrow {
    margin-bottom: 0.7rem;
  }

  .game-shell__play-action {
    display: flex;
    justify-content: flex-start;
    margin-top: 0.75rem;
  }

  .game-shell__play-btn {
    font-size: 1.05rem;
    font-weight: 700;
    padding: 0.65rem 1.4rem;
    min-height: 48px;
    background: var(--accent);
    color: #0b1510;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(18, 182, 106, 0.35);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .game-shell__play-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(18, 182, 106, 0.45);
  }

  .game-shell__play-btn:active {
    transform: translateY(1px);
  }

  .game-shell__top :global(.game-shell__artwork) {
    min-width: 0;
  }

  .game-viewport {
    position: relative;
    display: grid;
    min-height: 0;
    padding: 0.75rem;
    overflow: visible;
    isolation: isolate;
  }

  .game-toolbar {
    position: relative;
    /* Keep the trigger and its panel above the outside-click catcher. */
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .game-toolbar__primary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .game-toolbar__panel[hidden] {
    display: none;
  }

  .game-toolbar__panel {
    position: absolute;
    z-index: 5;
    top: calc(100% - 0.35rem);
    left: 0;
    display: grid;
    gap: 0.65rem;
    min-width: min(18rem, 100%);
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
  }

  .game-toolbar__panel-title {
    margin: 0;
    font-size: 0.95rem;
  }

  .game-toolbar__volume,
  .game-toolbar__ambient {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .game-toolbar__volume input { width: 6rem; accent-color: var(--accent); }
  .game-toolbar__ambient select { max-width: 8rem; }

  /* Desktop retains a quick restart; the mobile compact toolbar keeps it in
     Game settings. Opening settings also replaces the desktop shortcut with
     the single menu action, avoiding duplicate accessible names. */
  .is-settings-open .game-toolbar > [data-game-toolbar="restart"],
  .is-settings-open .game-toolbar > [data-game-toolbar="fullscreen"] {
    display: none;
  }

  .game-toolbar__status {
    flex: 1 1 14rem;
    min-height: 1.3rem;
    margin-left: 0.2rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .game-viewport__content {
    min-height: 0;
    padding: 0.85rem 0 0;
  }

  .game-viewport__settings-catch[hidden] {
    display: none;
  }

  .game-viewport__settings-catch {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: transparent;
  }

  .game-viewport__pause[hidden] {
    display: none;
  }

  .game-viewport__pause {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: start center;
    align-content: start;
    padding: 5rem 1rem 1rem;
    background: rgba(8, 12, 10, 0.84);
    backdrop-filter: blur(5px);
    /* The overlay explains the state without trapping the shared toolbar.
       Game modules still reject any underlying board input while paused. */
    pointer-events: none;
  }

  .game-viewport__pause > div {
    pointer-events: auto;
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    max-width: 25rem;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .game-viewport__pause-label {
    color: var(--text);
    font-size: 1.2rem;
    font-weight: 800;
  }

  .game-viewport__pause p:not(.game-viewport__pause-label) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .game-shell__details {
    display: grid;
  }

  .game-viewport:fullscreen,
  .game-viewport.is-immersive {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100dvw;
    min-width: 0;
    height: 100dvh;
    min-height: 0;
    max-width: none;
    max-height: none;
    padding:
      max(0.75rem, env(safe-area-inset-top, 0px))
      max(0.75rem, env(safe-area-inset-right, 0px))
      max(0.75rem, env(safe-area-inset-bottom, 0px))
      max(0.75rem, env(safe-area-inset-left, 0px));
    border: 0;
    border-radius: 0;
    background: var(--bg);
    overflow: hidden;
  }

  .game-viewport:fullscreen {
    box-shadow: none;
  }

  .game-viewport.is-immersive {
    position: fixed;
    z-index: 90;
    inset: 0;
  }

  .game-viewport:fullscreen .game-toolbar,
  .game-viewport.is-immersive .game-toolbar {
    position: sticky;
    top: 0;
    padding-bottom: 0.75rem;
    background: var(--bg);
  }

  .game-viewport.is-immersive .game-toolbar__panel .game-toolbar__volume,
  .game-viewport.is-immersive .game-toolbar__panel .game-toolbar__ambient {
    display: grid;
  }

  .game-viewport:fullscreen .game-viewport__content,
  .game-viewport.is-immersive .game-viewport__content {
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: min-content;
    overflow: visible;
  }

  .game-viewport:fullscreen :global(.game-root),
  .game-viewport.is-immersive :global(.game-root) {
    width: min(100%, 70rem);
    margin-inline: auto;
  }

  .game-viewport:fullscreen .game-viewport__pause,
  .game-viewport.is-immersive .game-viewport__pause {
    padding-top: max(6rem, calc(env(safe-area-inset-top, 0px) + 5rem));
  }

  @media (min-width: 48rem) {
    .game-shell__top--artwork {
      grid-template-columns: minmax(16rem, 0.78fr) minmax(24rem, 1.22fr);
    }

    .game-viewport {
      padding: 1rem;
    }
  }

  @media (max-width: 34rem) {
    .game-toolbar > [data-game-toolbar="restart"],
    .game-toolbar > [data-game-toolbar="fullscreen"] {
      display: none;
    }

    /* The normal mobile entry point lives in Game settings. Once fallback
       focus mode is active this same toolbar button is the always-visible,
       keyboard-focusable exit control. */
    .game-viewport.is-immersive .game-toolbar > [data-game-toolbar="fullscreen"] {
      display: inline-flex;
    }

    .game-toolbar .btn {
      flex: 1 1 calc(50% - 0.5rem);
    }

    .game-toolbar__status {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
