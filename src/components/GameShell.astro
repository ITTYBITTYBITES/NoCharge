---
import AdSlot from './AdSlot.astro';

interface Props {
  title: string;
  tagline: string;
  slug: string;
}

const { title, tagline, slug } = Astro.props;
---

<section class="game-shell" data-game={slug}>
  <div class="game-shell__top">
    <a class="back-link" href="/">← Games</a>
    <div class="game-shell__heading">
      <h1 class="page-title">{title}</h1>
      <p class="lede">{tagline}</p>
    </div>
  </div>

  <div class="ad-banner" aria-label="Advertisement">
    <AdSlot unit="rect-300x250" />
  </div>

  <div class="game-shell__stage panel">
    <slot />
  </div>
</section>

<style>
  .game-shell {
    display: grid;
    gap: 1rem;
  }

  .game-shell__top {
    display: grid;
    gap: 0.85rem;
  }

  .game-shell__heading .lede {
    margin-top: 0.45rem;
  }

  .game-shell__stage {
    padding: 1rem;
    overflow: hidden;
  }

  @media (min-width: 48rem) {
    .game-shell__stage {
      padding: 1.25rem;
    }
  }
</style>
