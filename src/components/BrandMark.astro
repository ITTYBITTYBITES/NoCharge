---
interface Props {
  /** CSS size (px or rem). The SVG is square. */
  size?: number | string;
  class?: string;
}

const { size = '2rem', class: className } = Astro.props;
const width = typeof size === 'number' ? `${size}px` : size;
---

<!-- Inline NoCharge symbol (decorative; the adjacent text names the brand). -->
<svg
  class={className}
  width={width}
  height={width}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="14" fill="#121212" />
  <g fill="var(--accent)">
    <rect x="8" y="8" width="22" height="22" rx="6.5" />
    <rect x="34" y="8" width="22" height="22" rx="6.5" />
    <rect x="34" y="34" width="22" height="22" rx="6.5" />
  </g>
  <path
    fill="none"
    stroke="var(--accent)"
    stroke-width="6"
    stroke-linejoin="round"
    d="M14.5 34 H22.5 A6.5 6.5 0 0 1 30 40.5 V49.5 A6.5 6.5 0 0 1 22.5 56 H16 M8 48 V41.5 A6.5 6.5 0 0 1 14.5 34"
  />
</svg>
