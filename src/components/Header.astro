---
import BrandMark from './BrandMark.astro';
import ModeToggle from './ModeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { splitLocale, withLocale } from '../i18n/routes';
import { t } from '../i18n/messages';

// Section checks use the English route, so they work for every locale.
const { locale, route: pathname } = splitLocale(Astro.url.pathname);
const href = (path: string) => withLocale(path, locale);
const arcadeCurrent = pathname.startsWith('/arcade/') || pathname.startsWith('/games/');
const guidesCurrent = pathname.startsWith('/guides/');
const articlesCurrent = pathname.startsWith('/articles/');
const toolsCurrent = pathname.startsWith('/tools/');
const learnCurrent = pathname.startsWith('/learn/');
const dailyCurrent = pathname.startsWith('/daily/');
const setupCurrent = pathname.startsWith('/setup/');
const searchCurrent = pathname === '/search' || pathname.startsWith('/search');
// The header owns the single mode switch, so it has to know which section the
// current route belongs to rather than assuming "calm".
const labCurrent = pathname.startsWith('/lab/');
const arcadeAria = pathname === '/arcade/' ? 'page' : arcadeCurrent ? 'location' : undefined;
const guidesAria = pathname === '/guides/' ? 'page' : guidesCurrent ? 'location' : undefined;
const articlesAria = pathname === '/articles/' ? 'page' : articlesCurrent ? 'location' : undefined;
const toolsAria = pathname === '/tools/' ? 'page' : toolsCurrent ? 'location' : undefined;
const learnAria = pathname === '/learn/' ? 'page' : learnCurrent ? 'location' : undefined;
const dailyAria = pathname === '/daily/' ? 'page' : dailyCurrent ? 'location' : undefined;
const setupAria = pathname === '/setup/' ? 'page' : setupCurrent ? 'location' : undefined;
const searchAria = searchCurrent ? 'page' : undefined;
---

<header class="site-header">
  <a class="brand" href={href('/')} aria-label={t(locale, 'site.homeLabel')}>
    <BrandMark class="brand__mark" size="2rem" />
    <span>NoCharge</span>
  </a>
  <nav class="primary-nav" aria-label={t(locale, 'site.primaryNav')}>
    <a class:list={['nav-link', { 'is-current': arcadeCurrent }]} href={href('/arcade/')} aria-current={arcadeAria}>{t(locale, 'nav.arcade')}</a>
    <a class:list={['nav-link', { 'is-current': guidesCurrent }]} href={href('/guides/')} aria-current={guidesAria}>{t(locale, 'nav.guides')}</a>
    <a class:list={['nav-link', { 'is-current': articlesCurrent }]} href={href('/articles/')} aria-current={articlesAria}>{t(locale, 'nav.articles')}</a>
    <a class:list={['nav-link', { 'is-current': toolsCurrent }]} href={href('/tools/')} aria-current={toolsAria}>{t(locale, 'nav.tools')}</a>
    <a class:list={['nav-link', { 'is-current': learnCurrent }]} href={href('/learn/')} aria-current={learnAria}>{t(locale, 'nav.learn')}</a>
    <a class:list={['nav-link', { 'is-current': dailyCurrent }]} href={href('/daily/')} aria-current={dailyAria}>{t(locale, 'nav.daily')}</a>
    <a class:list={['nav-link', 'nav-link--setup', { 'is-current': setupCurrent }]} href={href('/setup/')} aria-current={setupAria}>{t(locale, 'nav.setup')}</a>
    <a class:list={['nav-link', 'nav-link--search', { 'is-current': searchCurrent }]} href={href('/search/')} aria-current={searchAria} aria-label={t(locale, 'site.searchLabel')}>
      <svg class="nav-link__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
      <span class="sr-only">{t(locale, 'site.search')}</span>
    </a>
    <ModeToggle current={labCurrent ? 'lab' : 'calm'} />
  </nav>
  <LanguageSwitcher variant="header" />
</header>
