---
import BrandMark from './BrandMark.astro';

const pathname = Astro.url.pathname;
const arcadeCurrent = pathname.startsWith('/arcade/') || pathname.startsWith('/games/');
const guidesCurrent = pathname.startsWith('/guides/');
const articlesCurrent = pathname.startsWith('/articles/');
const setupCurrent = pathname.startsWith('/setup/');
const arcadeAria = pathname === '/arcade/' ? 'page' : arcadeCurrent ? 'location' : undefined;
const guidesAria = pathname === '/guides/' ? 'page' : guidesCurrent ? 'location' : undefined;
const articlesAria = pathname === '/articles/' ? 'page' : articlesCurrent ? 'location' : undefined;
const setupAria = pathname === '/setup/' ? 'page' : setupCurrent ? 'location' : undefined;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="NoCharge home">
    <BrandMark class="brand__mark" size="2rem" />
    <span>NoCharge</span>
  </a>
  <nav class="primary-nav" aria-label="Primary">
    <a class:list={['nav-link', { 'is-current': arcadeCurrent }]} href="/arcade/" aria-current={arcadeAria}>Arcade</a>
    <a class:list={['nav-link', { 'is-current': guidesCurrent }]} href="/guides/" aria-current={guidesAria}>Guides</a>
    <a class:list={['nav-link', { 'is-current': articlesCurrent }]} href="/articles/" aria-current={articlesAria}>Articles</a>
    <a class:list={['nav-link', { 'is-current': setupCurrent }]} href="/setup/" aria-current={setupAria}>Setup</a>
  </nav>
</header>
