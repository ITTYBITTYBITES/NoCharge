---
interface Props {
  slug: string;
  title: string;
  description: string;
  gameTitle: string;
  emoji: string;
  accent?: string;
  readTime: number;
}

const {
  slug,
  title,
  description,
  gameTitle,
  emoji,
  accent = '#0f9d58',
  readTime,
} = Astro.props;
---

<article class="guide-card" style={`--guide-accent:${accent}`}>
  <a href={`/guides/${slug}/`}>
    <div class="guide-card__meta">
      <span class="guide-card__icon" aria-hidden="true">{emoji}</span>
      <span>{gameTitle}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime} min read</span>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="guide-card__cta">Read guide →</span>
  </a>
</article>

<style>
  .guide-card,
  .guide-card a {
    height: 100%;
  }

  .guide-card a {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(145deg, color-mix(in srgb, var(--guide-accent) 8%, var(--panel)), var(--panel));
    box-shadow: var(--shadow);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      background 160ms ease;
  }

  .guide-card a:hover {
    border-color: color-mix(in srgb, var(--guide-accent) 55%, transparent);
    background: var(--panel-2);
    transform: translateY(-2px);
  }

  .guide-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .guide-card__icon {
    font-size: 1rem;
  }

  .guide-card h3 {
    font-size: 1.08rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .guide-card p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .guide-card__cta {
    margin-top: 0.15rem;
    color: var(--guide-accent);
    font-size: 0.88rem;
    font-weight: 700;
  }
</style>
