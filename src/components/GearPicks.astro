---
/**
 * "Recommended gear" module — the replacement for the old display-ad band.
 *
 * It occupies the same in-flow slot the AdSense banner used (after `<main>`,
 * before the footer) so the page keeps its rhythm, but it is editorial: named
 * merchants, a real reason to buy, a stated limitation, and a disclosure.
 *
 * Rules it enforces:
 *  - No merchant renders unless it is approved **and** its MID is confirmed
 *    (`renderableMerchants()`), so a half-configured account shows nothing
 *    rather than a dead link.
 *  - No images, no widget scripts, no iframes, no prices. Awin is linked as
 *    text. The CSP stays tight and the Lighthouse third-party budget for the
 *    calm site is unaffected.
 *  - `showAds={false}` pages do not get this module either: they pass
 *    `merchants={[]}` or the page simply does not render this component. In
 *    practice, `BaseLayout` decides based on the page's `showAds` prop.
 */
import AwinLink from './AwinLink.astro';
import AffiliateDisclosure from './setup/AffiliateDisclosure.astro';
import { AWIN_ENABLED, AWIN_MERCHANTS, renderableMerchants } from '../config/awin';

interface Props {
  /** Registry keys to show. Defaults to every renderable merchant. */
  merchants?: readonly string[];
  /** Heading varies by surface so the module does not read as a template. */
  heading?: string;
  /** Short intro line naming the editorial basis. */
  intro?: string;
  /** Surface identifier, used as the Awin `clickref` prefix. */
  slot?: string;
}

const {
  merchants: keys,
  heading = 'Recommended gear for a calmer setup',
  intro = 'Optional purchases, chosen for the setup problems our guides already describe. Text links only — no images, no prices, nothing that loads from a merchant.',
  slot = 'gear',
} = Astro.props;

/**
 * Unique per page without a mutable counter: pages render concurrently, so a
 * module-level counter gives two instances the same number. The `slot` is
 * unique within a page by construction (page-footer / guide / article / setup).
 */
const headingId = `gear-picks-heading-${slot}`;

const approved = renderableMerchants();
const chosen = keys ? approved.filter((merchant) => keys.includes(merchant.key)) : approved;

/** Only merchants with at least one editorial destination are worth a card. */
const cards = chosen
  .map((merchant) => ({ merchant, destination: merchant.destinations[0] }))
  .filter((entry) => entry.destination !== undefined);
---

{
  AWIN_ENABLED && cards.length > 0 && (
    <aside class="gear-picks" aria-labelledby={headingId} data-gear-picks>
      <div class="gear-picks__intro">
        <p class="eyebrow">Optional gear</p>
        <h2 id={headingId}>{heading}</h2>
        <p>{intro}</p>
      </div>

      {/* Non-landmark note: a guide page can carry both an inline module and the
          layout's footer module, and two <aside> landmarks with the same
          accessible name fail html-validate's unique-landmark rule. The copy is
          identical either way. */}
      <AffiliateDisclosure networks={['awin']} variant="note" />

      <ul class="gear-picks__grid">
        {cards.map(({ merchant, destination }) => (
          <li class="gear-picks__card" data-gear-merchant={merchant.key}>
            <p class="gear-picks__merchant">{merchant.name}</p>
            <p class="gear-picks__category">{merchant.category}</p>
            <AwinLink
              merchant={merchant.key}
              href={`https://${merchant.domains[0]}${destination.path}`}
              label={destination.label}
              clickref={`${slot}-${merchant.key}`}
              variant="card"
              why={destination.why}
              limits={destination.limits}
            />
          </li>
        ))}
      </ul>

      <p class="gear-picks__more">
        <a href="/advertising/">How paid links work on NoCharge</a>
        {' · '}
        <a href="/setup/">All setup guides</a>
      </p>
    </aside>
  )
}

<style>
  .gear-picks {
    display: grid;
    gap: 1rem;
    margin: 2rem auto 0;
    max-width: 52rem;
    padding: 1.25rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .gear-picks__intro {
    display: grid;
    gap: 0.4rem;
  }

  .gear-picks__intro h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .gear-picks__intro p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .gear-picks__grid {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .gear-picks__grid {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }

  .gear-picks__card {
    display: grid;
    gap: 0.45rem;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--text) 3%, var(--panel));
    min-width: 0;
  }

  .gear-picks__merchant {
    margin: 0;
    font-weight: 800;
    overflow-wrap: break-word;
  }

  .gear-picks__category {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .gear-picks__more {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (forced-colors: active) {
    .gear-picks,
    .gear-picks__card {
      border: 1px solid CanvasText;
    }
  }
</style>
