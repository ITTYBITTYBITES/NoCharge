---
/**
 * A single ad slot: an iframe pointing at the same-origin host page for one
 * unit, plus an optional Smartlink backfill CTA revealed when the slot
 * reports that it never filled.
 *
 * `eager` slots skip `loading="lazy"`. Lazy-loading was the other half of the
 * mobile bug: the bottom banner sits below several viewports of content on a
 * phone, far outside Chrome's lazy-load fetch threshold, so it never loaded
 * unless the user scrolled all the way down.
 */
import { getUnit, isPlaceholder, SMARTLINK_URL } from '../config/ads';

interface Props {
  /** Ad unit id from src/config/ads.ts */
  unit: string;
  /** Extra classes for breakpoint visibility, etc. */
  class?: string;
  /** Load immediately instead of lazily. Default true. */
  eager?: boolean;
}

const { unit: unitId, class: className, eager = true } = Astro.props;

const unit = getUnit(unitId);
const hidden = isPlaceholder(unit);
const hasSmartlink = SMARTLINK_URL.length > 0;
---

{
  !hidden && (
    <div
      class:list={['ad-slot', className]}
      style={`--ad-w:${unit.width}px;--ad-h:${unit.height}px`}
      data-ad-slot={unit.id}
    >
      <iframe
        class="ad-slot__frame"
        title="Advertisement"
        src={`/ads/${unit.id}/`}
        width={unit.width}
        height={unit.height}
        loading={eager ? 'eager' : 'lazy'}
        scrolling="no"
        frameborder="0"
        referrerpolicy="no-referrer-when-downgrade"
      />

      {hasSmartlink && (
        <a
          class="ad-slot__fallback"
          href={SMARTLINK_URL}
          target="_blank"
          rel="noopener sponsored"
          hidden
        >
          Play more free games →
        </a>
      )}
    </div>
  )
}
