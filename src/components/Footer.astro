---
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__identity">
    <span class="site-footer__identity-line">
      <BrandMark class="brand-mark--footer" size="1.1rem" />
      <span>&copy; {year} NoCharge · General-audience site, not directed to children.</span>
    </span>
    <a href="mailto:hello@nocharge.net">hello@nocharge.net</a>
  </div>
  <div class="footer-groups">
    <nav aria-labelledby="footer-explore"><h2 id="footer-explore">Explore</h2><ul>
      <li><a href="/arcade/">Arcade</a></li><li><a href="/guides/">Guides</a></li><li><a href="/articles/">Articles</a></li><li><a href="/collections/">Collections</a></li><li><a href="/tools/">Tools</a></li><li><a href="/learn/">Learn</a></li><li><a href="/daily/">Daily</a></li><li><a href="/setup/">Setup</a></li><li><a href="/search/">Search</a></li>
    </ul></nav>
    <nav aria-labelledby="footer-nocharge"><h2 id="footer-nocharge">NoCharge</h2><ul>
      <li><a href="/about/">About</a></li><li><a href="/contact/">Contact</a></li><li><a href="/help/">Help</a></li><li><a href="/accessibility/">Accessibility</a></li><li><a href="/changelog/">Changelog</a></li>
    </ul></nav>
    <nav aria-labelledby="footer-policies"><h2 id="footer-policies">Policies</h2><ul>
      <li><a href="/privacy/">Privacy</a></li><li><a href="/privacy-policy/">Privacy Policy</a></li><li><a href="/terms/">Terms</a></li><li><a href="/advertising/">Advertising</a></li>
    </ul></nav>
  </div>
  <div class="footer-controls"><button type="button" data-consent-open>Analytics choices</button><button type="button" data-google-ad-choices>Privacy and cookie settings</button></div>
</footer>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-google-ad-choices]').forEach((control) => {
      control.addEventListener('click', () => {
        const googlefc = window.googlefc;
        if (googlefc && typeof googlefc.showRevocationMessage === 'function') { googlefc.showRevocationMessage(); return; }
        window.open('https://policies.google.com/privacy', '_blank', 'noopener');
      });
    });
  })();
</script>
