---
import type { GameArtworkData } from '../types/content';
import GameArtwork from './GameArtwork.astro';
interface Props{slug:string;title:string;tagline:string;description:string;genre:string;session:string;accent:string;artwork:GameArtworkData}
const{slug,title,tagline,description,genre,session,accent,artwork}=Astro.props;
---
<article class="signature" style={`--signature-accent:${accent}`}>
 <GameArtwork src={artwork.coverLandscapeFallback} webpSrc={artwork.coverLandscape} mobileSrc={artwork.coverSquareFallback} mobileWebpSrc={artwork.coverSquare} alt={artwork.alt} width={1280} height={720} variant="landscape" mobileVariant="square" accent={accent}/>
 <div><p class="section-kicker">Signature Experience</p><h3>{title}</h3><p class="signature__tagline">{tagline}</p><p>{description}</p><p class="signature__meta"><span>{genre}</span><span>{session}</span></p><div class="signature__actions"><a class="btn" href={`/games/${slug}/`}>Play Shattered Foil</a><a class="btn btn--ghost" href={`/guides/${slug}/`}>Read the guide</a></div></div>
</article>
<style>.signature{display:grid;gap:1.25rem;padding:clamp(1rem,3vw,1.5rem);border:1px solid color-mix(in srgb,var(--signature-accent) 36%,var(--line));border-radius:var(--radius);background:linear-gradient(145deg,color-mix(in srgb,var(--signature-accent) 8%,var(--panel)),var(--panel));box-shadow:var(--shadow)}.signature>div{display:grid;align-content:center;gap:.55rem}.signature h3{font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.04em}.signature p{color:var(--muted)}.signature__tagline{color:var(--text)!important;font-size:1.05rem}.signature__meta,.signature__actions{display:flex;gap:.6rem;flex-wrap:wrap}.signature__meta span{padding:.25rem .55rem;border:1px solid var(--line);border-radius:999px;font-size:.75rem}.signature__actions{margin-top:.5rem}@media(min-width:52rem){.signature{grid-template-columns:minmax(0,1.3fr) minmax(18rem,.7fr);align-items:center}}</style>
