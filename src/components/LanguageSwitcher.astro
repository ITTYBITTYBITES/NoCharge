---
/**
 * Language switcher.
 *
 * Renders plain links to the same page in each locale, so it works with
 * JavaScript disabled. The client module only records the choice in
 * localStorage before the browser follows the link. Each link carries its own
 * `lang`, so a screen reader pronounces the native name correctly.
 *
 * The footer shows every language as a pill. The header shows only the current
 * language, as a disclosure button (`<details>`) whose panel lists them all.
 * The header has one row of space, and eight visible pills would wrap it onto
 * several rows and push the navigation down on every page.
 */
import { LOCALES, LOCALE_META } from '../i18n/config';
import { splitLocale, withLocale } from '../i18n/routes';
import { t } from '../i18n/messages';

interface Props {
  /** `footer` is always visible; `header` appears on wider screens only. */
  variant?: 'footer' | 'header';
}

const { variant = 'footer' } = Astro.props;
const { locale, route } = splitLocale(Astro.url.pathname);
// The 404 page exists only in English (it is served for every unknown URL),
// so offering other languages there would link to pages that do not exist.
const isNotFoundPage = route === '/404/' || route === '/404.html';

const options = LOCALES.map((code) => ({
  code,
  href: withLocale(route, code),
  label: LOCALE_META[code].nativeName,
  lang: LOCALE_META[code].htmlLang,
}));
const current = options.find((option) => option.code === locale) ?? options[0];
---

{!isNotFoundPage && variant === 'footer' && (
<nav class="lang-switch lang-switch--footer" aria-label={t(locale, 'lang.choose')}>
  <ul class="lang-switch__list">
    {
      options.map((option) => (
        <li>
          <a
            class="lang-switch__option"
            href={option.href}
            hreflang={option.lang}
            lang={option.lang}
            data-locale-option={option.code}
            aria-current={option.code === locale ? 'true' : undefined}
          >
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
)}

{!isNotFoundPage && variant === 'header' && (
<details class="lang-menu">
  <summary class="lang-menu__summary" lang={current.lang}>
    <span class="sr-only">{t(locale, 'lang.choose')}: </span>{current.label}
  </summary>
  <nav class="lang-menu__panel" aria-label={t(locale, 'lang.label')}>
    <ul class="lang-menu__list">
      {
        options.map((option) => (
          <li>
            <a
              class="lang-switch__option"
              href={option.href}
              hreflang={option.lang}
              lang={option.lang}
              data-locale-option={option.code}
              aria-current={option.code === locale ? 'true' : undefined}
            >
              {option.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
)}

<script>
  import { initLocaleSwitcher } from '../i18n/client';

  initLocaleSwitcher();
</script>

<style>
  .lang-switch__list,
  .lang-menu__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switch__option {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .lang-switch__option:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .lang-switch__option[aria-current='true'] {
    border-color: currentColor;
    color: var(--text);
    font-weight: 600;
  }

  .lang-switch__option:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  /* Header disclosure: hidden on narrow screens, where the footer list shows. */
  .lang-menu {
    display: none;
    position: relative;
  }

  .lang-menu__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.88rem;
    cursor: pointer;
    list-style: none;
  }

  .lang-menu__summary::-webkit-details-marker {
    display: none;
  }

  .lang-menu__summary::after {
    content: '▾';
    font-size: 0.75rem;
  }

  .lang-menu__summary:hover {
    color: var(--text);
  }

  .lang-menu__summary:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  .lang-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    width: max-content;
    max-width: min(16rem, 90vw);
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
  }

  .lang-menu__list {
    flex-direction: column;
    align-items: stretch;
  }

  .lang-menu__list .lang-switch__option {
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 48.01rem) {
    .lang-menu {
      display: block;
    }
  }
</style>
