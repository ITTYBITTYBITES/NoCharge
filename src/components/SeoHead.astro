---
interface Props {
  title: string;
  description: string;
  path?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  modifiedTime?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  feedHref?: string;
  feedTitle?: string;
  additionalImages?: { url: string; width: number; height: number; alt?: string }[];
  /** BCP-47 tag of the page language. Defaults to English. */
  lang?: string;
  /** Open Graph locale token, for example `fr_CA`. */
  ogLocale?: string;
  /**
   * Language alternates for this page (`hreflang`). Only pages whose body is
   * translated advertise alternates; an empty list emits none.
   */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  path = '/',
  canonicalPath,
  noIndex = false,
  schema,
  ogType = 'website',
  modifiedTime,
  socialImage: socialImagePath = '/social/nocharge-default.jpg',
  socialImageAlt = 'NoCharge — quiet browser games and clear guides',
  socialImageWidth = 1200,
  socialImageHeight = 630,
  feedHref,
  feedTitle = 'NoCharge feed',
  additionalImages = [],
  lang = 'en',
  ogLocale = 'en_US',
  alternates = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://nocharge.net');
const canonical = new URL(canonicalPath ?? path, site).toString();
const socialImage = new URL(socialImagePath, site).toString();
const titled = `${title} · NoCharge`;
const fullTitle = title === 'NoCharge' ? 'NoCharge — Browser games and player guides' : titled.length > 70 ? title : titled;
const isGame = path.startsWith('/games/');
const defaultStructuredData = isGame
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      '@id': `${canonical}#game`,
      name: title,
      description,
      url: canonical,
      image: [socialImage],
      genre: 'Puzzle Game',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web, Windows, macOS, Linux, Android, iOS',
      gamePlatform: 'Web Browser',
      playMode: 'SinglePlayer',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
      publisher: {
        '@type': 'Organization',
        name: 'NoCharge',
        url: new URL('/', site).toString(),
        logo: { '@type': 'ImageObject', url: new URL('/icons/icon-512.png', site).toString(), width: 512, height: 512 },
      },
      inLanguage: lang,
    }
  : path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': 'https://nocharge.net/#website',
        name: 'NoCharge',
        alternateName: ['No Charge', 'No Charge Games', 'NoCharge Games', 'nocharge.net'],
        description,
        url: canonical,
        image: socialImage,
        inLanguage: lang,
        publisher: { '@type': 'Organization', name: 'NoCharge', url: new URL('/', site).toString() },
      }
    : null;
const structuredData = schema ?? defaultStructuredData;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.href, site).toString()} />
))}
{feedHref && <link rel="alternate" type="application/rss+xml" title={feedTitle} href={new URL(feedHref, site).toString()} />}
<!-- Indexing and link discovery are separate: noIndex must not imply nofollow. -->
{noIndex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="NoCharge" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={String(socialImageWidth)} />
<meta property="og:image:height" content={String(socialImageHeight)} />
<meta property="og:image:alt" content={socialImageAlt} />
{additionalImages.map((img) => (
  <>
    <meta property="og:image" content={new URL(img.url, site).toString()} />
    <meta property="og:image:width" content={String(img.width)} />
    <meta property="og:image:height" content={String(img.height)} />
    {img.alt && <meta property="og:image:alt" content={img.alt} />}
  </>
))}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
