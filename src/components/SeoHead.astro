---
interface Props {
  title: string;
  description: string;
  path?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  modifiedTime?: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  path = '/',
  noIndex = false,
  schema,
  ogType = 'website',
  modifiedTime,
  socialImage: socialImagePath = '/social-card.png',
  socialImageAlt = 'NoCharge — browser games and player guides',
} = Astro.props;
const site = Astro.site ?? new URL('https://nocharge.net');
const canonical = new URL(path, site).toString();
const socialImage = new URL(socialImagePath, site).toString();
const fullTitle = title === 'NoCharge' ? 'NoCharge — Browser games and player guides' : `${title} · NoCharge`;
const isGame = path.startsWith('/games/');
const defaultStructuredData = isGame
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      name: title,
      description,
      url: canonical,
      image: socialImage,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Any',
      playMode: 'SinglePlayer',
      isAccessibleForFree: true,
      inLanguage: 'en',
      publisher: {
        '@type': 'Organization',
        name: 'NoCharge',
        url: new URL('/', site).toString(),
      },
    }
  : path === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'NoCharge',
        description,
        url: canonical,
        image: socialImage,
        inLanguage: 'en',
      }
    : null;
const structuredData = schema ?? defaultStructuredData;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noIndex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="NoCharge" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialImageAlt} />
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
