---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { REGISTRY_REVIEW_DATE } from '../../lib/game-catalog';

export async function getStaticPaths() {
  const learn = (await getCollection('learn')).filter((entry) => !entry.data.draft);
  return learn.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = `https://nocharge.net/learn/${entry.id}/`;
const faqs = entry.data.faqs;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.published,
    dateModified: entry.data.updated,
    author: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
    publisher: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
    isAccessibleForFree: true,
  },
  ...(faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${canonical}#faq`,
        mainEntity: faqs.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://nocharge.net/learn/' },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/learn/${entry.id}/`}
  schema={schema}
  showAds={false}
>
  <article class="learn-article">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Learn', href: '/learn/' }, { label: entry.data.title }]} />
    <header>
      <p class="eyebrow">Learn · {entry.data.topic.replace(/-/g, ' ')}</p>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="learn-article__meta">Published {entry.data.published} · Reviewed <time datetime={entry.data.updated}>{entry.data.updated}</time> · {entry.data.readTime} min read</p>
    </header>

    <div class="learn-article__body panel">
      <Content />
    </div>

    {
      faqs.length > 0 && (
        <section class="panel learn-article__faq" id="faq" aria-labelledby="learn-faq-heading">
          <h2 id="learn-faq-heading">FAQ</h2>
          <dl>
            {faqs.map(({ q, a }) => (
              <>
                <dt>{q}</dt>
                <dd>{a}</dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    <p class="learn-article__review">
      Reviewed against the current catalog on <time datetime={REGISTRY_REVIEW_DATE}>{REGISTRY_REVIEW_DATE}</time>. <a href="/articles/registry-facts/">Registry facts</a> — <a href="/learn/">All learn pages</a>
    </p>
  </article>
</BaseLayout>

<style>
  .learn-article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 52rem;
    margin-inline: auto;
  }

  .learn-article__meta {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .learn-article__body {
    padding: clamp(1.2rem, 4vw, 2rem);
    min-width: 0;
  }

  .learn-article__body :global(h2) {
    margin-top: 1.6rem;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }

  .learn-article__body :global(h3) {
    margin-top: 1.2rem;
    font-size: 1.1rem;
  }

  .learn-article__body :global(p) {
    margin-top: 0.7rem;
    color: var(--muted);
  }

  .learn-article__body :global(strong) {
    color: var(--text);
  }

  .learn-article__body :global(ul),
  .learn-article__body :global(ol) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.45rem;
    margin: 0.7rem 0 0;
    padding-left: 1.3rem;
    color: var(--muted);
  }

  .learn-article__body :global(a) {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .learn-article__body :global(code) {
    font-size: 0.85em;
  }

  .learn-article__body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin-top: 0.8rem;
    border-collapse: collapse;
  }

  .learn-article__body :global(th),
  .learn-article__body :global(td) {
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    text-align: left;
    font-size: 0.84rem;
    overflow-wrap: anywhere;
  }

  .learn-article__faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
  }

  .learn-article__faq dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .learn-article__faq dt {
    font-weight: 700;
  }

  .learn-article__faq dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .learn-article__review {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .learn-article__review a {
    color: var(--accent-strong);
  }
</style>
