---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://nocharge.net/tools/zoom-visualizer/#app',
    name: 'Monitor Zoom vs Distance Visualizer',
    description: 'Free tool showing how 320px, 390px, 200% and 400% zoom map to 1280×1024 reference. For accessibility and no charge games setup.',
    url: 'https://nocharge.net/tools/zoom-visualizer/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/zoom-visualizer/#faq',
    mainEntity: [
      { '@type': 'Question', name: 'What is 200% zoom equivalent viewport?', acceptedAnswer: { '@type': 'Answer', text: '1280×1024 at 200% = 640×512 CSS pixels. At 400% = 320×256, the WCAG 1.4.10 reference. Media queries ignore CSS zoom property, so we test equivalent viewport.' } },
      { '@type': 'Question', name: 'Does this help with no charge games?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, NoCharge games are tested at 320×568, 360×800, 375×812, 390×844, 412×915 to ensure no horizontal overflow and no internal scrolling in Game Mode.' } },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Zoom Visualizer', item: 'https://nocharge.net/tools/zoom-visualizer/' },
    ],
  },
];
---

<BaseLayout title="Zoom Visualizer — Monitor zoom vs distance for no charge games" description="Free tool: see 320px, 390px, 200%, 400% zoom as equivalent viewport. For accessibility, quiet setup, and no charge games." path="/tools/zoom-visualizer/" schema={schema} showAds={false}>
  <div class="tool-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Zoom Visualizer' }]} />
    <header>
      <p class="eyebrow">Accessibility — zoom and reflow</p>
      <h1>Monitor Zoom vs Distance Visualizer</h1>
      <p class="lede">Free tool for NoCharge (No Charge) games. Understand how browser zoom and monitor distance affect 320px, 390px, 200%, 400% reflow without horizontal overflow.</p>
    </header>

    <blockquote><p><strong>Bottom line:</strong> 1280×1024 at 200% = 640×512 CSS px, at 400% = 320×256 (WCAG 1.4.10). CSS zoom property does NOT trigger media queries, so test equivalent viewport. NoCharge games are tested at 320/360/375/390/412 to ensure no overflow.</p></blockquote>

    <section class="panel tool-controls">
      <h2>Visualize zoom</h2>
      <div class="controls-grid">
        <label>Screen width <input id="screenW" type="number" value="1280" /></label>
        <label>Screen height <input id="screenH" type="number" value="1024" /></label>
        <label>Zoom % <select id="zoom"><option value="100">100%</option><option value="200" selected>200%</option><option value="400">400%</option></select></label>
        <button id="calc" class="btn">Calculate equivalent</button>
      </div>
      <p id="result">Equivalent: 640×512 CSS px at 200% zoom. No horizontal overflow expected if layout uses min-width 0.</p>
      <div id="preview" class="preview-box" style="width:100%; height:200px; border:1px solid var(--line); display:grid; place-items:center;">Preview of 640px viewport</div>
    </section>

    <section class="prose">
      <h2>Why this matters for no charge games</h2>
      <p>NoCharge games are designed to fit 320px portrait without scrolling in Game Mode. The toolbar collapses to single row, fan replaces tall piles inside stage. This visualizer helps you understand why we test equivalent viewport, not CSS zoom.</p>

      <h2>Table — zoom to CSS pixels</h2>
      <table>
        <thead><tr><th>Screen</th><th>Zoom</th><th>Equivalent CSS px</th><th>WCAG reference</th></tr></thead>
        <tbody>
          <tr><td>1280×1024</td><td>100%</td><td>1280×1024</td><td>Desktop</td></tr>
          <tr><td>1280×1024</td><td>200%</td><td>640×512</td><td>Zoom</td></tr>
          <tr><td>1280×1024</td><td>400%</td><td>320×256</td><td>WCAG 1.4.10 reflow</td></tr>
          <tr><td>390×844 (iPhone)</td><td>100%</td><td>390×844</td><td>Mobile no-scroll</td></tr>
          <tr><td>320×568 (SE)</td><td>100%</td><td>320×568</td><td>Smallest tested</td></tr>
        </tbody>
      </table>

      <h2>No-purchase checks</h2>
      <ul>
        <li>Try browser zoom 110% vs larger display — see guide Browser zoom versus a larger display.</li>
        <li>Move monitor 5cm further, adjust height to eye level.</li>
        <li>Check Quiet Setup screens-and-stands (20 guides) for stand stability and VESA.</li>
      </ul>

      <h2>FAQ — Zoom Visualizer</h2>
      <dl>
        <dt>What is equivalent viewport?</dt><dd>Screen size divided by zoom factor, e.g., 1280/2=640. Media queries use this, not CSS zoom property.</dd>
        <dt>Does it help with no charge games?</dt><dd>Yes, games tested at 320/360/375/390/412 to ensure no horizontal overflow and no internal scrolling.</dd>
      </dl>

      <h2>Embed</h2>
      <pre><code>&lt;iframe src="https://nocharge.net/tools/zoom-visualizer/" width="400" height="500"&gt;&lt;/iframe&gt;
&lt;p&gt;Powered by &lt;a href="https://nocharge.net"&gt;NoCharge&lt;/a&gt;&lt;/p&gt;</code></pre>

      <h2>Next action</h2>
      <p>Set viewport to 320×700, open /setup/ and /games/memory-match/, check documentElement.scrollWidth ≤ clientWidth. Browse Quiet Setup for more.</p>
    </section>
  </div>
</BaseLayout>

<script>
  const result = document.getElementById('result');
  const preview = document.getElementById('preview');
  function calc() {
    const sw = Number(document.getElementById('screenW').value) || 1280;
    const sh = Number(document.getElementById('screenH').value) || 1024;
    const zoom = Number(document.getElementById('zoom').value) || 200;
    const ew = Math.round(sw * 100 / zoom);
    const eh = Math.round(sh * 100 / zoom);
    result.textContent = `Equivalent: ${ew}×${eh} CSS px at ${zoom}% zoom. No horizontal overflow expected if layout uses min-width 0 and max-width 100%.`;
    preview.textContent = `Preview of ${ew}px viewport — ${ew<=400 ? 'single column' : 'multi column'} expected`;
    preview.style.width = `${Math.min(100, ew/4)}%`;
  }
  document.getElementById('calc').addEventListener('click', calc);
  calc();
</script>

<style>
  .tool-page { max-width: 52rem; margin-inline: auto; display: grid; gap: 1.5rem; min-width: 0; }
  .tool-controls { padding: 1.25rem; display: grid; gap: 1rem; }
  .controls-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(10rem,1fr)); align-items: end; }
  .controls-grid label { display: grid; gap: 0.3rem; color: var(--muted); font-size: 0.85rem; }
  .controls-grid input, .controls-grid select { padding: 0.5rem; border-radius: 6px; background: var(--panel-2); border: 1px solid var(--line); }
  .preview-box { background: var(--panel-2); border-radius: 8px; color: var(--muted); }
  .prose { display: grid; gap: 1rem; max-width: 46rem; }
  .prose table { width: 100%; display: block; overflow-x: auto; border: 1px solid var(--line); border-collapse: collapse; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 0.5rem; font-size: 0.84rem; min-width: 0; word-break: break-word; }
  .prose blockquote { border-left: 4px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--panel-2)); padding: 0.8rem 1rem; border-radius: 6px; }
</style>
