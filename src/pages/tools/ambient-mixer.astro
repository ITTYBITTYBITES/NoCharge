---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import { AMBIENT_CATALOG } from '../../games/shared/audio/catalog';

const faqs = [
  {
    q: 'Does the ambient mixer download audio files?',
    a: 'No. Every audible signal is generated in the browser with the Web Audio API. There are no recordings, music loops, impulse-response files, speech, or third-party audio samples. The page must load first, and a Play button press permits audio.',
  },
  {
    q: 'What happens when I switch tabs?',
    a: 'The mixer fades and stops its soundscape when the page becomes hidden. If it was playing before the switch, it resumes the selected soundscape when the page becomes visible again. A saved selection that was not playing does not start by itself.',
  },
  {
    q: 'What is the difference between the nature soundscapes and the calm music ones?',
    a: 'The nature soundscapes pair slow, soft layers of filtered noise — breeze, flowing water, waves, or night air — with sparse generated tones such as birdsong, chimes, crickets, or an owl. The calm music soundscapes (floating pads, kalimba lullaby, singing bowls, and music box drift) are fully procedural compositions built from oscillators: slow chord pads, pentatonic plucks, and long resonant tones. None is a recorded song or a music loop.',
  },
  {
    q: 'Do the game sound controls affect ambient audio?',
    a: 'Master mute silences effects and soundscapes. The effects on/off control affects game effects only, while the volume control also adjusts the active soundscape.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://nocharge.net/tools/ambient-mixer/#app',
    name: 'NoCharge Ambient Mixer',
    description: 'A free browser-based mixer with ten calm procedural nature and music soundscapes and no recorded audio downloads.',
    url: 'https://nocharge.net/tools/ambient-mixer/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/ambient-mixer/#faq',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Ambient Mixer', item: 'https://nocharge.net/tools/ambient-mixer/' },
    ],
  },
];
---

<BaseLayout
  title="Ambient Mixer — ten calm procedural soundscapes"
  description="Try ten continuously generated calm soundscapes: meadow morning, mountain stream, zen garden, ocean shore, pine forest, summer night, floating pads, kalimba lullaby, singing bowls, and music box drift."
  path="/tools/ambient-mixer/"
  schema={schema}
  showAds={false}
  additionalImages={[{ url: '/setup-art/bias-light-pin-1000x1500.jpg', width: 1000, height: 1500, alt: 'NoCharge ambient mixer illustration' }]}
>
  <div class="tool-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Ambient Mixer' }]} />
    <header>
      <p class="eyebrow">Procedural soundscapes</p>
      <h1>Ambient Mixer — ten calm procedural soundscapes</h1>
      <p class="lede">Try a continuously generated background soundscape. There are no recordings, music loops, impulse responses, speech, or third-party samples, and sound stops when this page is hidden.</p>
    </header>

    <blockquote><p><strong>Bottom line:</strong> Pick a soundscape, begin at a low volume, and stop it whenever it is not useful. Every layer is created at runtime by Web Audio, after you press Play.</p></blockquote>

    <section class="panel mixer-controls" aria-labelledby="mixer-heading">
      <h2 id="mixer-heading">Choose a procedural soundscape</h2>
      <div class="mixer-grid">
        <label>Soundscape <select id="ambient-select">
          <option value="none">None</option>
          {AMBIENT_CATALOG.map((texture) => <option value={texture.id}>{texture.label}</option>)}
        </select></label>
        <label>Volume <input id="volume" type="range" min="0" max="100" value="30" aria-label="Soundscape volume" /></label>
        <button id="play" class="btn" type="button">Play soundscape</button>
        <button id="stop" class="btn btn--ghost" type="button">Stop</button>
      </div>
      <p id="status" aria-live="polite">Status: stopped.</p>
    </section>

    <section class="prose">
      <h2>How each soundscape is made</h2>
      <table>
        <thead><tr><th>Name</th><th>Runtime source</th><th>Main shaping</th><th>Character</th></tr></thead>
        <tbody>
          {AMBIENT_CATALOG.map((texture) => (
            <tr><td>{texture.label}</td><td>{texture.source}</td><td>{texture.shaping}</td><td>{texture.character}</td></tr>
          ))}
        </tbody>
      </table>

      <h2>Listening checks</h2>
      <ul>
        <li>Begin at a low volume and compare the soundscape with silence; louder is not automatically more useful.</li>
        <li>Use Stop before leaving if you do not want a playing soundscape to resume after a tab switch.</li>
        <li>Master mute in a game silences effects and soundscapes. Turning game effects off does not stop a selected soundscape.</li>
        <li>The nature soundscapes are calm procedural approximations — soft filtered wind, water, and waves with sparse birdsong, chimes, and night creatures — not field recordings, and the music soundscapes are generated, not recorded songs.</li>
      </ul>

      <h2 id="faq">FAQ — Ambient Mixer</h2>
      <FaqList items={faqs} />

      <h2>Embed this tool</h2>
      <pre><code>&lt;iframe src="https://nocharge.net/tools/ambient-mixer/" width="400" height="600" title="NoCharge procedural soundscape mixer"&gt;&lt;/iframe&gt;
&lt;p&gt;Source: &lt;a href="https://nocharge.net/tools/ambient-mixer/"&gt;NoCharge procedural soundscape mixer&lt;/a&gt;&lt;/p&gt;</code></pre>

      <h2>Next action</h2>
      <p>Try one procedural soundscape at low volume, compare it with silence, and keep it off if it adds distraction rather than reducing it.</p>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    getActiveAmbient,
    getAmbientCatalogEntry,
    isAmbientName,
    startAmbient,
    stopAmbient,
    suspendAmbientForVisibility,
    resumeAmbientAfterVisibility,
    updateAmbientVolume,
  } from '../../games/shared/audio/ambient';
  import { setSoundVolume, unlockAudio } from '../../games/shared/audio/play';

  const select = document.querySelector<HTMLSelectElement>('#ambient-select');
  const volume = document.querySelector<HTMLInputElement>('#volume');
  const status = document.querySelector<HTMLElement>('#status');
  const playButton = document.querySelector<HTMLButtonElement>('#play');
  const stopButton = document.querySelector<HTMLButtonElement>('#stop');

  if (select && volume && status && playButton && stopButton) {
    let resumeAfterVisibility = false;

    // Shareable query parameters set the initial choice/level only; they never
    // bypass the Play gesture required by browsers for audio.
    const params = new URLSearchParams(window.location.search);
    const textureParam = params.get('texture');
    const volumeParam = params.get('vol');
    if (textureParam && [...select.options].some((option) => option.value === textureParam)) {
      select.value = textureParam;
    }
    const requestedVolume = Number(volumeParam);
    if (Number.isFinite(requestedVolume) && requestedVolume >= 0 && requestedVolume <= 100) {
      volume.value = String(requestedVolume);
    }

    const updateStatus = (message?: string) => {
      const active = getActiveAmbient();
      const label = active === 'none' ? 'stopped' : getAmbientCatalogEntry(active)?.label ?? active;
      status.textContent = message ?? (active === 'none'
        ? 'Status: stopped.'
        : `Status: ${label} playing at volume ${volume.value}.`);
    };

    const playSelection = () => {
      unlockAudio();
      setSoundVolume(Number(volume.value));
      const name = select.value;
      if (!isAmbientName(name) || name === 'none') {
        stopAmbient();
        updateStatus();
        return;
      }
      const started = startAmbient(name);
      updateStatus(started === 'none' ? 'Status: audio is unavailable or muted.' : undefined);
    };

    playButton.addEventListener('click', playSelection);
    stopButton.addEventListener('click', () => {
      resumeAfterVisibility = false;
      stopAmbient();
      updateStatus();
    });
    volume.addEventListener('input', () => {
      setSoundVolume(Number(volume.value));
      updateAmbientVolume();
      updateStatus();
    });
    select.addEventListener('change', () => {
      if (getActiveAmbient() !== 'none') playSelection();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        resumeAfterVisibility = suspendAmbientForVisibility();
        updateStatus('Status: stopped while this page is hidden.');
      } else if (resumeAfterVisibility) {
        resumeAfterVisibility = false;
        resumeAmbientAfterVisibility();
        updateStatus();
      }
    });
    window.addEventListener('pagehide', () => stopAmbient());
  }
</script>

<style>
  .tool-page { max-width: 52rem; margin-inline: auto; display: grid; gap: 1.5rem; min-width: 0; }
  .mixer-controls { padding: 1.25rem; display: grid; gap: 1rem; }
  .mixer-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr)); align-items: end; }
  .mixer-grid > * { min-width: 0; max-width: 100%; }
  .mixer-grid label { display: grid; gap: 0.3rem; color: var(--muted); font-size: 0.85rem; }
  .mixer-grid select, .mixer-grid input { width: 100%; min-width: 0; max-width: 100%; min-height: 44px; padding: 0.5rem; border-radius: 6px; color: var(--text); background: var(--panel-2); border: 1px solid var(--line); }
  .prose { display: grid; gap: 1rem; max-width: 46rem; min-width: 0; }
  .prose table { width: 100%; display: block; overflow-x: auto; border: 1px solid var(--line); border-collapse: collapse; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 0.5rem; font-size: 0.84rem; min-width: 0; word-break: break-word; }
  .prose blockquote { border-left: 4px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--panel-2)); padding: 0.8rem 1rem; border-radius: 6px; }
</style>
