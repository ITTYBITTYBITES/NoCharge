---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    q: 'Does the ambient mixer download audio files?',
    a: 'No. The sounds are synthesized in the browser with the Web Audio API. The page must load first, and some browsers require a button press before they allow audio.',
  },
  {
    q: 'What happens when I switch tabs?',
    a: 'The mixer stops its audio when the page becomes hidden. If it was playing before the switch, it starts the selected texture again when the page becomes visible.',
  },
  {
    q: 'What is the difference between lofi and drone?',
    a: 'Lofi schedules short notes from a C-major pentatonic set on a 52 BPM grid. Drone uses two low, slightly detuned oscillators with a slow volume swell. Neither is a recorded song.',
  },
  {
    q: 'Do the game sound controls affect ambient audio?',
    a: 'Master mute silences effects and ambient audio. The effects on/off control affects game effects only, while the volume control also adjusts the active ambient texture.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://nocharge.net/tools/ambient-mixer/#app',
    name: 'NoCharge Ambient Mixer',
    description: 'A free browser-based mixer with ten synthesized ambient textures and no recorded audio downloads.',
    url: 'https://nocharge.net/tools/ambient-mixer/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/ambient-mixer/#faq',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Ambient Mixer', item: 'https://nocharge.net/tools/ambient-mixer/' },
    ],
  },
];
---

<BaseLayout
  title="Ambient Mixer — ten procedural textures"
  description="Try ten locally synthesized ambient textures: white noise, rainfall, forest, fireplace, ocean, night, cafe, library, lofi, and drone."
  path="/tools/ambient-mixer/"
  schema={schema}
  showAds={false}
  additionalImages={[{ url: '/setup-art/bias-light-pin-1000x1500.jpg', width: 1000, height: 1500, alt: 'NoCharge ambient mixer illustration' }]}
>
  <div class="tool-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Ambient Mixer' }]} />
    <header>
      <p class="eyebrow">Locally synthesized sound</p>
      <h1>Ambient Mixer — ten procedural textures</h1>
      <p class="lede">Try a quiet background texture generated by your browser. There are no recorded tracks to download, and audio stops when this page is hidden.</p>
    </header>

    <blockquote><p><strong>Bottom line:</strong> Pick a texture, keep the volume low, and stop it whenever it is not useful. White noise, environmental approximations, and the two musical options are generated with Web Audio rather than streamed from a media file.</p></blockquote>

    <section class="panel mixer-controls" aria-labelledby="mixer-heading">
      <h2 id="mixer-heading">Choose ambient audio</h2>
      <div class="mixer-grid">
        <label>Ambient <select id="ambient-select">
          <option value="none">None</option>
          <option value="white-noise">White noise</option>
          <option value="rainfall">Rainfall</option>
          <option value="forest">Forest — rustle and chirps</option>
          <option value="fireplace">Fireplace — filtered crackle</option>
          <option value="ocean">Ocean — slow noise swell</option>
          <option value="night">Night — cricket-like tones</option>
          <option value="cafe">Cafe — low room noise and clinks</option>
          <option value="library">Library — low room noise and page sounds</option>
          <option value="lofi">Lofi — sparse generated notes</option>
          <option value="drone">Drone — low two-note pad</option>
        </select></label>
        <label>Volume <input id="volume" type="range" min="0" max="100" value="30" /></label>
        <button id="play" class="btn" type="button">Play ambient</button>
        <button id="stop" class="btn btn--ghost" type="button">Stop</button>
      </div>
      <p id="status" aria-live="polite">Status: stopped.</p>
    </section>

    <section class="prose">
      <h2>How each texture is made</h2>
      <table>
        <thead><tr><th>Name</th><th>Source</th><th>Main shaping</th><th>Character</th></tr></thead>
        <tbody>
          <tr><td>White noise</td><td>Three-second random buffer</td><td>1,800 Hz low-pass</td><td>Steady broad masking texture</td></tr>
          <tr><td>Rainfall</td><td>Noise plus short sine impulses</td><td>Band-pass and high-pass filters</td><td>Wash with scattered droplets</td></tr>
          <tr><td>Forest</td><td>Low-frequency noise plus brief chirps</td><td>High-pass and band-pass filters</td><td>Rustle with sparse high tones</td></tr>
          <tr><td>Fireplace</td><td>Noise plus short crackle bursts</td><td>600 Hz low-pass</td><td>Soft, irregular crackle</td></tr>
          <tr><td>Ocean</td><td>Correlated noise with a slow amplitude cycle</td><td>400 Hz band-pass and 900 Hz low-pass</td><td>Low wave-like swell</td></tr>
          <tr><td>Night</td><td>Quiet noise plus paired high tones</td><td>2,000 Hz high-pass</td><td>Intermittent cricket-like pulses</td></tr>
          <tr><td>Cafe</td><td>Correlated room noise plus sparse clinks</td><td>Low-pass and presence filter</td><td>Muted room-like movement</td></tr>
          <tr><td>Library</td><td>Correlated noise plus page-like bursts</td><td>700 Hz low-pass</td><td>Very low room texture</td></tr>
          <tr><td>Lofi</td><td>Generated C-major pentatonic notes</td><td>1,100 Hz low-pass and short reverb</td><td>Sparse notes on a 52 BPM grid</td></tr>
          <tr><td>Drone</td><td>65.41 Hz and 98 Hz oscillators</td><td>600 Hz low-pass, detune, and slow swell</td><td>Low continuous two-note pad</td></tr>
        </tbody>
      </table>

      <h2>Listening checks</h2>
      <ul>
        <li>Begin at a low volume and compare the texture with silence; louder is not automatically more useful.</li>
        <li>Use the Stop button before changing pages if you do not want the selection to return after a tab switch.</li>
        <li>Master mute in a game silences ambient audio too. Turning game effects off does not have to stop the selected ambient texture.</li>
      </ul>

      <h2 id="faq">FAQ — Ambient Mixer</h2>
      <dl>
        {faqs.map(({ q, a }) => <><dt>{q}</dt><dd>{a}</dd></>)}
      </dl>

      <h2>Embed this tool</h2>
      <pre><code>&lt;iframe src="https://nocharge.net/tools/ambient-mixer/" width="400" height="600" title="NoCharge ambient mixer"&gt;&lt;/iframe&gt;
&lt;p&gt;Source: &lt;a href="https://nocharge.net/tools/ambient-mixer/"&gt;NoCharge ambient mixer&lt;/a&gt;&lt;/p&gt;</code></pre>

      <h2>Next action</h2>
      <p>Try one texture at low volume, compare it with silence, and keep it off if it adds distraction rather than reducing it.</p>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    getActiveAmbient,
    isAmbientName,
    startAmbient,
    stopAmbient,
    updateAmbientVolume,
  } from '../../games/shared/audio/ambient';
  import { setSoundVolume, unlockAudio } from '../../games/shared/audio/play';

  const select = document.querySelector<HTMLSelectElement>('#ambient-select');
  const volume = document.querySelector<HTMLInputElement>('#volume');
  const status = document.querySelector<HTMLElement>('#status');
  const playButton = document.querySelector<HTMLButtonElement>('#play');
  const stopButton = document.querySelector<HTMLButtonElement>('#stop');

  if (select && volume && status && playButton && stopButton) {
    let resumeAfterVisibility = false;

    const updateStatus = (message?: string) => {
      status.textContent = message ?? (getActiveAmbient() === 'none'
        ? 'Status: stopped.'
        : `Status: ${getActiveAmbient()} playing at volume ${volume.value}.`);
    };

    const playSelection = () => {
      unlockAudio();
      setSoundVolume(Number(volume.value));
      const name = select.value;
      if (!isAmbientName(name) || name === 'none') {
        stopAmbient();
        updateStatus();
        return;
      }
      startAmbient(name);
      updateStatus();
    };

    playButton.addEventListener('click', playSelection);
    stopButton.addEventListener('click', () => {
      resumeAfterVisibility = false;
      stopAmbient();
      updateStatus();
    });
    volume.addEventListener('input', () => {
      setSoundVolume(Number(volume.value));
      updateAmbientVolume();
      updateStatus();
    });
    select.addEventListener('change', () => {
      if (getActiveAmbient() !== 'none') playSelection();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        resumeAfterVisibility = getActiveAmbient() !== 'none';
        stopAmbient();
        updateStatus('Status: stopped while this page is hidden.');
      } else if (resumeAfterVisibility) {
        resumeAfterVisibility = false;
        playSelection();
      }
    });
    window.addEventListener('pagehide', () => stopAmbient());
  }
</script>

<style>
  .tool-page { max-width: 52rem; margin-inline: auto; display: grid; gap: 1.5rem; min-width: 0; }
  .mixer-controls { padding: 1.25rem; display: grid; gap: 1rem; }
  .mixer-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr)); align-items: end; }
  .mixer-grid > * { min-width: 0; max-width: 100%; }
  .mixer-grid label { display: grid; gap: 0.3rem; color: var(--muted); font-size: 0.85rem; }
  .mixer-grid select, .mixer-grid input { width: 100%; min-width: 0; max-width: 100%; min-height: 44px; padding: 0.5rem; border-radius: 6px; color: var(--text); background: var(--panel-2); border: 1px solid var(--line); }
  .prose { display: grid; gap: 1rem; max-width: 46rem; min-width: 0; }
  .prose table { width: 100%; display: block; overflow-x: auto; border: 1px solid var(--line); border-collapse: collapse; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 0.5rem; font-size: 0.84rem; min-width: 0; word-break: break-word; }
  .prose blockquote { border-left: 4px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--panel-2)); padding: 0.8rem 1rem; border-radius: 6px; }
</style>
