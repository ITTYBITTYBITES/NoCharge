---
import ToolPage from '../../components/ToolPage.astro';

const faqs = [
  {
    q: 'What is focus order?',
    a: 'The sequence in which keyboard Tab moves through interactive elements. A logical focus order follows the visual and reading order so keyboard users can predict where focus goes next.',
  },
  {
    q: 'Why does this demo exist?',
    a: 'It shows a sample grid of controls with visible focus and a Tab-walkable order, and explains why "visible focus" is a hard requirement — no focus trap, no invisible focus, no color-only states.',
  },
  {
    q: 'Is this a real accessibility audit?',
    a: 'No. The demo is educational. The accessibility page and its test matrix describe the automated and manual checks NoCharge runs on game boards and tools.',
  },
  {
    q: 'What makes a keyboard trap?',
    a: 'A control or modal that captures focus so Tab cannot leave it without Escape or a specific button. NoCharge\'s shared shell Escape path and settings panels are tested against that in CI.',
  },
];
---

<ToolPage
  title="Focus order demo"
  eyebrow="Tab through a sample board"
  description="A sample grid where every control is a real button, focus is visible, and the Tab order follows the reading order. Learn what keyboard users need and how to check it."
  path="/tools/focus-order-demo/"
  category="Accessibility"
  bottomLine="This demo is a small grid of real buttons with visible focus and predictable Tab order. It explains three checks — visible focus, logical order, no traps — and links to NoCharge's automated and manual accessibility tests. It is a teaching tool, not an audit."
  faqs={faqs}
  embedCode={`<iframe src="https://nocharge.net/tools/focus-order-demo/" width="400" height="560" title="NoCharge focus order demo"></iframe>`}
  nextActions={[
    { href: '/accessibility/', label: 'Accessibility position', note: 'Targets, test matrix, and manual checklist.' },
    { href: '/games/beacon-lattice/', label: 'Beacon Lattice', note: 'A grid where arrow keys move a visible cursor and Enter places.' },
    { href: '/games/minesweeper/', label: 'Minesweeper', note: 'Roving tabindex and row/column announcements.' },
  ]}
>
  <section class="panel focus-demo" aria-labelledby="focus-heading">
    <div>
      <p class="section-kicker">Tab and see</p>
      <h2 id="focus-heading">A sample game board</h2>
      <p>Press Tab repeatedly. Focus moves left to right, top to bottom, and every control shows a visible outline. The status line below the grid announces the last control you reached.</p>
    </div>
    <div class="focus-grid" data-focus-grid>
      {['A1', 'A2', 'A3', 'B1', 'B2', 'B3', 'C1', 'C2', 'C3'].map((label) => (
        <button type="button" class="focus-cell" data-focus-cell aria-label={`Cell ${label}`}>{label}</button>
      ))}
    </div>
    <p class="focus-status" data-focus-status aria-live="polite">Tab through the grid to follow the focus order.</p>
    <ol class="focus-lessons">
      <li><strong>Visible focus:</strong> a 2-pixel outline that cannot be removed by CSS alone.</li>
      <li><strong>Logical order:</strong> reading order is the tab order; no element jumps.</li>
      <li><strong>No traps:</strong> both Tab and Shift+Tab move freely, and Escape closes any dialog.</li>
    </ol>
  </section>
</ToolPage>

<script>
  const status = document.querySelector<HTMLElement>('[data-focus-status]');
  for (const cell of document.querySelectorAll<HTMLElement>('[data-focus-cell]')) {
    cell.addEventListener('focus', () => {
      if (status) status.textContent = `Focused: ${cell.dataset.focusCell ?? cell.textContent?.trim() ?? 'cell'}`;
    });
  }
</script>

<style is:global>
  .focus-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
  }

  .focus-demo > div:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
  }

  .focus-demo > div:first-child p:last-child {
    color: var(--muted);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 24rem;
  }

  .focus-cell {
    min-height: 56px;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--panel-2);
    color: var(--text);
    font-weight: 800;
  }

  .focus-cell:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
    background: color-mix(in srgb, var(--accent) 14%, var(--panel-2));
  }

  .focus-status {
    color: var(--muted);
    font-size: 0.88rem;
    min-height: 1.3rem;
  }

  .focus-lessons {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.3rem;
    color: var(--muted);
    font-size: 0.86rem;
  }
</style>
