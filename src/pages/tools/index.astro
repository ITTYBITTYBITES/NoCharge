---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    q: 'Do these tools need an account?',
    a: 'No. Their calculations, filters, and audio generation run in the browser. The site Privacy page explains separate analytics and advertising choices.',
  },
  {
    q: 'Do the tools upload my entries?',
    a: 'No. The discovery filters and zoom values are used only by the current page, and the ambient mixer synthesizes audio locally with the Web Audio API.',
  },
  {
    q: 'Can I embed a tool?',
    a: 'Each tool page includes an iframe example with a descriptive title and source link. A site owner should still review the embed for their own privacy, security, and accessibility requirements.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'NoCharge Tools',
    description: 'Free client-side tools for choosing a browser game, trying synthesized ambient audio, and estimating a viewport after browser zoom.',
    url: 'https://nocharge.net/tools/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/#faq',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
    ],
  },
];
---

<BaseLayout
  title="Tools — Free browser game utilities"
  description="Client-side tools for choosing a NoCharge game, trying ten synthesized ambient textures, and estimating an equivalent viewport after browser zoom."
  path="/tools/"
  schema={schema}
  showAds={false}
>
  <div class="tools-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
    <header>
      <p class="eyebrow">Small browser utilities</p>
      <h1 class="page-title">Free tools for quiet play</h1>
      <p class="lede">Choose a game for the time and input you have, try a locally synthesized background texture, or estimate the layout space available after browser zoom.</p>
    </header>

    <section class="tool-grid" aria-label="Available tools">
      <article class="panel tool-card">
        <h2><a href="/tools/discovery-wheel/">Game Discovery Wheel</a></h2>
        <p>Filter the live arcade collection by time, documented input, pressure, and number of players. Results include direct play and guide links.</p>
        <p><strong>Useful when:</strong> you know the kind of session you want but not the game.</p>
      </article>
      <article class="panel tool-card">
        <h2><a href="/tools/ambient-mixer/">Ambient Mixer</a></h2>
        <p>Try white noise, environmental approximations, sparse generated notes, or a low drone. Audio is synthesized with Web Audio and stops when the page is hidden.</p>
        <p><strong>Useful when:</strong> you want to compare a low background texture with silence.</p>
      </article>
      <article class="panel tool-card">
        <h2><a href="/tools/zoom-visualizer/">Browser Zoom Viewport Calculator</a></h2>
        <p>Convert a starting viewport and browser zoom percentage into approximate CSS layout dimensions, then use that size for manual reflow testing.</p>
        <p><strong>Useful when:</strong> preparing 200% or 400% browser-zoom checks.</p>
      </article>
    </section>

    <section class="panel tools-faq" id="faq" aria-labelledby="tools-faq-heading">
      <h2 id="tools-faq-heading">FAQ — Tools</h2>
      <dl>
        {faqs.map(({ q, a }) => <><dt>{q}</dt><dd>{a}</dd></>)}
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .tools-page { display: grid; gap: 2rem; max-width: 52rem; margin-inline: auto; min-width: 0; }
  .tool-grid { display: grid; gap: 1rem; }
  .tool-card { padding: 1.25rem; display: grid; gap: 0.5rem; }
  .tool-card h2 a { color: var(--accent-strong); text-decoration: underline; }
  .tool-card p { color: var(--muted); }
  .tools-faq { padding: 1.25rem; display: grid; gap: 1rem; }
  .tools-faq dl { display: grid; gap: 0.6rem; }
  .tools-faq dt { color: var(--text); font-weight: 700; }
  .tools-faq dd { color: var(--muted); margin: 0; }
  @media (min-width: 48rem) { .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
