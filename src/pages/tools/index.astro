---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import { TOOLS, TOOL_CATEGORIES } from '../../config/tools';

const faqs = [
  {
    q: 'Do these tools need an account?',
    a: 'No. Their calculations, filters, and audio generation run in the browser. The site Privacy page explains separate analytics and advertising choices.',
  },
  {
    q: 'Do the tools upload my entries?',
    a: 'No. Values you enter are used only by the current page. The ambient mixer synthesizes audio locally with the Web Audio API, and no tool sends your input to NoCharge.',
  },
  {
    q: 'How is a tool categorized?',
    a: 'Each tool appears in one of five categories by its primary purpose: Play, Audio, Accessibility, Setup helpers, or Learning. Categories are descriptive, not a ranking.',
  },
  {
    q: 'Can I embed a tool?',
    a: 'Each tool page includes an iframe example with a descriptive title and source link. A site owner should still review the embed for their own privacy, security, and accessibility requirements.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'NoCharge Tools',
    description: 'Free client-side tools for choosing a browser game, trying ten calm procedural soundscapes, checking accessibility details, and estimating setup dimensions.',
    url: 'https://nocharge.net/tools/',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: TOOLS.length,
      itemListElement: TOOLS.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.title,
        url: `https://nocharge.net/tools/${tool.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/#faq',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
    ],
  },
];
---

<BaseLayout
  title="Tools — Free browser game utilities"
  description="Client-side tools for choosing a NoCharge game, trying ten calm procedural soundscapes, checking accessibility details, and estimating setup dimensions."
  path="/tools/"
  schema={schema}
  showAds={false}
>
  <div class="tools-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools' }]} />
    <header>
      <p class="eyebrow">Small browser utilities</p>
      <h1 class="page-title">Free tools for quiet play</h1>
      <p class="lede">
        Choose a game for the time and input you have, try a continuously generated procedural soundscape, check contrast or focus order, or estimate the layout space after browser zoom. Every tool runs in this browser and needs no account.
      </p>
      <dl class="tools-facts">
        <div><dt>{TOOLS.length}</dt><dd>tools</dd></div>
        <div><dt>0</dt><dd>uploads</dd></div>
        <div><dt>{TOOL_CATEGORIES.length}</dt><dd>categories</dd></div>
      </dl>
    </header>

    <nav class="tools-category-nav" aria-label="Tool categories">
      {TOOL_CATEGORIES.map((category) => <a href={`#tools-${category.id}`}>{category.label}</a>)}
    </nav>

    {
      TOOL_CATEGORIES.map((category) => {
        const tools = TOOLS.filter((tool) => tool.category === category.id);
        if (tools.length === 0) return null;
        return (
          <section class="tools-section" id={`tools-${category.id}`} aria-labelledby={`tools-${category.id}-heading`}>
            <div class="tools-section__heading">
              <p class="section-kicker">Tool category</p>
              <h2 id={`tools-${category.id}-heading`}>{category.label}</h2>
              <p>{category.blurb}</p>
            </div>
            <div class="tool-grid">
              {tools.map((tool) => (
                <article class="panel tool-card">
                  <h3><a href={`/tools/${tool.slug}/`}>{tool.title}</a></h3>
                  <p>{tool.description}</p>
                  <p><strong>Useful when:</strong> {tool.usefulWhen}</p>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }

    <section class="tools-note panel" aria-labelledby="tools-note-heading">
      <div>
        <p class="section-kicker">How these tools behave</p>
        <h2 id="tools-note-heading">In the browser, and nowhere else.</h2>
      </div>
      <div>
        <p>No tool sends your inputs to NoCharge. Where a tool writes a preference (for example an audio texture choice), the Privacy page documents it and Clear game data removes it.</p>
        <p>Tool results are estimates and explanations, not guarantees. Each page states what it cannot do next to what it can.</p>
      </div>
    </section>

    <section class="prose" aria-labelledby="faq">
      <h2 id="faq">FAQ — Tools</h2>
      <FaqList items={faqs} />
    </section>
  </div>
</BaseLayout>

<style>
  .tools-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4rem);
    min-width: 0;
  }

  .tools-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 30rem;
    margin: 1.3rem 0 0;
  }

  .tools-facts div {
    padding: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
  }

  .tools-facts dt {
    color: var(--accent-strong);
    font-size: 1.3rem;
    font-weight: 800;
  }

  .tools-facts dd {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .tools-category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tools-category-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .tools-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .tools-section__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    max-width: 44rem;
  }

  .tools-section__heading h2 {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    letter-spacing: -0.03em;
  }

  .tools-section__heading p:last-child {
    color: var(--muted);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  .tool-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    padding: 1.2rem;
  }

  .tool-card h3 {
    font-size: 1.15rem;
  }

  .tool-card h3 a {
    color: var(--accent-strong);
  }

  .tool-card p {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .tools-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  .tools-note > div:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
  }

  .tools-note h2 {
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
  }

  .tools-note p {
    color: var(--muted);
  }

  .prose {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    max-width: 46rem;
  }

  .tools-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .tools-faq dt {
    font-weight: 700;
  }

  .tools-faq dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tools-note {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(20rem, 1.2fr);
      align-items: start;
    }
  }
</style>
