---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { isPassPlayGameId } from '../../games/shared/pass-play';

const allGames = (await getCollection('games'))
  .filter((game) => !game.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const discoveryGames = allGames.map((game) => {
  const controls = game.data.presentation?.controls
    .map(({ label, description }) => `${label} ${description}`)
    .join(' ') ?? '';
  const minutes = [...game.data.session.matchAll(/\d+/g)].map((match) => Number(match[0]));
  return {
    id: game.id,
    title: game.data.title,
    genre: game.data.genre,
    session: minutes.length ? Math.max(...minutes) : 10,
    sessionLabel: game.data.session,
    input: [
      'pointer',
      'touch',
      ...(/keyboard|arrow|enter|space|digit|key\b/i.test(controls) ? ['keyboard'] : []),
    ],
    pressure: game.id === 'word-tile-rush' ? 'timed' : game.id === 'color-flip' ? 'either' : 'untimed',
    players: isPassPlayGameId(game.id) ? 'passplay' : 'solo',
    tagline: game.data.tagline,
  };
});

const faqs = [
  {
    q: 'What can I play in a very short break?',
    a: 'Choose two minutes and leave the other filters open. The results favor shorter sessions such as Tic-Tac-Toe and Memory Match; an individual round can still vary.',
  },
  {
    q: 'How does the discovery wheel choose games?',
    a: 'It reads the current published game collection, filters it by the choices above, and rotates through matching games in collection order. The order is not a quality ranking.',
  },
  {
    q: 'What happens when no game matches every filter?',
    a: 'The tool says that no exact match was found instead of silently ignoring a choice. Broaden the time, input, pressure, or player filter to see results.',
  },
  {
    q: 'Can I share or embed this tool?',
    a: 'Yes. The example below includes an iframe title and a separate source link. A site owner should check their own privacy and accessibility requirements before embedding it.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': 'https://nocharge.net/tools/discovery-wheel/#app',
    name: 'NoCharge Game Discovery Wheel',
    description: 'A free client-side tool for filtering the current NoCharge game catalog by time, input, pressure, and number of players.',
    url: 'https://nocharge.net/tools/discovery-wheel/',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/tools/discovery-wheel/#faq',
    mainEntity: faqs.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://nocharge.net/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Game Discovery Wheel', item: 'https://nocharge.net/tools/discovery-wheel/' },
    ],
  },
];
---

<BaseLayout
  title="Game Discovery Wheel — No Charge Games"
  description="Filter the current NoCharge game catalog by time, input, pressure, and number of players. Free to use without an account."
  path="/tools/discovery-wheel/"
  schema={schema}
  showAds={false}
  additionalImages={[{ url: '/social/nocharge-default.jpg', width: 1200, height: 630, alt: 'NoCharge game discovery wheel' }]}
>
  <div class="tool-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: 'Discovery Wheel' }]} />
    <header>
      <p class="eyebrow">Choose from the current arcade</p>
      <h1>Game Discovery Wheel</h1>
      <p class="lede">Pick the time, input, pace, and number of players that fit this session. The tool returns up to three matching NoCharge games with direct play and guide links.</p>
    </header>

    <blockquote>
      <p><strong>Bottom line:</strong> The wheel filters the live game catalog rather than keeping a second hand-written list. It runs in your browser, needs no account, and does not treat its result order as a ranking.</p>
    </blockquote>

    <section class="panel tool-controls" aria-labelledby="controls-heading">
      <h2 id="controls-heading">Pick your filters</h2>
      <div class="controls-grid">
        <label>Time <select id="time"><option value="2">About 2 minutes</option><option value="5" selected>About 5 minutes</option><option value="15">Up to 15 minutes</option></select></label>
        <label>Input <select id="input"><option value="any" selected>Any documented input</option><option value="keyboard">Keyboard-friendly</option><option value="pointer">Pointer</option><option value="touch">Touch</option></select></label>
        <label>Pressure <select id="pressure"><option value="any" selected>Any pace</option><option value="untimed">Untimed / reduced pressure</option><option value="timed">Timed</option></select></label>
        <label>Players <select id="players"><option value="any" selected>Any</option><option value="solo">Solo</option><option value="passplay">Pass &amp; Play</option></select></label>
        <button id="spin" class="btn" type="button">Show another match</button>
      </div>
      <div id="results" class="results-grid" data-games={JSON.stringify(discoveryGames)} aria-live="polite"></div>
    </section>

    <section class="prose">
      <h2>How the filters work</h2>
      <p>Session lengths come from each published game entry and are estimates, not timers or promises. The input filter uses the controls documented with the game. Pass &amp; Play means two people take turns on one device; it does not imply online multiplayer.</p>
      <ul>
        <li><strong>Time:</strong> keeps games whose listed upper estimate fits the selected window.</li>
        <li><strong>Input:</strong> checks the documented keyboard, pointer, or touch path.</li>
        <li><strong>Pressure:</strong> separates Word Tile Rush’s timed loop from untimed play. Color Flip can match either because it has visual and turn-based modes.</li>
        <li><strong>Players:</strong> separates solo games from the six shared-device Pass &amp; Play games.</li>
      </ul>

      <h2>Examples at a glance</h2>
      <table>
        <thead><tr><th>Need</th><th>Useful filter</th><th>What to verify on the result</th></tr></thead>
        <tbody>
          <tr><td>Short keyboard break</td><td>5 minutes + keyboard</td><td>Read the game’s exact key list before starting.</td></tr>
          <tr><td>Two people, one screen</td><td>Pass &amp; Play</td><td>Use the handoff screen between turns.</td></tr>
          <tr><td>No countdown</td><td>Untimed / reduced pressure</td><td>Check the guide because individual modes can differ.</td></tr>
          <tr><td>Phone session</td><td>Touch</td><td>Use Play to enter Game Mode when useful.</td></tr>
        </tbody>
      </table>

      <h2>Before changing equipment</h2>
      <ul>
        <li>Try a game’s documented keyboard and pointer alternatives with the devices you already have.</li>
        <li>Adjust browser zoom and use the game’s normal view before deciding a larger display is needed.</li>
        <li>Use the guide link in each result to confirm controls, timing, and local storage behavior.</li>
      </ul>

      <h2 id="faq">FAQ — Discovery Wheel</h2>
      <dl>
        {faqs.map(({ q, a }) => <><dt>{q}</dt><dd>{a}</dd></>)}
      </dl>

      <h2>Embed this tool</h2>
      <pre><code>&lt;iframe src="https://nocharge.net/tools/discovery-wheel/" width="400" height="600" title="NoCharge game discovery wheel"&gt;&lt;/iframe&gt;
&lt;p&gt;Source: &lt;a href="https://nocharge.net/tools/discovery-wheel/"&gt;NoCharge game discovery wheel&lt;/a&gt;&lt;/p&gt;</code></pre>

      <h2>Next action</h2>
      <p>Choose the limits that matter for this session, open one result, and check its guide if you need the complete controls or rules.</p>
    </section>
  </div>
</BaseLayout>

<script>
  interface DiscoveryGame {
    id: string;
    title: string;
    genre: string;
    session: number;
    sessionLabel: string;
    input: string[];
    pressure: 'timed' | 'untimed' | 'either';
    players: 'solo' | 'passplay';
    tagline: string;
  }

  const resultsEl = document.querySelector<HTMLDivElement>('#results');
  const timeInput = document.querySelector<HTMLSelectElement>('#time');
  const inputInput = document.querySelector<HTMLSelectElement>('#input');
  const pressureInput = document.querySelector<HTMLSelectElement>('#pressure');
  const playersInput = document.querySelector<HTMLSelectElement>('#players');
  const spinButton = document.querySelector<HTMLButtonElement>('#spin');

  if (resultsEl && timeInput && inputInput && pressureInput && playersInput && spinButton) {
    let games: DiscoveryGame[] = [];
    let offset = 0;
    try {
      games = JSON.parse(resultsEl.dataset.games ?? '[]') as DiscoveryGame[];
    } catch {
      resultsEl.textContent = 'The game list could not be read. Open the Arcade to browse all games.';
    }

    const addText = (parent: HTMLElement, tag: 'h3' | 'p', text: string) => {
      const child = document.createElement(tag);
      child.textContent = text;
      parent.append(child);
    };

    const render = (advance = false) => {
      if (advance) offset += 1;
      const maxMinutes = Number(timeInput.value);
      const input = inputInput.value;
      const pressure = pressureInput.value;
      const players = playersInput.value;
      const filtered = games.filter((game) => {
        if (game.session > maxMinutes) return false;
        if (players !== 'any' && game.players !== players) return false;
        if (input !== 'any' && !game.input.includes(input)) return false;
        if (pressure !== 'any' && game.pressure !== 'either' && game.pressure !== pressure) return false;
        return true;
      });

      resultsEl.replaceChildren();
      if (!filtered.length) {
        addText(resultsEl, 'p', 'No exact match. Broaden one filter to see games; none of your choices were ignored.');
        return;
      }

      const picked = Array.from({ length: Math.min(3, filtered.length) }, (_, index) => filtered[(offset + index) % filtered.length]);
      for (const game of picked) {
        const card = document.createElement('article');
        card.className = 'panel result-card';
        addText(card, 'h3', game.title);
        addText(card, 'p', `${game.genre} · ${game.sessionLabel} · ${game.players === 'solo' ? 'Solo' : 'Pass & Play'}`);
        addText(card, 'p', game.tagline);
        const links = document.createElement('p');
        const play = document.createElement('a');
        play.href = `/games/${game.id}/`;
        play.textContent = `Play ${game.title}`;
        const separator = document.createTextNode(' · ');
        const guide = document.createElement('a');
        guide.href = `/guides/${game.id}/`;
        guide.textContent = 'Guide';
        links.append(play, separator, guide);
        card.append(links);
        resultsEl.append(card);
      }
    };

    spinButton.addEventListener('click', () => render(true));
    for (const control of [timeInput, inputInput, pressureInput, playersInput]) {
      control.addEventListener('change', () => { offset = 0; render(); });
    }
    render();
  }
</script>

<style>
  .tool-page { max-width: 52rem; margin-inline: auto; display: grid; gap: 1.5rem; min-width: 0; }
  .tool-controls { padding: 1.25rem; display: grid; gap: 1rem; }
  .controls-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr)); align-items: end; }
  .controls-grid label { display: grid; gap: 0.3rem; color: var(--muted); font-size: 0.85rem; }
  .controls-grid select { min-height: 44px; padding: 0.5rem; border-radius: 6px; color: var(--text); background: var(--panel-2); border: 1px solid var(--line); }
  .results-grid { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); }
  .results-grid :global(.result-card) { padding: 1rem; display: grid; gap: 0.4rem; }
  .results-grid :global(.result-card h3) { font-size: 1.05rem; }
  .results-grid :global(.result-card p) { color: var(--muted); font-size: 0.85rem; }
  .prose { display: grid; gap: 1rem; max-width: 46rem; min-width: 0; }
  .prose table { width: 100%; display: block; overflow-x: auto; border: 1px solid var(--line); border-collapse: collapse; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 0.5rem; font-size: 0.84rem; min-width: 0; word-break: break-word; }
  .prose blockquote { border-left: 4px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--panel-2)); padding: 0.8rem 1rem; border-radius: 6px; }
</style>
