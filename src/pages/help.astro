---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: 'NoCharge Help', description: 'Practical help for starting, controlling, and troubleshooting NoCharge games.', url: 'https://nocharge.net/help/' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
    { '@type': 'ListItem', position: 2, name: 'Help', item: 'https://nocharge.net/help/' },
  ] },
];
---
<BaseLayout title="Help" description="Practical help for starting, controlling, and troubleshooting NoCharge games." path="/help/" schema={schema}>
  <div class="help-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Help' }]} />
    <header><picture class="help-art"><source srcset="/editorial-art/help.webp" type="image/webp" /><img src="/editorial-art/help.jpg" alt="Abstract controls and return paths surround a compact game board." width="1600" height="900" /></picture><p class="eyebrow">Player support</p><h1 class="page-title">Get back to the game.</h1><p class="lede">A practical guide to controls, local progress, and the few things worth checking when a browser behaves differently.</p></header>
    <div class="help-grid">
      <section class="panel help-section"><h2>Starting and controlling a game</h2><ul><li>Open a game from the <a href="/arcade/">Arcade</a> and use Start or the first available board control.</li><li>Restart with <strong>New game</strong> in the shared game toolbar.</li><li>Use the toolbar to pause and Resume. Switching tabs pauses active play; returning resumes only when the game was not manually paused.</li><li>Game pages document keyboard controls. Touch and pointer controls are available where the game supports them.</li><li>Mute is persistent in this browser. Fullscreen or immersive mode depends on the browser and device permission.</li></ul></section>
      <section class="panel help-section"><h2>Scores and local data</h2><p>Best results and game progress are stored in this browser on this device. No account or cloud sync is involved, so a different browser will not have the same local data.</p><p>Use <a href="/privacy/">Privacy</a> to clear game data. Clearing game data does not change your separate analytics consent choice.</p><p><a href="/">Recently Played</a> records a small local list after meaningful play so you can return to a game.</p></section>
      <section class="panel help-section"><h2>When something does not work</h2><ul><li>Reload the page and make sure the browser is current.</li><li>If a game does not load, disable a content blocker for NoCharge, check the browser console-free basics such as JavaScript being enabled, and try a private window or another current browser.</li><li>If sound differs, check the device volume, browser tab mute, and the game mute control.</li><li>If fullscreen behaves differently, use the browser’s own fullscreen permission or continue in the normal view.</li><li>If a layout or control is difficult to use, email an accessibility report with the page, browser, device type, and what happened.</li></ul></section>
      <section class="panel help-section"><h2>Need to report a problem?</h2><p>For a broken game, accessibility problem, privacy question, or problematic advertisement, contact <a href="mailto:hello@nocharge.net">hello@nocharge.net</a>. Please do not send passwords or sensitive personal information.</p><p>Advertising and analytics are separate choices. See <a href="/advertising/">Advertising</a> and <a href="/privacy/">Privacy</a> for the relevant explanations.</p></section>
    </div>
  </div>
</BaseLayout>
<style>
.help-art{display:block;aspect-ratio:16/9;overflow:hidden;border-radius:var(--radius);margin-bottom:1.25rem}.help-art img{width:100%;height:100%;object-fit:cover}.help-page{display:grid;gap:2.5rem;max-width:58rem;margin-inline:auto}.help-page>header{max-width:48rem}.help-grid{display:grid;gap:1rem}.help-section{padding:1.25rem}.help-section h2{font-size:1.25rem;letter-spacing:-.025em}.help-section p,.help-section li{color:var(--muted)}.help-section p+p{margin-top:.8rem}.help-section ul{display:grid;gap:.55rem;margin:.85rem 0 0;padding-left:1.2rem}.help-section a{color:var(--accent-strong);text-decoration:underline;text-underline-offset:3px}@media(min-width:48rem){.help-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
