---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: 'NoCharge Help', description: 'Practical help for starting, controlling, and troubleshooting NoCharge games.', url: 'https://nocharge.net/help/' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
    { '@type': 'ListItem', position: 2, name: 'Help', item: 'https://nocharge.net/help/' },
  ] },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://nocharge.net/help/#faq',
    mainEntity: [
      { '@type': 'Question', name: 'Do I need an account to play?', acceptedAnswer: { '@type': 'Answer', text: 'No. All NoCharge games run locally in your browser without an account. Scores and preferences are saved in localStorage on this device only.' } },
      { '@type': 'Question', name: 'How do I clear my game data?', acceptedAnswer: { '@type': 'Answer', text: 'Open Privacy page and use Clear game data. This removes keys like nocharge:freecell:games-won and nocharge:consent, but leaves analytics consent separate. My Arcade has the same control.' } },
      { '@type': 'Question', name: 'Why does a game pause when I switch tabs?', acceptedAnswer: { '@type': 'Answer', text: 'NoCharge pauses timed activity when the document becomes hidden and resumes when visible, unless you manually paused. Ambient sound stops when hidden to avoid background static during multitasking.' } },
      { '@type': 'Question', name: 'Does NoCharge have ads or affiliate links?', acceptedAnswer: { '@type': 'Answer', text: 'Game pages show one responsive AdSense banner outside gameplay. Quiet Setup articles have no display ads but may contain clearly marked Amazon affiliate links with tag nocharge-20 that open in a new tab.' } },
      { '@type': 'Question', name: 'How do I enter fullscreen or focus mode?', acceptedAnswer: { '@type': 'Answer', text: 'Use Play button to enter Game Mode (native fullscreen if supported, otherwise fixed immersive fallback). Exit with Escape or the Exit button. Focus returns to the button that entered. The toolbar collapses to a single row in Game Mode.' } },
      { '@type': 'Question', name: 'Are the games accessible by keyboard?', acceptedAnswer: { '@type': 'Answer', text: 'Many games document keyboard controls in their guides. Check each guide page for specific keys. Focus outlines remain visible and no board uses transform scale. Cards keep 44px touch target.' } },
      { '@type': 'Question', name: 'How does ambient sound work?', acceptedAnswer: { '@type': 'Answer', text: 'Ambient options like white-noise, rainfall, forest, fireplace, ocean, night, cafe, library, lofi, and drone are procedural via Web Audio API, no MP3 download. They are quiet loops, respect mute and volume, and stop when tab is hidden.' } },
      { '@type': 'Question', name: 'Does ambient work offline?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Ambient is generated locally with AudioContext and AudioBuffer, no network request. It works offline after page load, but needs a user gesture to unlock audio on iOS Safari.' } },
      { '@type': 'Question', name: 'How do I report a broken ad?', acceptedAnswer: { '@type': 'Answer', text: 'Email hello@nocharge.net with page URL, browser, device, and what you saw. Use Privacy and cookie settings in footer to manage Google ad choices via Funding Choices.' } },
      { '@type': 'Question', name: 'What is Game Mode on mobile?', acceptedAnswer: { '@type': 'Answer', text: 'Game Mode expands the board to fill the viewport with fixed height, no scrolling. The toolbar becomes a single icon row. The fan replaces tableau when a pile is too tall, staying inside stage.' } },
      { '@type': 'Question', name: 'How does Recently Played work?', acceptedAnswer: { '@type': 'Answer', text: 'Recently Played records a small local list after meaningful game interaction (e.g., a move). Opening My Arcade does not count as playing, so it never changes order.' } },
      { '@type': 'Question', name: 'How does Pass & Play handoff work?', acceptedAnswer: { '@type': 'Answer', text: 'After each turn a handoff screen names the next player. Press Continue when device has changed hands. Player names last only for current session and are never saved. One most recent match per game is shown in My Arcade.' } },
      { '@type': 'Question', name: 'What is Quiet Setup?', acceptedAnswer: { '@type': 'Answer', text: 'Quiet Setup at /setup/ is first-party editorial comparing keyboards, pointing devices, screens, stands, desk comfort, offline puzzles, audio, and lighting. Each guide starts with no-purchase checks and has clearly marked Amazon affiliate links.' } },
      { '@type': 'Question', name: 'How are scores saved without an account?', acceptedAnswer: { '@type': 'Answer', text: 'Scores use localStorage keys like nocharge:memory-match:best-moves. No cloud sync, no encryption claim. Clearing browser storage removes them. See how NoCharge saves scores article.' } },
      { '@type': 'Question', name: 'How do I change analytics choices?', acceptedAnswer: { '@type': 'Answer', text: 'Footer has Analytics choices button and Privacy and cookie settings for Google. Analytics stays off unless you allow it. You can withdraw without reload.' } },
      { '@type': 'Question', name: 'What is the difference between mute and sound off?', acceptedAnswer: { '@type': 'Answer', text: 'Mute is persistent master mute for effects and ambient. Sound on/off controls effects only. Volume is independent. Device mute can silence everything.' } },
    ],
  },
];
---
<BaseLayout title="Help" description="Practical help for starting, controlling, and troubleshooting NoCharge games." path="/help/" schema={schema}>
  <div class="help-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Help' }]} />
    <header><picture class="help-art"><source srcset="/editorial-art/help-800.webp 800w, /editorial-art/help-1200.webp 1200w, /editorial-art/help-1600.webp 1600w" sizes="(max-width: 58rem) calc(100vw - 2rem), 58rem" type="image/webp" /><img src="/editorial-art/help-1600.jpg" srcset="/editorial-art/help-800.jpg 800w, /editorial-art/help-1200.jpg 1200w, /editorial-art/help-1600.jpg 1600w" sizes="(max-width: 58rem) calc(100vw - 2rem), 58rem" alt="Help illustration: player support for NoCharge games" width="1600" height="900" /></picture><p class="eyebrow">Player support</p><h1 class="page-title">Get back to the game.</h1><p class="lede">A practical guide to controls, local progress, and the few things worth checking when a browser behaves differently.</p></header>
    <div class="help-grid">
      <section class="panel help-section"><h2>Starting and controlling a game</h2><ul><li>Open a game from the <a href="/arcade/">Arcade</a> and use Start or the first available board control.</li><li>Restart with <strong>New game</strong> in the shared game toolbar.</li><li>Use the toolbar to pause and Resume. Switching tabs pauses active play; returning resumes only when the game was not manually paused.</li><li>Game pages document keyboard controls. Touch and pointer controls are available where the game supports them.</li><li>Mute is persistent in this browser. Fullscreen or immersive mode depends on the browser and device permission.</li></ul></section>
      <section class="panel help-section"><h2>Scores and local data</h2><p>Best results and game progress are stored in this browser on this device. No account or cloud sync is involved, so a different browser will not have the same local data.</p><p>Use <a href="/privacy/">Privacy</a> to clear game data. Clearing game data does not change your separate analytics consent choice.</p><p><a href="/">Recently Played</a> records a small local list after meaningful play so you can return to a game.</p></section>
      <section class="panel help-section"><h2>My Arcade</h2><p><a href="/my-arcade/">My Arcade</a> gathers what this browser has already saved: the games you last played, each game’s own best result or progress, and links back into the game and its guide. It is not an account, and there is no single score across different games.</p><p>It will look different in another browser, another profile, a private window, or another device, because the underlying values are stored only where you played. A game with nothing saved simply says so.</p><p>Clear the data with the <a href="/privacy/#local-data">Clear game data</a> control on Privacy or the matching control on My Arcade; both remove the same game keys and leave your analytics consent choice alone.</p><p>Opening My Arcade does not count as playing. Recently Played is written only after a real action inside a game, so viewing the dashboard never changes its order or timestamps.</p></section>
      <section class="panel help-section"><h2>Pass &amp; Play games</h2><p>Pass &amp; Play games — Tic-Tac-Toe, Dots &amp; Boxes, Four in a Row, Reversi, Last Token, and Pass the Picture — are for two people on one device. After each turn a handoff screen names the player the device is passed to; press Continue when it has changed hands.</p><p>Player names can be edited in the handoff screen and last only for the current browser session — they are never saved. Each game keeps a single most recent match record in this browser, shown in the Pass &amp; Play section of My Arcade. Pass the Picture draws with a pointer; its colors, undo, and restart also work from the keyboard.</p></section>
      <section class="panel help-section"><h2>Sound controls</h2><p>Sound on/off controls effects, while Mute sound is the persistent master mute for effects and ambient. Volume and Ambient are independent local preferences. Device or system mute can silence everything; live announcements remain independent of sound.</p><p>Ambient options include white-noise, rainfall, forest, fireplace, ocean, night, cafe, library, lofi, and drone — all procedural via Web Audio API, no MP3. Ambient stops when tab is hidden to avoid background static during multitasking.</p></section>
      <section class="panel help-section"><h2>When something does not work</h2><ul><li>Reload the page and make sure the browser is current.</li><li>If a game does not load, confirm JavaScript is enabled, review whether a browser extension is blocking the game, and optionally try a private window or another current browser.</li><li>If sound differs, check the device volume, browser tab mute, and the game mute control.</li><li>If fullscreen behaves differently, use the browser’s own fullscreen permission or continue in the normal view.</li><li>If a layout or control is difficult to use, email an accessibility report with the page, browser, device type, and what happened.</li></ul></section>
      <section class="panel help-section"><h2>Setup and input choices</h2><p>If zoom, a keyboard layout, pointer, stand, or low-noise desk question is getting in the way, <a href="/setup/">Quiet Setup</a> compares practical options and begins with no-purchase adjustments. It is editorial guidance, separate from game controls and gameplay.</p></section>
      <section class="panel help-section"><h2>Need to report a problem?</h2><p>For a broken game, accessibility problem, privacy question, or problematic advertisement, contact <a href="mailto:hello@nocharge.net">hello@nocharge.net</a>. Please do not send passwords or sensitive personal information.</p><p>Advertising and analytics are separate choices. Games remain playable when optional analytics is declined. See <a href="/advertising/">Advertising</a> and <a href="/privacy/">Privacy</a> for the relevant explanations.</p></section>
    </div>
    <section class="panel help-section" id="faq"><h2>FAQ — Quick answers for AI and players</h2>
      <dl>
        <dt>Do I need an account to play?</dt><dd>No. All games run locally without an account. Scores stay in localStorage on this device only.</dd>
        <dt>How do I clear my game data?</dt><dd>Use Privacy → Clear game data or My Arcade → Clear game data. Removes nocharge:* keys, leaves analytics consent.</dd>
        <dt>Why does a game pause when I switch tabs?</dt><dd>Hidden tab adds pause reason. Ambient stops when hidden to avoid background static. Returning removes hidden reason unless manually paused.</dd>
        <dt>Does NoCharge have ads or affiliate links?</dt><dd>Game pages have one AdSense banner outside gameplay. Setup has no display ads but has marked Amazon links tag nocharge-20 opening in new tab.</dd>
        <dt>How do I enter fullscreen or focus mode?</dt><dd>Play button enters Game Mode (native fullscreen if supported, else fixed immersive). Exit with Escape or Exit button. Toolbar collapses to one row.</dd>
        <dt>Are the games accessible by keyboard?</dt><dd>Many document keyboard controls in guides. Focus outlines visible, 44px targets, no transform scale.</dd>
        <dt>How does ambient sound work?</dt><dd>Procedural Web Audio, no MP3. 10 options: white-noise, rainfall, forest, fireplace, ocean, night, cafe, library, lofi, drone. Respects mute/volume, stops when hidden.</dd>
        <dt>Does ambient work offline?</dt><dd>Yes, generated locally after load, no network. Needs user gesture on iOS Safari to unlock.</dd>
        <dt>How do I report a broken ad?</dt><dd>Email hello@nocharge.net with URL, browser, device. Use footer Privacy and cookie settings for Google choices.</dd>
        <dt>What is Game Mode on mobile?</dt><dd>Expands board to fill viewport, no scroll, fan replaces tall piles inside stage, toolbar single row.</dd>
        <dt>How does Recently Played work?</dt><dd>Records after meaningful interaction only. Opening My Arcade does not change order.</dd>
        <dt>How does Pass &amp; Play handoff work?</dt><dd>Handoff screen names next player, press Continue when passed. Names session-only, one most recent match per game in My Arcade.</dd>
        <dt>What is Quiet Setup?</dt><dd>First-party editorial at /setup/ comparing keyboards, pointing, screens, desk, puzzles, audio, lighting. Starts with no-purchase checks.</dd>
        <dt>How are scores saved without an account?</dt><dd>localStorage keys like nocharge:memory-match:best-moves. No sync, no encryption claim.</dd>
        <dt>How do I change analytics choices?</dt><dd>Footer Analytics choices + Privacy and cookie settings. Off by default, withdraw without reload.</dd>
        <dt>What is mute vs sound off?</dt><dd>Mute is master for effects+ambient, persistent. Sound on/off is effects only. Volume independent.</dd>
      </dl>
    </section>
  </div>
</BaseLayout>
<style>
.help-art{display:block;aspect-ratio:16/9;overflow:hidden;border-radius:var(--radius);margin-bottom:1.25rem}.help-art img{width:100%;height:100%;object-fit:cover}.help-page{display:grid;gap:2.5rem;max-width:58rem;margin-inline:auto}.help-page>header{max-width:48rem}.help-grid{display:grid;gap:1rem}.help-section{padding:1.25rem}.help-section h2{font-size:1.25rem;letter-spacing:-.025em}.help-section p,.help-section li,.help-section dd{color:var(--muted)}.help-section p+p{margin-top:.8rem}.help-section ul,.help-section dl{display:grid;gap:.55rem;margin:.85rem 0 0;padding-left:1.2rem}.help-section dl{padding-left:0}.help-section dt{color:var(--text);font-weight:700;margin-top:.6rem}.help-section a{color:var(--accent-strong);text-decoration:underline;text-underline-offset:3px}@media(min-width:48rem){.help-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
