---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/GameShell.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const guideIds = new Set(guides.map((guide) => guide.data.game));
  return games.map((game) => ({
    params: { slug: game.id },
    props: {
      game,
      hasGuide: guideIds.has(game.id),
      relatedGames: games.filter((candidate) => candidate.id !== game.id).sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { game, hasGuide, relatedGames } = Astro.props;
const { Content } = await render(game);
const slug = game.id;
---

<BaseLayout
  title={game.data.title}
  description={game.data.description}
  path={`/games/${game.id}/`}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
>
  <GameShell
    title={game.data.title}
    tagline={game.data.tagline}
    slug={game.id}
    accent={game.data.accent}
    artwork={game.data.artwork}
  >
    <div data-game-root={slug} class="game-root"></div>
    {
      slug === 'memory-match' && (
        <section class="memory-controls" aria-labelledby="memory-controls-heading">
          <div>
            <p class="game-about__kicker">Controls at a glance</p>
            <h2 id="memory-controls-heading">Choose two cards. Remember both positions.</h2>
          </div>
          <ul>
            <li><strong>Touch or pointer</strong><span>Select any hidden card, then select a second.</span></li>
            <li><strong>Keyboard</strong><span>Tab between available cards; reveal with Enter or Space.</span></li>
            <li><strong>Restart</strong><span>Use New game at any time to reshuffle and reset the move count.</span></li>
          </ul>
        </section>
      )
    }
    <section class="game-about" aria-labelledby="game-about-heading">
      <p class="game-about__kicker">About this game</p>
      <h2 id="game-about-heading">How {game.data.title} works</h2>
      <div class="game-about__copy">
        <Content />
      </div>
      <dl class="game-about__facts">
        <div><dt>Genre</dt><dd>{game.data.genre}</dd></div>
        <div><dt>Challenge</dt><dd>{game.data.difficulty}</dd></div>
        <div><dt>Typical run</dt><dd>{game.data.session}</dd></div>
      </dl>
      {
        hasGuide && (
          <a class="game-about__guide" href={`/guides/${slug}/`}>
            Read the complete {game.data.title} guide →
          </a>
        )
      }
    </section>
    {
      slug === 'memory-match' && (
        <nav class="game-related" aria-labelledby="game-related-heading">
          <div>
            <p class="game-about__kicker">Continue exploring</p>
            <h2 id="game-related-heading">Guide the next move—or try another game.</h2>
          </div>
          <ul>
            <li><a href="/guides/memory-match/"><span>Memory Match rules and recall strategy</span><span aria-hidden="true">Guide →</span></a></li>
            {relatedGames.slice(0, 2).map((item) => (
              <li><a href={`/games/${item.id}/`}><span>{item.data.title}</span><span aria-hidden="true">Play →</span></a></li>
            ))}
          </ul>
        </nav>
      )
    }
  </GameShell>
</BaseLayout>

{
  slug === 'memory-match' && (
    <script>
      import '../../games/memory-match/main.ts';
    </script>
  )
}
{
  slug === 'word-tile-rush' && (
    <script>
      import '../../games/word-tile-rush/main.ts';
    </script>
  )
}
{
  slug === 'color-flip' && (
    <script>
      import '../../games/color-flip/main.ts';
    </script>
  )
}

<style>
  .game-root {
    min-height: 12rem;
  }

  .memory-controls {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(18, 182, 106, 0.08), transparent 48%), var(--panel-2);
  }

  .memory-controls h2,
  .game-related h2 {
    margin-top: 0.2rem;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .memory-controls ul,
  .game-related ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .memory-controls li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }

  .memory-controls strong {
    font-size: 0.84rem;
  }

  .memory-controls span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .game-about {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-about__kicker {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-about h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-about__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .game-about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
  }

  .game-about__facts div {
    min-width: 8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--panel-2);
  }

  .game-about__facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .game-about__facts dd {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .game-about__guide {
    justify-self: start;
    min-height: 44px;
    padding-top: 0.7rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .game-related {
    display: grid;
    gap: 0.9rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .game-related a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .memory-controls,
    .game-related {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(20rem, 1.2fr);
    }
  }
</style>
