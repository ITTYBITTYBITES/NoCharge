---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/GameShell.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { isPassPlayGameId } from '../../games/shared/pass-play';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  const guideIds = new Set<string>(guides.map((guide) => guide.data.game));
  return games.map((game) => ({
    params: { slug: game.id },
    props: {
      game,
      hasGuide: guideIds.has(game.id),
      passPlay: isPassPlayGameId(game.id),
      relatedGames: games.filter((candidate) => candidate.id !== game.id).sort((a, b) => a.data.order - b.data.order),
      relatedArticles: articles
        .filter((article) => article.data.kind === 'game' && article.data.game === game.id)
        .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { game, hasGuide, passPlay, relatedGames, relatedArticles } = Astro.props;
const { Content } = await render(game);
const slug = game.id;
const presentation = game.data.presentation;
const stageStyle = presentation?.stageAspectDesktop
  ? `--game-stage-aspect:${presentation.stageAspectDesktop};--game-stage-aspect-mobile:${presentation.stageAspectMobile ?? presentation.stageAspectDesktop}`
  : undefined;

const canonical = `https://nocharge.net/games/${game.id}/`;
const gameImages = game.data.artwork ? [
  `https://nocharge.net${game.data.artwork.coverSquare}`,
  `https://nocharge.net${game.data.artwork.coverLandscape}`,
  `https://nocharge.net${game.data.artwork.socialCard}`,
  `https://nocharge.net${game.data.artwork.coverSquareFallback}`,
] : [];

const gameSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    '@id': `${canonical}#game`,
    name: game.data.title,
    description: game.data.description,
    url: canonical,
    image: gameImages,
    genre: game.data.genre,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web, Windows, macOS, Linux, Android, iOS',
    gamePlatform: 'Web Browser',
    playMode: 'SinglePlayer',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    publisher: {
      '@type': 'Organization',
      name: 'NoCharge',
      url: 'https://nocharge.net/',
      logo: { '@type': 'ImageObject', url: 'https://nocharge.net/icons/icon-512.png', width: 512, height: 512 },
    },
    author: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', '@id': 'https://nocharge.net/#website', name: 'NoCharge' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Arcade', item: 'https://nocharge.net/arcade/' },
      { '@type': 'ListItem', position: 3, name: game.data.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: `How do you play ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: `${game.data.tagline} ${game.data.description} Check controls table for keyboard and pointer options.` },
      },
      {
        '@type': 'Question',
        name: `Is ${game.data.title} free without an account?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. NoCharge games are free, no account required, and scores are saved locally in this browser via localStorage.' },
      },
      {
        '@type': 'Question',
        name: `What are the controls for ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: presentation?.controls?.map(c=>`${c.label}: ${c.description}`).join('. ') || 'Check the controls section on the page for keyboard and pointer options, with visible focus outlines.' },
      },
      {
        '@type': 'Question',
        name: `Where is progress saved for ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: 'In localStorage on this device, under keys like nocharge:game:* . No cloud sync. Clearing browser storage removes it. See Privacy and My Arcade.' },
      },
      {
        '@type': 'Question',
        name: `Does ${game.data.title} pause when tab hidden?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Yes, hidden tab adds pause reason and shows pause overlay. Ambient sound stops when hidden to avoid background static. Returning resumes unless manually paused.' },
      },
      {
        '@type': 'Question',
        name: `How do I restart ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Use New game in toolbar or settings dialog. Resets board and moves without affecting other games or analytics consent.' },
      },
      {
        '@type': 'Question',
        name: `Is ${game.data.title} timed or untimed?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Check genre and session facts on page. Some games are untimed or have turn-based reduced-pressure modes. Guides document timing.' },
      },
      {
        '@type': 'Question',
        name: `How do I mute ${game.data.title} and ambient?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Mute sound is persistent master mute for effects and ambient. Sound on/off is effects only. Volume slider updates ambient gain via Web Audio. Device mute can silence all.' },
      },
    ],
  },
];
---

<BaseLayout
  title={game.data.title}
  description={game.data.description}
  path={`/games/${game.id}/`}
  schema={gameSchema}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
  additionalImages={game.data.artwork ? [
    { url: game.data.artwork.coverSquare, width: 800, height: 800, alt: `${game.data.title} square cover` },
    { url: game.data.artwork.coverLandscape, width: 1280, height: 720, alt: `${game.data.title} landscape cover` },
    { url: `/game-art/${game.id}/pin-1000x1500.jpg`, width: 1000, height: 1500, alt: `Pinterest pin for ${game.data.title}` },
  ] : []}
>
  <GameShell
    title={game.data.title}
    tagline={game.data.tagline}
    slug={game.id}
    accent={game.data.accent}
    artwork={game.data.artwork}
    passPlay={passPlay}
  >
    <div
      slot="game"
      data-game-root={slug}
      class:list={['game-root', { 'game-root--reserved': presentation?.stageAspectDesktop }]}
      style={stageStyle}
    ></div>
    {
      presentation?.controls.length && (
        <section class="game-controls" aria-labelledby="game-controls-heading">
          <div>
            <p class="game-about__kicker">Controls at a glance</p>
            <h2 id="game-controls-heading">{presentation.controlsHeading}</h2>
          </div>
          <ul>
            {presentation.controls.map((control) => (
              <li><strong>{control.label}</strong><span>{control.description}</span></li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="game-about" aria-labelledby="game-about-heading">
      <p class="game-about__kicker">About this game</p>
      <h2 id="game-about-heading">How {game.data.title} works</h2>
      <div class="game-about__copy">
        <Content />
      </div>
      <dl class="game-about__facts">
        <div><dt>Genre</dt><dd>{game.data.genre}</dd></div>
        <div><dt>Challenge</dt><dd>{game.data.difficulty}</dd></div>
        <div><dt>Typical run</dt><dd>{game.data.session}</dd></div>
      </dl>
      {
        hasGuide && (
          <a class="game-about__guide" href={`/guides/${slug}/`}>
            Read the complete {game.data.title} guide →
          </a>
        )
      }
    </section>
    {
      relatedArticles.length > 0 && (
        <section class="game-articles" aria-labelledby="game-articles-heading">
          <div>
            <p class="game-about__kicker">Player notes</p>
            <h2 id="game-articles-heading">More ways to read this game</h2>
            <p>Original articles about the systems and decisions inside {game.data.title}.</p>
          </div>
          <div class="game-articles__grid">
            {relatedArticles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                label={game.data.title}
                readTime={article.data.readTime}
                published={article.data.published}
                topics={article.data.topics}
                accent={game.data.accent}
              />
            ))}
          </div>
          <a class="game-about__guide" href="/articles/">Browse all game articles →</a>
        </section>
      )
    }
    {
      presentation?.relatedHeading && (
        <nav class="game-related" aria-labelledby="game-related-heading">
          <div>
            <p class="game-about__kicker">Continue exploring</p>
            <h2 id="game-related-heading">{presentation.relatedHeading}</h2>
          </div>
          <ul>
            {
              hasGuide && (
                <li>
                  <a href={`/guides/${slug}/`}>
                    <span>{presentation.relatedGuideLabel ?? `${game.data.title} guide`}</span>
                    <span aria-hidden="true">Guide →</span>
                  </a>
                </li>
              )
            }
            {relatedGames.slice(0, 2).map((item) => (
              <li><a href={`/games/${item.id}/`}><span>{item.data.title}</span><span aria-hidden="true">Play →</span></a></li>
            ))}
          </ul>
        </nav>
      )
    }
    <section class="panel game-faq" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">FAQ — {game.data.title}</h2>
      <dl>
        <dt>How do you play {game.data.title}?</dt><dd>{game.data.tagline} {game.data.description}</dd>
        <dt>Is it free without an account?</dt><dd>Yes, no account, localStorage only, no sync.</dd>
        <dt>What are the controls?</dt><dd>Check controls table above for pointer and keyboard options with visible focus.</dd>
        <dt>Where is progress saved?</dt><dd>localStorage keys like nocharge:game:*, see Privacy and My Arcade.</dd>
        <dt>Does it pause when tab hidden?</dt><dd>Yes, hidden adds pause reason and ambient stops, resumes unless manually paused.</dd>
        <dt>How to restart?</dt><dd>New game in toolbar or settings dialog resets board.</dd>
        <dt>Is it timed?</dt><dd>Check genre/session facts, some untimed or turn-based modes.</dd>
        <dt>How to mute and ambient?</dt><dd>Mute is master persistent, Sound on/off is effects only, volume updates ambient gain.</dd>
      </dl>
    </section>
  </GameShell>
</BaseLayout>


<style>
  .game-root {
    width: min(100%, 38rem);
    min-height: 12rem;
    margin-inline: auto;
  }

  /* Reserve a modest first-paint area without forcing a desktop board to be
     wider than a typical viewport. Once mounted, each game grows naturally
     to its real controls and playfield instead of being clipped by a rigid
     aspect-ratio box. */
  .game-root--reserved {
    min-height: clamp(22rem, 55vw, 38rem);
  }

  .game-root--reserved.is-game-mounted {
    min-height: 0;
  }

  /* A completed Memory Match run intentionally collapses to its clear,
     centered result panel instead of leaving an invisible board-sized gap. */
  .game-root--complete {
    min-height: 0;
  }

  .game-controls {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(18, 182, 106, 0.08), transparent 48%), var(--panel-2);
  }

  .game-controls h2,
  .game-related h2 {
    margin-top: 0.2rem;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .game-controls ul,
  .game-related ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game-controls li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }

  .game-controls strong {
    font-size: 0.84rem;
  }

  .game-controls span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .game-about {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-about__kicker {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-about h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-about__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .game-about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
  }

  .game-about__facts div {
    min-width: 8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--panel-2);
  }

  .game-about__facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .game-about__facts dd {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .game-about__guide {
    justify-self: start;
    min-height: 44px;
    padding-top: 0.7rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .game-articles {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-articles > div:first-child {
    display: grid;
    gap: 0.35rem;
    max-width: 42rem;
  }

  .game-articles h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-articles > div:first-child > p:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .game-articles__grid {
    display: grid;
    gap: 0.85rem;
  }

  .game-related {
    display: grid;
    gap: 0.9rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .game-related a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .game-controls,
    .game-related {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(20rem, 1.2fr);
    }
  }

  @media (min-width: 52rem) {
    .game-articles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .game-root {
      width: 100%;
    }
  }
</style>
