---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/GameShell.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  const guideIds = new Set<string>(guides.map((guide) => guide.data.game));
  return games.map((game) => ({
    params: { slug: game.id },
    props: {
      game,
      hasGuide: guideIds.has(game.id),
      relatedGames: games.filter((candidate) => candidate.id !== game.id).sort((a, b) => a.data.order - b.data.order),
      relatedArticles: articles
        .filter((article) => article.data.kind === 'game' && article.data.game === game.id)
        .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { game, hasGuide, relatedGames, relatedArticles } = Astro.props;
const { Content } = await render(game);
const slug = game.id;
const presentation = game.data.presentation;
const stageStyle = presentation?.stageAspectDesktop
  ? `--game-stage-aspect:${presentation.stageAspectDesktop};--game-stage-aspect-mobile:${presentation.stageAspectMobile ?? presentation.stageAspectDesktop}`
  : undefined;
---

<BaseLayout
  title={game.data.title}
  description={game.data.description}
  path={`/games/${game.id}/`}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
>
  <GameShell
    title={game.data.title}
    tagline={game.data.tagline}
    slug={game.id}
    accent={game.data.accent}
    artwork={game.data.artwork}
  >
    <div
      slot="game"
      data-game-root={slug}
      class:list={['game-root', { 'game-root--reserved': presentation?.stageAspectDesktop }]}
      style={stageStyle}
    ></div>
    {
      presentation?.controls.length && (
        <section class="game-controls" aria-labelledby="game-controls-heading">
          <div>
            <p class="game-about__kicker">Controls at a glance</p>
            <h2 id="game-controls-heading">{presentation.controlsHeading}</h2>
          </div>
          <ul>
            {presentation.controls.map((control) => (
              <li><strong>{control.label}</strong><span>{control.description}</span></li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="game-about" aria-labelledby="game-about-heading">
      <p class="game-about__kicker">About this game</p>
      <h2 id="game-about-heading">How {game.data.title} works</h2>
      <div class="game-about__copy">
        <Content />
      </div>
      <dl class="game-about__facts">
        <div><dt>Genre</dt><dd>{game.data.genre}</dd></div>
        <div><dt>Challenge</dt><dd>{game.data.difficulty}</dd></div>
        <div><dt>Typical run</dt><dd>{game.data.session}</dd></div>
      </dl>
      {
        hasGuide && (
          <a class="game-about__guide" href={`/guides/${slug}/`}>
            Read the complete {game.data.title} guide →
          </a>
        )
      }
    </section>
    {
      relatedArticles.length > 0 && (
        <section class="game-articles" aria-labelledby="game-articles-heading">
          <div>
            <p class="game-about__kicker">Player notes</p>
            <h2 id="game-articles-heading">More ways to read this game</h2>
            <p>Original articles about the systems and decisions inside {game.data.title}.</p>
          </div>
          <div class="game-articles__grid">
            {relatedArticles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                label={game.data.title}
                readTime={article.data.readTime}
                published={article.data.published}
                topics={article.data.topics}
                accent={game.data.accent}
              />
            ))}
          </div>
          <a class="game-about__guide" href="/articles/">Browse all game articles →</a>
        </section>
      )
    }
    {
      presentation?.relatedHeading && (
        <nav class="game-related" aria-labelledby="game-related-heading">
          <div>
            <p class="game-about__kicker">Continue exploring</p>
            <h2 id="game-related-heading">{presentation.relatedHeading}</h2>
          </div>
          <ul>
            {
              hasGuide && (
                <li>
                  <a href={`/guides/${slug}/`}>
                    <span>{presentation.relatedGuideLabel ?? `${game.data.title} guide`}</span>
                    <span aria-hidden="true">Guide →</span>
                  </a>
                </li>
              )
            }
            {relatedGames.slice(0, 2).map((item) => (
              <li><a href={`/games/${item.id}/`}><span>{item.data.title}</span><span aria-hidden="true">Play →</span></a></li>
            ))}
          </ul>
        </nav>
      )
    }
  </GameShell>
</BaseLayout>


<style>
  .game-root {
    width: min(100%, 38rem);
    min-height: 12rem;
    margin-inline: auto;
  }

  /* Reserve a modest first-paint area without forcing a desktop board to be
     wider than a typical viewport. Once mounted, each game grows naturally
     to its real controls and playfield instead of being clipped by a rigid
     aspect-ratio box. */
  .game-root--reserved {
    min-height: clamp(22rem, 55vw, 38rem);
  }

  .game-root--reserved.is-game-mounted {
    min-height: 0;
  }

  /* A completed Memory Match run intentionally collapses to its clear,
     centered result panel instead of leaving an invisible board-sized gap. */
  .game-root--complete {
    min-height: 0;
  }

  .game-controls {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(18, 182, 106, 0.08), transparent 48%), var(--panel-2);
  }

  .game-controls h2,
  .game-related h2 {
    margin-top: 0.2rem;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .game-controls ul,
  .game-related ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game-controls li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }

  .game-controls strong {
    font-size: 0.84rem;
  }

  .game-controls span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .game-about {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-about__kicker {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-about h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-about__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .game-about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
  }

  .game-about__facts div {
    min-width: 8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--panel-2);
  }

  .game-about__facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .game-about__facts dd {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .game-about__guide {
    justify-self: start;
    min-height: 44px;
    padding-top: 0.7rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .game-articles {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-articles > div:first-child {
    display: grid;
    gap: 0.35rem;
    max-width: 42rem;
  }

  .game-articles h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-articles > div:first-child > p:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .game-articles__grid {
    display: grid;
    gap: 0.85rem;
  }

  .game-related {
    display: grid;
    gap: 0.9rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .game-related a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .game-controls,
    .game-related {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(20rem, 1.2fr);
    }
  }

  @media (min-width: 52rem) {
    .game-articles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .game-root {
      width: 100%;
    }
  }
</style>
