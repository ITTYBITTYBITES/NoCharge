---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/GameShell.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FaqList from '../../components/FaqList.astro';
import { isPassPlayGameId } from '../../games/shared/pass-play';
import { allFacts, relatedGames as catalogRelated } from '../../lib/game-catalog';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  const guideIds = new Set<string>(guides.map((guide) => guide.data.game));
  const allFactsList = allFacts(games);
  return games.map((game) => {
    const facts = allFactsList.find((fact) => fact.slug === game.id)!;
    const relatedSlugs = new Set(catalogRelated(facts, allFactsList, 2).map((fact) => fact.slug));
    return {
      params: { slug: game.id },
      props: {
        game,
        hasGuide: guideIds.has(game.id),
        passPlay: isPassPlayGameId(game.id),
        relatedGames: games.filter((candidate) => relatedSlugs.has(candidate.id)),
        relatedArticles: articles
          .filter((article) => article.data.kind === 'game' && article.data.game === game.id)
          .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)),
      },
    };
  });
}

const { game, hasGuide, passPlay, relatedGames, relatedArticles } = Astro.props;
const { Content } = await render(game);
const slug = game.id;
const presentation = game.data.presentation;
const stageStyle = presentation?.stageAspectDesktop
  ? `--game-stage-aspect:${presentation.stageAspectDesktop};--game-stage-aspect-mobile:${presentation.stageAspectMobile ?? presentation.stageAspectDesktop}`
  : undefined;

const canonical = `https://nocharge.net/games/${game.id}/`;
const gameImages = game.data.artwork ? [
  `https://nocharge.net${game.data.artwork.coverSquare}`,
  `https://nocharge.net${game.data.artwork.coverLandscape}`,
  `https://nocharge.net${game.data.artwork.socialCard}`,
  `https://nocharge.net${game.data.artwork.coverSquareFallback}`,
  `https://nocharge.net/game-art/${game.id}/pin-1000x1500.jpg`,
] : [];


const controlSummary = presentation?.controls.length
  ? presentation.controls.map(({ label, description }) => `${label}: ${description}`).join(' ')
  : 'Use the controls described on this page and in the complete guide.';
const faqQuestions = [
  { q: `How do you play ${game.data.title}?`, a: `${game.data.tagline} ${game.data.description}` },
  { q: `Is ${game.data.title} free to play without an account?`, a: 'Yes. The game opens without an account, subscription, or cloud profile.' },
  { q: `What controls does ${game.data.title} support?`, a: controlSummary },
  { q: `Where does ${game.data.title} keep saved results?`, a: 'Any result or preference the game retains is stored in local storage in this browser. It does not synchronize between devices and can be removed with Clear game data.' },
  { q: `What happens if I switch tabs while playing ${game.data.title}?`, a: 'The shared game shell pauses while the page is hidden and stops ambient audio. Returning removes the hidden-page pause, but a manual pause remains in place.' },
  { q: `How do I restart ${game.data.title}?`, a: 'Use New game in the shared toolbar or settings panel. Restarting this game does not clear saved results from other games.' },
  { q: `Is ${game.data.title} timed?`, a: `The listed session is ${game.data.session}. Check the complete guide for mode-specific timing, scoring, and end conditions.` },
  { q: `How do sound and ambient controls work in ${game.data.title}?`, a: 'Master mute silences effects and ambient audio. Effects on/off changes game effects only, and the volume control also adjusts an active ambient texture.' },
];

const gameSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    '@id': `${canonical}#game`,
    name: game.data.title,
    description: game.data.description,
    url: canonical,
    image: gameImages,
    genre: game.data.genre,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web, Windows, macOS, Linux, Android, iOS',
    gamePlatform: 'Web Browser',
    playMode: passPlay ? 'MultiPlayer' : 'SinglePlayer',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    publisher: {
      '@type': 'Organization',
      name: 'NoCharge',
      url: 'https://nocharge.net/',
      logo: { '@type': 'ImageObject', url: 'https://nocharge.net/icons/icon-512.png', width: 512, height: 512 },
    },
    author: { '@type': 'Organization', name: 'NoCharge', url: 'https://nocharge.net/' },
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', '@id': 'https://nocharge.net/#website', name: 'NoCharge' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    '@id': `${canonical}#primaryimage`,
    contentUrl: `https://nocharge.net/game-art/${game.id}/pin-1000x1500.jpg`,
    url: `https://nocharge.net/game-art/${game.id}/pin-1000x1500.jpg`,
    caption: `${game.data.title} vertical game artwork`,
    representativeOfPage: true,
    width: 1000,
    height: 1500,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Arcade', item: 'https://nocharge.net/arcade/' },
      { '@type': 'ListItem', position: 3, name: game.data.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqQuestions.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<BaseLayout
  title={game.data.title}
  description={game.data.description}
  path={`/games/${game.id}/`}
  schema={gameSchema}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
  additionalImages={game.data.artwork ? [
    { url: game.data.artwork.coverSquare, width: 800, height: 800, alt: `${game.data.title} square cover` },
    { url: game.data.artwork.coverLandscape, width: 1280, height: 720, alt: `${game.data.title} landscape cover` },
    { url: `/game-art/${game.id}/pin-1000x1500.jpg`, width: 1000, height: 1500, alt: `Pinterest pin for ${game.data.title}` },
  ] : []}
>
  <GameShell
    title={game.data.title}
    tagline={game.data.tagline}
    slug={game.id}
    accent={game.data.accent}
    artwork={game.data.artwork}
    passPlay={passPlay}
  >
    <div
      slot="game"
      data-game-root={slug}
      class:list={['game-root', { 'game-root--reserved': presentation?.stageAspectDesktop }]}
      style={stageStyle}
    ></div>
    {
      presentation?.controls.length && (
        <section class="game-controls" id="controls" aria-labelledby="game-controls-heading">
          <div>
            <p class="game-about__kicker">Controls at a glance</p>
            <h2 id="game-controls-heading">{presentation.controlsHeading}</h2>
          </div>
          <ul>
            {presentation.controls.map((control) => (
              <li><strong>{control.label}</strong><span>{control.description}</span></li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="game-about" aria-labelledby="game-about-heading">
      <p class="game-about__kicker">About this game</p>
      <h2 id="game-about-heading">How {game.data.title} works</h2>
      <div class="game-about__copy">
        <Content />
      </div>
      <dl class="game-about__facts">
        <div><dt>Genre</dt><dd>{game.data.genre}</dd></div>
        <div><dt>Challenge</dt><dd>{game.data.difficulty}</dd></div>
        <div><dt>Typical run</dt><dd>{game.data.session}</dd></div>
      </dl>
      {
        hasGuide && (
          <a class="game-about__guide" href={`/guides/${slug}/`}>
            Read the complete {game.data.title} guide →
          </a>
        )
      }
    </section>
    {
      relatedArticles.length > 0 && (
        <section class="game-articles" aria-labelledby="game-articles-heading">
          <div>
            <p class="game-about__kicker">Player notes</p>
            <h2 id="game-articles-heading">More ways to read this game</h2>
            <p>Original articles about the systems and decisions inside {game.data.title}.</p>
          </div>
          <div class="game-articles__grid">
            {relatedArticles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                label={game.data.title}
                readTime={article.data.readTime}
                published={article.data.published}
                topics={article.data.topics}
                accent={game.data.accent}
              />
            ))}
          </div>
          <a class="game-about__guide" href="/articles/">Browse all game articles →</a>
        </section>
      )
    }
    {
      presentation?.relatedHeading && (
        <nav class="game-related" aria-labelledby="game-related-heading">
          <div>
            <p class="game-about__kicker">Continue exploring</p>
            <h2 id="game-related-heading">{presentation.relatedHeading}</h2>
          </div>
          <ul>
            {
              hasGuide && (
                <li>
                  <a href={`/guides/${slug}/`}>
                    <span>{presentation.relatedGuideLabel ?? `${game.data.title} guide`}</span>
                    <span aria-hidden="true">Guide →</span>
                  </a>
                </li>
              )
            }
            {relatedGames.slice(0, 2).map((item) => (
              <li><a href={`/games/${item.id}/`}><span>{item.data.title}</span><span aria-hidden="true">Play →</span></a></li>
            ))}
          </ul>
        </nav>
      )
    }
    <section class="panel game-faq" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently asked questions about {game.data.title}</h2>
      <FaqList items={faqQuestions} />
    </section>
  </GameShell>
</BaseLayout>


<style>
  .game-root {
    width: min(100%, 38rem);
    min-height: 12rem;
    margin-inline: auto;
  }

  /* Reserve a modest first-paint area without forcing a desktop board to be
     wider than a typical viewport. Once mounted, each game grows naturally
     to its real controls and playfield instead of being clipped by a rigid
     aspect-ratio box. */
  .game-root--reserved {
    min-height: clamp(22rem, 55vw, 38rem);
  }

  .game-root--reserved.is-game-mounted {
    min-height: 0;
  }

  /* A completed Memory Match run intentionally collapses to its clear,
     centered result panel instead of leaving an invisible board-sized gap. */
  .game-root--complete {
    min-height: 0;
  }

  .game-controls {
    display: grid;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(18, 182, 106, 0.08), transparent 48%), var(--panel-2);
  }

  .game-controls h2,
  .game-related h2 {
    margin-top: 0.2rem;
    font-size: 1.15rem;
    letter-spacing: -0.025em;
  }

  .game-controls ul,
  .game-related ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game-controls li {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }

  .game-controls strong {
    font-size: 0.84rem;
  }

  .game-controls span {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .game-about {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-about__kicker {
    color: var(--accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .game-about h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-about__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .game-about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
  }

  .game-about__facts div {
    min-width: 8rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--panel-2);
  }

  .game-about__facts dt {
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .game-about__facts dd {
    margin: 0.1rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .game-about__guide {
    justify-self: start;
    min-height: 44px;
    padding-top: 0.7rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .game-articles {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-articles > div:first-child {
    display: grid;
    gap: 0.35rem;
    max-width: 42rem;
  }

  .game-articles h2 {
    font-size: 1.3rem;
    letter-spacing: -0.025em;
  }

  .game-articles > div:first-child > p:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .game-articles__grid {
    display: grid;
    gap: 0.85rem;
  }

  .game-related {
    display: grid;
    gap: 0.9rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .game-related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .game-related a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .game-controls,
    .game-related {
      grid-template-columns: minmax(13rem, 0.8fr) minmax(20rem, 1.2fr);
    }
  }

  @media (min-width: 52rem) {
    .game-articles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .game-root {
      width: 100%;
    }
  }
</style>
