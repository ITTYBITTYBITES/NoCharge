---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameArtwork from '../../components/GameArtwork.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const gameById = new Map(games.map((game) => [game.id, game]));

  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide,
      game: gameById.get(guide.data.game),
      related: guides
        .filter((candidate) => candidate.id !== guide.id)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { guide, game, related } = Astro.props;
if (!game) throw new Error(`Guide ${guide.id} references an unknown game: ${guide.data.game}`);
const { Content } = await render(guide);
const updatedLabel = new Date(`${guide.data.updated}T12:00:00`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const canonical = `https://nocharge.net/guides/${guide.id}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated,
  datePublished: guide.data.updated,
  mainEntityOfPage: canonical,
  url: canonical,
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    name: 'NoCharge',
    url: 'https://nocharge.net/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'NoCharge',
    url: 'https://nocharge.net/',
  },
  ...(game.data.artwork ? { image: `https://nocharge.net${game.data.artwork.socialCard}` } : {}),
  about: {
    '@type': 'VideoGame',
    name: game.data.title,
    url: `https://nocharge.net/games/${game.id}/`,
  },
};
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}/`}
  schema={schema}
  ogType="article"
  modifiedTime={guide.data.updated}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
>
  <div class="guide-page">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Guides', href: '/guides/' },
        { label: game.data.title },
      ]}
    />

    <article>
      <header class:list={['guide-header', { 'guide-header--artwork': game.data.artwork }]}>
        <div class="guide-header__copy">
          <p class="eyebrow">{game.data.artwork ? game.data.title : `${game.data.emoji} ${game.data.title}`} guide</p>
          <h1 class="page-title">{guide.data.title}</h1>
          <p class="lede">{guide.data.description}</p>
          <div class="guide-header__meta">
            <span>Updated {updatedLabel}</span>
            <span aria-hidden="true">·</span>
            <span>{guide.data.readTime} min read</span>
          </div>
        </div>
        {
          game.data.artwork && (
            <GameArtwork
              class="guide-header__artwork"
              src={game.data.artwork.guideHeaderFallback}
              webpSrc={game.data.artwork.guideHeader}
              mobileSrc={game.data.artwork.coverSquareFallback}
              mobileWebpSrc={game.data.artwork.coverSquare}
              alt={game.data.artwork.alt}
              width={1280}
              height={640}
              variant="guide"
              accent={game.data.accent}
              priority
            />
          )
        }
      </header>

      <aside class="guide-play panel" aria-label={`Play ${game.data.title}`}>
        <div>
          {
            game.data.artwork ? (
              <img class="guide-play__icon" src={game.data.artwork.icon} width="44" height="44" alt="" aria-hidden="true" />
            ) : (
              <span aria-hidden="true">{game.data.emoji}</span>
            )
          }
          <div>
            <strong>Keep the game open while you read</strong>
            <p>{game.data.tagline} Scores stay on this device.</p>
          </div>
        </div>
        <a class="btn btn--sm" href={`/games/${game.id}/`}>Play {game.data.title}</a>
      </aside>

      {
        guide.id === 'memory-match' && (
          <figure class="guide-diagram">
            <img
              src="/game-art/memory-match/controls-diagram.svg"
              width="960"
              height="520"
              loading="lazy"
              decoding="async"
              alt="Choose one hidden card, compare it with a second card, then keep a match or remember both mismatch positions."
            />
            <figcaption>Each two-card attempt is one move. Matches remain visible; mismatches turn back over.</figcaption>
          </figure>
        )
      }

      <div class="guide-prose prose">
        <Content />
      </div>
    </article>

    <section class="guide-next panel" aria-labelledby="guide-next-heading">
      <div>
        <p class="section-kicker">Put it into practice</p>
        <h2 id="guide-next-heading">Ready for another run?</h2>
        <p>Open the game with the rules fresh, or continue through the guide library.</p>
      </div>
      <div class="guide-next__actions">
        <a class="btn" href={`/games/${game.id}/`}>Play now</a>
        <a class="btn btn--ghost" href="/guides/">All guides</a>
      </div>
    </section>

    <nav class="related-guides" aria-labelledby="related-guides-heading">
      <h2 id="related-guides-heading">More game guides</h2>
      <ul>
        {
          related.map((item) => (
            <li>
              <a href={`/guides/${item.id}/`}>
                <span>{item.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .guide-page {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .guide-header {
    padding: 0.75rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .guide-header--artwork {
    display: grid;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .guide-header :global(.guide-header__artwork) {
    min-width: 0;
  }

  .guide-header .page-title {
    max-width: 49rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
  }

  .guide-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .guide-play {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    margin: 1.5rem 0 2.25rem;
  }

  .guide-play > div {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .guide-play > div > span {
    font-size: 1.6rem;
  }

  .guide-play__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
  }

  .guide-play strong {
    display: block;
    font-size: 0.9rem;
  }

  .guide-play p {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .guide-diagram {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 2.25rem;
  }

  .guide-diagram img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #121412;
  }

  .guide-diagram figcaption {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .guide-prose {
    max-width: 46rem;
  }

  .guide-next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.1rem, 4vw, 1.75rem);
  }

  .guide-next > div:first-child {
    display: grid;
    gap: 0.4rem;
    max-width: 34rem;
  }

  .guide-next h2,
  .related-guides h2 {
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }

  .guide-next p:not(.section-kicker) {
    color: var(--muted);
  }

  .section-kicker {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guide-next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .related-guides {
    padding-bottom: 1rem;
  }

  .related-guides ul {
    display: grid;
    gap: 0;
    margin: 0.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .related-guides a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  .related-guides a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .guide-header--artwork {
      grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    }
  }

  @media (max-width: 32rem) {
    .guide-play .btn,
    .guide-next__actions,
    .guide-next__actions .btn {
      width: 100%;
    }
  }
</style>
