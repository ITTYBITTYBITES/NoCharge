---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameArtwork from '../../components/GameArtwork.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((game) => !game.data.draft);
  const guides = (await getCollection('guides')).filter((guide) => !guide.data.draft);
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  const gameById = new Map(games.map((game) => [game.id, game]));

  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide,
      game: gameById.get(guide.data.game),
      related: guides
        .filter((candidate) => candidate.id !== guide.id)
        .sort((a, b) => a.data.order - b.data.order),
      relatedArticles: articles
        .filter((article) => article.data.kind === 'game' && article.data.game === guide.data.game)
        .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { guide, game, related, relatedArticles } = Astro.props;
if (!game) throw new Error(`Guide ${guide.id} references an unknown game: ${guide.data.game}`);
const { Content } = await render(guide);
const artwork = game.data.artwork;
const presentation = game.data.presentation;
const secondaryDiagram = artwork?.scoringDiagram ?? artwork?.modesDiagram ?? artwork?.rulesDiagram;
const updatedLabel = new Date(`${guide.data.updated}T12:00:00`).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const canonical = `https://nocharge.net/guides/${guide.id}/`;
const guideImages = game.data.artwork ? [
  `https://nocharge.net${game.data.artwork.coverSquare}`,
  `https://nocharge.net${game.data.artwork.coverLandscape}`,
  `https://nocharge.net${game.data.artwork.socialCard}`,
] : [];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: `${guide.data.updated}T12:00:00Z`,
    dateModified: `${guide.data.updated}T12:00:00Z`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    url: canonical,
    image: guideImages.length ? guideImages : undefined,
    author: { '@type': 'Organization', name: 'NoCharge Editorial', url: 'https://nocharge.net/' },
    publisher: {
      '@type': 'Organization',
      name: 'NoCharge',
      url: 'https://nocharge.net/',
      logo: { '@type': 'ImageObject', url: 'https://nocharge.net/icons/icon-512.png', width: 512, height: 512 },
    },
    proficiencyLevel: 'Beginner',
    dependencies: game.data.title,
    articleSection: 'Game Guide',
    keywords: `${game.data.title}, ${game.data.genre}, ${game.data.difficulty}, browser game guide`,
    isAccessibleForFree: true,
    inLanguage: 'en',
    about: { '@type': 'VideoGame', '@id': `https://nocharge.net/games/${game.id}/#game`, name: game.data.title, url: `https://nocharge.net/games/${game.id}/` },
    isPartOf: { '@type': 'WebSite', '@id': 'https://nocharge.net/#website', name: 'NoCharge' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://nocharge.net/guides/' },
      { '@type': 'ListItem', position: 3, name: guide.data.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: `How do I play ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: `${guide.data.description} Open the game and use the documented controls. Check controls table for keyboard alternatives.` },
      },
      {
        '@type': 'Question',
        name: `Does ${game.data.title} need an account?`,
        acceptedAnswer: { '@type': 'Answer', text: 'No. All NoCharge games run locally without an account. Progress is saved in this browser only via localStorage.' },
      },
      {
        '@type': 'Question',
        name: `Can I play ${game.data.title} with keyboard?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Check the guide controls section. Many games document keyboard alternatives to pointer input, with visible focus outlines and 44px targets.' },
      },
      {
        '@type': 'Question',
        name: `Where is my progress saved for ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: 'In localStorage on this device, under keys like nocharge:game:* . No cloud sync, no encryption claim. Clearing browser storage removes it. See Privacy.' },
      },
      {
        '@type': 'Question',
        name: `Does ${game.data.title} pause when I switch tabs?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Yes, hidden tab adds a pause reason and shows pause overlay. Returning removes hidden reason unless manually paused. Ambient sound stops when hidden.' },
      },
      {
        '@type': 'Question',
        name: `How do I restart ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Use New game in shared toolbar or in Game settings dialog. It resets board, moves, and state without affecting other games or analytics consent.' },
      },
      {
        '@type': 'Question',
        name: `Is ${game.data.title} timed?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Check genre and session facts. Some games are untimed (Memory Match, Beacon Lattice) or have reduced-pressure turn-based modes (Color Flip). Guides document timing.' },
      },
      {
        '@type': 'Question',
        name: `How do I mute ${game.data.title}?`,
        acceptedAnswer: { '@type': 'Answer', text: 'Use Mute sound in toolbar for persistent master mute (effects+ambient) or Sound on/off for effects only. Volume slider is independent and updates ambient via Web Audio.' },
      },
    ],
  },
];
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  path={`/guides/${guide.id}/`}
  schema={schema}
  ogType="article"
  modifiedTime={guide.data.updated}
  socialImage={game.data.artwork?.socialCard}
  socialImageAlt={game.data.artwork ? `${game.data.title}: ${game.data.artwork.alt}` : undefined}
>
  <div class="guide-page">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Guides', href: '/guides/' },
        { label: game.data.title },
      ]}
    />

    <article>
      <header class:list={['guide-header', { 'guide-header--artwork': game.data.artwork }]}>
        <div class="guide-header__copy">
          <p class="eyebrow">{game.data.artwork ? game.data.title : `${game.data.emoji} ${game.data.title}`} guide</p>
          <h1 class="page-title">{guide.data.title}</h1>
          <p class="lede">{guide.data.description}</p>
          <div class="guide-header__meta">
            <span>Updated {updatedLabel}</span>
            <span aria-hidden="true">·</span>
            <span>{guide.data.readTime} min read</span>
          </div>
        </div>
        {
          game.data.artwork && (
            <GameArtwork
              class="guide-header__artwork"
              src={game.data.artwork.guideHeaderFallback}
              webpSrc={game.data.artwork.guideHeader}
              mobileSrc={game.data.artwork.coverSquareFallback}
              mobileWebpSrc={game.data.artwork.coverSquare}
              alt={game.data.artwork.alt}
              width={1280}
              height={640}
              variant="guide"
              mobileVariant="square"
              accent={game.data.accent}
              priority
            />
          )
        }
      </header>

      <aside class="guide-play panel" aria-label={`Play ${game.data.title}`}>
        <div>
          {
            game.data.artwork ? (
              <img class="guide-play__icon" src={game.data.artwork.icon} width="44" height="44" alt="" aria-hidden="true" />
            ) : (
              <span aria-hidden="true">{game.data.emoji}</span>
            )
          }
          <div>
            <strong>Keep the game open while you read</strong>
            <p>{game.data.tagline} Scores stay on this device.</p>
          </div>
        </div>
        <a class="btn btn--sm" href={`/games/${game.id}/`}>Play {game.data.title}</a>
      </aside>

      {
        artwork?.controlsDiagram && presentation?.controlsDiagramAlt && (
          <figure class="guide-diagram">
            <img
              src={artwork.controlsDiagram}
              width="960"
              height="520"
              loading="lazy"
              decoding="async"
              alt={presentation.controlsDiagramAlt}
            />
            {presentation.controlsDiagramCaption && <figcaption>{presentation.controlsDiagramCaption}</figcaption>}
          </figure>
        )
      }

      {
        secondaryDiagram && presentation?.secondaryDiagramAlt && (
          <figure class="guide-diagram">
            <img src={secondaryDiagram} width="960" height="520" loading="lazy" decoding="async" alt={presentation.secondaryDiagramAlt} />
            {presentation.secondaryDiagramCaption && <figcaption>{presentation.secondaryDiagramCaption}</figcaption>}
          </figure>
        )
      }

      {
        artwork?.screenshotDesktop && artwork.screenshotMobile && presentation?.gameplayPreviewAlt && (
          <figure class="gameplay-preview">
            <picture>
              <source media="(max-width: 36rem)" srcset={artwork.screenshotMobile} type="image/webp" />
              <source srcset={artwork.screenshotDesktop} type="image/webp" />
              <img
                src={artwork.screenshotDesktop}
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
                alt={presentation.gameplayPreviewAlt}
              />
            </picture>
            {presentation.gameplayPreviewCaption && <figcaption>{presentation.gameplayPreviewCaption}</figcaption>}
          </figure>
        )
      }

      <div class="guide-prose prose">
        <Content />
      </div>

      <section class="panel guide-faq" id="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">FAQ — {game.data.title}</h2>
        <dl>
          <dt>How do I play {game.data.title}?</dt><dd>{guide.data.description} Open the game and use documented controls.</dd>
          <dt>Does it need an account?</dt><dd>No, local-only via localStorage, no sync.</dd>
          <dt>Can I play with keyboard?</dt><dd>Check controls table, focus outlines visible, 44px targets.</dd>
          <dt>Where is progress saved?</dt><dd>localStorage keys like nocharge:game:*, see Privacy.</dd>
          <dt>Does it pause when tab hidden?</dt><dd>Yes, hidden adds pause reason, ambient stops, returns unless manually paused.</dd>
          <dt>How to restart?</dt><dd>New game in toolbar or settings dialog resets board.</dd>
          <dt>Is it timed?</dt><dd>Check genre/session facts, some untimed or turn-based modes.</dd>
          <dt>How to mute?</dt><dd>Mute is master persistent, Sound on/off is effects only, volume independent.</dd>
        </dl>
      </section>

      <script>
        for (const table of document.querySelectorAll('.guide-prose table')) {
          if (table.scrollWidth > table.clientWidth) {
            table.setAttribute('tabindex', '0');
            table.setAttribute('role', 'region');
            table.setAttribute('aria-label', 'Data table, scrollable');
          }
        }
      </script>
    </article>

    <section class="guide-next panel" aria-labelledby="guide-next-heading">
      <div>
        <p class="section-kicker">Put it into practice</p>
        <h2 id="guide-next-heading">Ready for another run?</h2>
        <p>Open the game with the rules fresh, or continue through the guide library.</p>
      </div>
      <div class="guide-next__actions">
        <a class="btn" href={`/games/${game.id}/`}>Play now</a>
        <a class="btn btn--ghost" href="/guides/">All guides</a>
      </div>
    </section>

    {
      relatedArticles.length > 0 && (
        <section class="guide-articles" aria-labelledby="guide-articles-heading">
          <div class="guide-articles__heading">
            <p class="section-kicker">Player notes</p>
            <h2 id="guide-articles-heading">Read more about {game.data.title}</h2>
            <p>Focused articles expand on one game behavior at a time.</p>
          </div>
          <div class="guide-articles__grid">
            {relatedArticles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                label={game.data.title}
                readTime={article.data.readTime}
                published={article.data.published}
                topics={article.data.topics}
                accent={game.data.accent}
              />
            ))}
          </div>
          <a class="guide-articles__all" href="/articles/">Browse all game articles →</a>
        </section>
      )
    }

    <nav class="related-guides" aria-labelledby="related-guides-heading">
      <h2 id="related-guides-heading">More game guides</h2>
      <ul>
        {
          related.map((item) => (
            <li>
              <a href={`/guides/${item.id}/`}>
                <span>{item.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .guide-page {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .guide-header {
    padding: 0.75rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .guide-header--artwork {
    display: grid;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .guide-header :global(.guide-header__artwork) {
    min-width: 0;
  }

  .guide-header .page-title {
    max-width: 49rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
  }

  .guide-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .guide-play {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    margin: 1.5rem 0 2.25rem;
  }

  .guide-play > div {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .guide-play > div > span {
    font-size: 1.6rem;
  }

  .guide-play__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
  }

  .guide-play strong {
    display: block;
    font-size: 0.9rem;
  }

  .guide-play p {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .guide-diagram,
  .gameplay-preview {
    display: grid;
    gap: 0.65rem;
    margin: 0 0 2.25rem;
  }

  .guide-diagram img,
  .gameplay-preview picture {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #121412;
  }

  .guide-diagram img {
    height: auto;
  }

  .gameplay-preview picture {
    display: block;
    aspect-ratio: 8 / 5;
  }

  .gameplay-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .guide-diagram figcaption,
  .gameplay-preview figcaption {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .guide-prose {
    max-width: 46rem;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .guide-page {
    min-width: 0;
  }

  .guide-prose :global(table) {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    table-layout: fixed;
  }

  .guide-prose :global(table:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .guide-prose :global(th),
  .guide-prose :global(td) {
    border: 1px solid var(--line);
    padding: 0.5rem 0.6rem;
    text-align: left;
    font-size: 0.84rem;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  @media (max-width: 30rem) {
    .guide-prose :global(th),
    .guide-prose :global(td) {
      min-width: 0;
      font-size: 0.78rem;
      padding: 0.4rem;
    }
  }

  .guide-prose :global(th) {
    background: var(--panel-2);
    color: var(--text);
    font-weight: 700;
  }

  .guide-prose :global(blockquote) {
    margin: 0;
    padding: 0.85rem 1rem;
    border-left: 4px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--panel-2));
    border-radius: 0.5rem;
    color: var(--text);
  }

  .guide-next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.1rem, 4vw, 1.75rem);
  }

  .guide-next > div:first-child {
    display: grid;
    gap: 0.4rem;
    max-width: 34rem;
  }

  .guide-next h2,
  .related-guides h2 {
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }

  .guide-next p:not(.section-kicker) {
    color: var(--muted);
  }

  .section-kicker {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guide-next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .guide-articles {
    display: grid;
    gap: 1rem;
  }

  .guide-articles__heading {
    display: grid;
    gap: 0.35rem;
    max-width: 42rem;
  }

  .guide-articles__heading p:not(.section-kicker) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .guide-articles__grid {
    display: grid;
    gap: 0.85rem;
  }

  .guide-articles__all {
    justify-self: start;
    min-height: 44px;
    padding-top: 0.5rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .guide-faq {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    margin-top: 1.5rem;
  }

  .guide-faq h2 { font-size: 1.25rem; }
  .guide-faq dl { display: grid; gap: 0.6rem; margin: 0; }
  .guide-faq dt { color: var(--text); font-weight: 700; margin-top: 0.5rem; }
  .guide-faq dd { color: var(--muted); margin: 0; }

  .related-guides {
    padding-bottom: 1rem;
  }

  .related-guides ul {
    display: grid;
    gap: 0;
    margin: 0.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .related-guides a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 160ms ease;
  }

  .related-guides a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 48rem) {
    .guide-header--artwork {
      grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    }
  }

  @media (min-width: 42rem) {
    .guide-articles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .gameplay-preview picture {
      aspect-ratio: 9 / 16;
    }
  }

  @media (max-width: 32rem) {
    .guide-play .btn,
    .guide-next__actions,
    .guide-next__actions .btn {
      width: 100%;
    }
  }
</style>
