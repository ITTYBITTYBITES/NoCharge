---
/**
 * Same-origin host document for a single Adsterra unit.
 *
 * WHY THIS EXISTS
 * These pages are loaded via `<iframe src="/ads/<id>/">` rather than
 * `srcdoc`. Two reasons:
 *
 * 1. `srcdoc` frames have the URL `about:srcdoc` and no referrer, so ad
 *    networks that validate the publisher domain often return no fill.
 *    A real URL on nocharge.net passes that check.
 * 2. Adsterra's invoke.js injects its creative with `document.write()`.
 *    Chrome on Android blocks document.write from parser-blocking
 *    cross-origin scripts on slow connections — but only in the top-level
 *    parser flow. Isolating each unit in its own tiny document sidesteps
 *    the intervention, which is the main reason units rendered on desktop
 *    but not on mobile.
 *
 * One unit per document also keeps the *global* `atOptions` object from
 * being clobbered when several units are on screen at once.
 */
import { AD_UNITS } from '../../config/ads';

export function getStaticPaths() {
  return AD_UNITS.map((unit) => ({
    params: { unit: unit.id },
    props: { unit },
  }));
}

const { unit } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; base-uri 'none'; object-src 'none'; script-src 'unsafe-inline' https:; style-src 'unsafe-inline'; img-src data: blob: https:; media-src https:; connect-src https:; frame-src https:; form-action https:; upgrade-insecure-requests"
    />
    <title>Advertisement</title>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: transparent;
      }

      body {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }

      /* Creatives are fixed-size; never let one overflow a narrow phone. */
      body iframe,
      body img {
        max-width: 100%;
        border: 0;
      }
    </style>
    <link rel="preconnect" href="https://www.highperformanceformat.com" crossorigin />
  </head>
  <body>
    <script is:inline set:html={`
      atOptions = {
        key: ${JSON.stringify(unit.key)},
        format: 'iframe',
        height: ${unit.height},
        width: ${unit.width},
        params: {}
      };
    `} />
    <script
      is:inline
      src={`https://www.highperformanceformat.com/${unit.key}/invoke.js`}
    ></script>

    <script is:inline>
      // Tell the parent frame whether a creative actually painted, so it can
      // reveal the Smartlink backfill instead of leaving dead space.
      (() => {
        const report = () => {
          const filled = !!document.querySelector('iframe, img, ins, a');
          try {
            // A sandboxed frame has an opaque origin, so the parent validates
            // this message by its source window rather than a target origin.
            parent.postMessage({ type: 'nocharge:ad', filled }, '*');
          } catch {
            /* parent gone; nothing to do */
          }
        };
        setTimeout(report, 2500);
        window.addEventListener('load', () => setTimeout(report, 1500));
      })();
    </script>
  </body>
</html>
