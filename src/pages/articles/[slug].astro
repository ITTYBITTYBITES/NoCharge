---
import { getCollection, render } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const games = (await getCollection('games')).filter((item) => !item.data.draft);
  const guides = (await getCollection('guides')).filter((item) => !item.data.draft);
  const articles = (await getCollection('articles')).filter((item) => !item.data.draft);
  const gameById = new Map(games.map((item) => [item.id, item]));
  const guideByGame = new Map(guides.map((item) => [item.data.game, item]));
  return articles.map((article) => {
    const game = article.data.kind === 'game' ? gameById.get(article.data.game) : undefined;
    return { params: { slug: article.id }, props: {
      article, game, guide: article.data.kind === 'game' ? guideByGame.get(article.data.game) : undefined,
      related: articles.filter((candidate) => candidate.id !== article.id && (
        article.data.kind === 'game' ? candidate.data.kind === 'game' && candidate.data.game === article.data.game : candidate.data.kind === 'platform'
      )).sort((a,b) => Number(b.data.featured)-Number(a.data.featured)||a.data.title.localeCompare(b.data.title)).slice(0,2),
    }};
  });
}
const { article, game, guide, related } = Astro.props;
if (article.data.kind === 'game' && (!game || !guide)) throw new Error(`Article ${article.id} references an unknown game or guide.`);
const { Content } = await render(article);
const dateLabel = (date:string) => new Date(`${date}T12:00:00`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
const canonical = `https://nocharge.net/articles/${article.id}/`;
const platformLabel = article.data.kind === 'platform' ? `Platform · ${article.data.category}` : game?.data.title ?? 'Game article';
const platformArt: Record<string, { webp: string; fallback: string; alt: string }> = { 'what-quiet-arcade-means-at-nocharge': { webp: '/editorial-art/quiet-arcade.webp', fallback: '/editorial-art/quiet-arcade.jpg', alt: 'Abstract arcade board with open paths and a softly lit tile.' }, 'how-nocharge-saves-scores-without-an-account': { webp: '/editorial-art/local-scores.webp', fallback: '/editorial-art/local-scores.jpg', alt: 'Layered paths and a single glowing tile contained within a dark board.' }, 'designing-browser-games-for-more-ways-to-play': { webp: '/editorial-art/more-ways.webp', fallback: '/editorial-art/more-ways.jpg', alt: 'A geometric game board approached by keyboard, pointer, and touch motifs.' }, 'how-nocharge-tests-browser-games': { webp: '/editorial-art/testing.webp', fallback: '/editorial-art/testing.jpg', alt: 'Abstract testing shapes, alignment guides, and a magnifying form.' } };
const platformImage = article.data.kind === 'platform' ? platformArt[article.id] : undefined;
const articleSchema: Record<string, unknown> = {
  '@context':'https://schema.org','@type':'Article',headline:article.data.title,description:article.data.description,
  datePublished:article.data.published,dateModified:article.data.updated,mainEntityOfPage:canonical,url:canonical,inLanguage:'en',
  author:{'@type':'Organization',name:article.data.author,url:'https://nocharge.net/'},
  reviewedBy:{'@type':'Organization',name:article.data.reviewer,url:'https://nocharge.net/'},
  publisher:{'@type':'Organization',name:'NoCharge',url:'https://nocharge.net/'},
  articleSection: article.data.kind === 'platform' ? article.data.category : article.data.topics,
  keywords:article.data.topics.join(', '),
};
if (game?.data.artwork) articleSchema.image=`https://nocharge.net${game.data.artwork.socialCardFallback??game.data.artwork.socialCard}`;
if (game) articleSchema.about={'@type':'VideoGame',name:game.data.title,url:`https://nocharge.net/games/${game.id}/`};
const schema=[articleSchema,{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:'https://nocharge.net/'},{'@type':'ListItem',position:2,name:'Articles',item:'https://nocharge.net/articles/'},{'@type':'ListItem',position:3,name:article.data.title,item:canonical},
]}];
---
<BaseLayout title={article.data.title} description={article.data.description} path={`/articles/${article.id}/`} schema={schema} ogType="article" modifiedTime={article.data.updated} socialImage={game?.data.artwork?.socialCardFallback??game?.data.artwork?.socialCard} socialImageAlt={game?.data.artwork?`${game.data.title}: ${game.data.artwork.alt}`:undefined}>
<div class="article-page">
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Articles',href:'/articles/'},{label:article.data.title}]} />
  <article>
    <header class="article-header">
      {game ? <a class="article-header__label" href={`/games/${game.id}/`}>{platformLabel}</a> : <span class="article-header__label">{platformLabel}</span>}
      <h1 class="page-title">{article.data.title}</h1><p class="lede">{article.data.description}</p>
      <div class="article-header__meta"><span>By {article.data.author}</span><span aria-hidden="true">·</span><span>Reviewed by {article.data.reviewer}</span><span aria-hidden="true">·</span><time datetime={article.data.published}>Published {dateLabel(article.data.published)}</time><span aria-hidden="true">·</span><time datetime={article.data.updated}>Updated {dateLabel(article.data.updated)}</time><span aria-hidden="true">·</span><span>{article.data.readTime} min read</span></div>
    </header>
    {platformImage && <picture class="article-editorial-art"><source srcset={platformImage.webp} type="image/webp" /><img src={platformImage.fallback} alt={platformImage.alt} width="1600" height="900" /></picture>}
    {game && guide && <aside class="article-play panel" aria-label={`Play ${game.data.title} or read its guide`}><div><strong>Try the detail in a live board.</strong><p>{game.data.tagline}</p></div><div class="article-actions"><a class="btn btn--sm" href={`/games/${game.id}/`}>Play {game.data.title}</a><a class="btn btn--ghost btn--sm" href={`/guides/${guide.id}/`}>Read the guide</a></div></aside>}
    {!game && <aside class="article-play panel" aria-label="Explore NoCharge platform information"><div><strong>Check the current platform.</strong><p>Use the public pages behind this explanation.</p></div><div class="article-actions"><a class="btn btn--sm" href="/arcade/">Open the Arcade</a><a class="btn btn--ghost btn--sm" href="/privacy/">Review Privacy</a><a class="btn btn--ghost btn--sm" href="/accessibility/">Accessibility</a></div></aside>}
    <div class="article-prose prose"><Content /></div>
  </article>
  <section class="article-cta panel" aria-labelledby="article-cta-heading"><div><p class="section-kicker">Next step</p><h2 id="article-cta-heading">{game?'Use the documented controls.':'Continue with the source pages.'}</h2><p>{game?`Open ${game.data.title}, or use its complete guide for the full rule set.`:'Browse the Arcade, guides, and trust pages to see the current implementation.'}</p></div><div class="article-actions">{game&&guide?<><a class="btn" href={`/games/${game.id}/`}>Play now</a><a class="btn btn--ghost" href={`/guides/${guide.id}/`}>Open guide</a></>:<><a class="btn" href="/about/">About NoCharge</a><a class="btn btn--ghost" href="/guides/">Browse guides</a></>}</div></section>
  <section class="article-related" aria-labelledby="article-related-heading"><div><p class="section-kicker">Keep reading</p><h2 id="article-related-heading">{game?`More ${game.data.title} notes`:'More platform explainers'}</h2></div><div class="article-related__grid">{related.map((item)=><ArticleCard slug={item.id} title={item.data.title} description={item.data.description} label={item.data.kind==='game'?(game?.data.title??'Game article'):`Platform · ${item.data.category}`} readTime={item.data.readTime} published={item.data.published} topics={item.data.topics} accent={game?.data.accent??'#2dd4bf'} />)}</div></section>
</div>
</BaseLayout>
<style>
.article-page{display:grid;gap:2rem;max-width:52rem;margin-inline:auto}.article-editorial-art{width:100%;aspect-ratio:16/9;overflow:hidden;border-radius:var(--radius);border:1px solid var(--line)}.article-editorial-art img{width:100%;height:100%;object-fit:cover}.article-header{padding:.75rem 0 1.5rem;border-bottom:1px solid var(--line)}.article-header__label{display:inline-flex;min-height:30px;margin-bottom:.75rem;color:var(--accent-strong);font-size:.78rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.article-header .page-title{max-width:50rem;font-size:clamp(2.2rem,6vw,4rem)}.article-header__meta{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:1rem;color:var(--muted);font-size:.8rem}.article-play,.article-cta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem 1.5rem;padding:1rem;margin:1.5rem 0 2.25rem}.article-play>div:first-child,.article-cta>div:first-child{display:grid;gap:.3rem}.article-play p,.article-cta p:not(.section-kicker){color:var(--muted);font-size:.88rem}.article-actions{display:flex;flex-wrap:wrap;gap:.55rem}.article-prose{max-width:46rem}.article-cta{padding:clamp(1.1rem,4vw,1.75rem);margin:0}.article-cta h2,.article-related h2{font-size:1.35rem;letter-spacing:-.025em}.section-kicker{color:var(--accent-strong);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.article-related{display:grid;gap:1rem;padding-bottom:1rem}.article-related>div:first-child{display:grid;gap:.35rem}.article-related__grid{display:grid;gap:.85rem}@media(min-width:42rem){.article-related__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:32rem){.article-actions,.article-actions .btn{width:100%}}
</style>
