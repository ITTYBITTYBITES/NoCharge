---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const games = (await getCollection('games')).filter((game) => !game.data.draft);
const gameById = new Map(games.map((game) => [game.id, game]));
const articles = (await getCollection('articles')).filter((article) => !article.data.draft)
  .sort((a, b) => b.data.published.localeCompare(a.data.published) || a.data.title.localeCompare(b.data.title));
const platformArticles = articles.filter((article) => article.data.kind === 'platform');
const gameArticles = articles.filter((article) => article.data.kind === 'game');
const platformArt: Record<string, { webp: string; fallback: string; alt: string }> = {
  'what-quiet-arcade-means-at-nocharge': { webp: '/editorial-art/quiet-arcade.webp', fallback: '/editorial-art/quiet-arcade.jpg', alt: 'Abstract arcade board with open paths and a softly lit tile.' },
  'how-nocharge-saves-scores-without-an-account': { webp: '/editorial-art/local-scores.webp', fallback: '/editorial-art/local-scores.jpg', alt: 'Layered paths and a single glowing tile contained within a dark board.' },
  'designing-browser-games-for-more-ways-to-play': { webp: '/editorial-art/more-ways.webp', fallback: '/editorial-art/more-ways.jpg', alt: 'A geometric game board approached by keyboard, pointer, and touch motifs.' },
  'how-nocharge-tests-browser-games': { webp: '/editorial-art/testing.webp', fallback: '/editorial-art/testing.jpg', alt: 'Abstract testing shapes, alignment guides, and a magnifying form.' },
};
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'NoCharge Articles',
  description: 'Platform explainers and original notes about the real rules, controls, and systems in NoCharge games.',
  url: 'https://nocharge.net/articles/',
  mainEntity: { '@type': 'ItemList', numberOfItems: articles.length, itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem', position: index + 1, name: article.data.title, url: `https://nocharge.net/articles/${article.id}/`,
  })) },
};

---
<BaseLayout title="Articles" description="NoCharge platform explainers and original articles about current game rules, scoring, controls, accessibility, privacy, and testing." path="/articles/" schema={schema}>
  <div class="articles-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Articles' }]} />
    <header class="articles-hero">
      <p class="eyebrow">Documented, not inflated</p>
      <h1 class="page-title">Useful reads about the arcade and its games.</h1>
      <p class="lede">Platform explainers cover how NoCharge handles trust, privacy, accessibility, and testing. Game notes stay tied to the rules and controls they describe.</p>
    </header>
    <section aria-labelledby="platform-articles-heading">
      <div class="articles-heading"><div><p class="section-kicker">Across NoCharge</p><h2 id="platform-articles-heading">Platform articles</h2><p>Evergreen explanations with no fake game association.</p></div></div>
      <div class="articles-grid">{platformArticles.map((article) => <ArticleCard slug={article.id} title={article.data.title} description={article.data.description} label={`Platform · ${article.data.kind === 'platform' ? article.data.category : ''}`} readTime={article.data.readTime} published={article.data.published} topics={article.data.topics} accent="#2dd4bf" image={platformArt[article.id]} />)}</div>
    </section>
    <section aria-labelledby="game-articles-heading">
      <div class="articles-heading"><div><p class="section-kicker">Inside the games</p><h2 id="game-articles-heading">Game articles</h2><p>Focused notes checked against current game behavior.</p></div><a class="section-link" href="/guides/">Read the definitive guides →</a></div>
      <div class="articles-grid">{gameArticles.map((article) => { const game = article.data.kind === 'game' ? gameById.get(article.data.game) : undefined; return <ArticleCard slug={article.id} title={article.data.title} description={article.data.description} label={game?.data.title ?? 'Game article'} readTime={article.data.readTime} published={article.data.published} topics={article.data.topics} accent={game?.data.accent ?? '#12b66a'} />; })}</div>
    </section>
    <section class="articles-note panel" aria-labelledby="articles-note-heading"><div><p class="section-kicker">Editorial method</p><h2 id="articles-note-heading">Claims follow the current product.</h2></div><p>Articles use original examples, honest review dates, and links to the relevant runtime or platform pages. They do not promise performance, health, or educational benefits.</p></section>
  </div>
</BaseLayout>
<style>
.articles-page{display:grid;gap:clamp(2.5rem,7vw,5rem)}.articles-hero{max-width:54rem;padding-top:1rem}.articles-heading{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem 2rem;margin-bottom:1.25rem}.articles-heading>div{display:grid;gap:.4rem;max-width:45rem}.articles-heading h2,.articles-note h2{font-size:clamp(1.65rem,4vw,2.4rem);letter-spacing:-.035em;line-height:1.1}.articles-heading p:last-child,.articles-note>p{color:var(--muted)}.section-kicker{color:var(--accent-strong);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.section-link{min-height:44px;color:var(--accent-strong);font-size:.9rem;font-weight:700}.articles-grid{display:grid;gap:.85rem}.articles-note{display:grid;gap:1rem 2rem;padding:clamp(1.2rem,4vw,2rem)}.articles-note>div{display:grid;gap:.4rem}@media(min-width:48rem){.articles-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.articles-note{grid-template-columns:minmax(16rem,.8fr) minmax(20rem,1.2fr);align-items:start}}
</style>
