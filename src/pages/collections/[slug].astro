---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameCard from '../../components/GameCard.astro';
import { validateCuratedCollection } from '../../lib/collection-validation';
export async function getStaticPaths(){const collections=(await getCollection('collections')).filter(c=>!c.data.draft);const games=(await getCollection('games')).filter(g=>!g.data.draft);const byId=new Map(games.map(g=>[g.id,g]));return collections.map(collection=>({params:{slug:collection.id},props:{collection,members:collection.data.games.map(member=>({member,game:byId.get(member.game)}))}}));}
const {collection,members}=Astro.props;const collectionErrors=validateCuratedCollection(collection.data,new Set(members.filter(({game})=>game).map(({game})=>game!.id)));if(collectionErrors.length||members.some(({game})=>!game))throw new Error(`Invalid collection ${collection.id}: ${collectionErrors.join(' ')}`);const publishedMembers=members.map(({member,game})=>({member,game:game!}));const {Content}=await render(collection);const canonical=`https://nocharge.net/collections/${collection.id}/`;const schema=[{'@context':'https://schema.org','@type':'CollectionPage',name:collection.data.title,description:collection.data.description,url:canonical,dateModified:collection.data.reviewed,mainEntity:{'@type':'ItemList',numberOfItems:publishedMembers.length,itemListElement:publishedMembers.map(({game},i)=>({'@type':'ListItem',position:i+1,name:game.data.title,url:`https://nocharge.net/games/${game.id}/`}))}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://nocharge.net/'},{'@type':'ListItem',position:2,name:'Collections',item:'https://nocharge.net/collections/'},{'@type':'ListItem',position:3,name:collection.data.title,item:canonical}]}];
---
<BaseLayout title={collection.data.title} description={collection.data.description} path={`/collections/${collection.id}/`} schema={schema}>
<div class="collection-page"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Collections',href:'/collections/'},{label:collection.data.title}]}/><header><p class="eyebrow">Reviewed collection</p><h1 class="page-title">{collection.data.title}</h1><p class="lede">{collection.data.description}</p><p class="reviewed">Reviewed <time datetime={collection.data.reviewed}>{collection.data.reviewed}</time></p></header><section class="method panel" aria-labelledby="method-heading"><h2 id="method-heading">Inclusion method</h2><p>{collection.data.inclusionMethod}</p></section><div class="prose"><Content/></div><section aria-labelledby="included-heading"><h2 id="included-heading">Why each game is included</h2><div class="members">{publishedMembers.map(({member,game})=><article><GameCard slug={game.id} title={game.data.title} tagline={game.data.tagline} emoji={game.data.emoji} accent={game.data.accent} artwork={game.data.artwork} genre={game.data.genre} session={game.data.session}/><p>{member.reason}</p></article>)}</div></section><p class="back"><a href="/collections/">Browse all collections →</a></p></div>
</BaseLayout>
<style>.collection-page{display:grid;gap:2rem;max-width:58rem;margin-inline:auto}header{max-width:52rem}.reviewed{margin-top:.8rem;color:var(--muted);font-size:.82rem}.method{display:grid;gap:.5rem;padding:1.1rem}.method h2,#included-heading{font-size:1.35rem}.method p,.members article>p{color:var(--muted)}.members{display:grid;gap:1rem;margin-top:1rem}.members article{display:grid;gap:.65rem}.members article>p{padding:0 .4rem;font-size:.9rem}.back a{color:var(--accent-strong);font-weight:700}@media(min-width:52rem){.members{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
