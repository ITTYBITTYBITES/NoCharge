---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const collections=(await getCollection('collections')).filter(c=>!c.data.draft).sort((a,b)=>a.data.order-b.data.order);
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'NoCharge game collections',description:'Small, reviewed collections of current NoCharge browser games with explicit inclusion methods.',url:'https://nocharge.net/collections/',mainEntity:{'@type':'ItemList',numberOfItems:collections.length,itemListElement:collections.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.data.title,url:`https://nocharge.net/collections/${c.id}/`}))}};
---
<BaseLayout title="Game Collections" description="Reviewed NoCharge game collections with explicit keyboard, timing, account, and session-length inclusion methods." path="/collections/" schema={schema}>
<div class="collections-page"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Collections'}]}/><header><p class="eyebrow">Small library, specific reasons</p><h1 class="page-title">Curated game collections.</h1><p class="lede">Each collection states its method, includes at least three current games, and explains every inclusion. These are not rankings.</p></header><div class="collection-grid">{collections.map(c=><article class="panel"><p>{c.data.games.length} games · Reviewed <time datetime={c.data.reviewed}>{c.data.reviewed}</time></p><h2><a href={`/collections/${c.id}/`}>{c.data.title}</a></h2><p>{c.data.description}</p><strong>Inclusion method</strong><p>{c.data.inclusionMethod}</p></article>)}</div></div>
</BaseLayout>
<style>.collections-page{display:grid;gap:clamp(2rem,6vw,4rem)}header{max-width:54rem}.collection-grid{display:grid;gap:1rem}.collection-grid article{display:grid;gap:.65rem;padding:1.2rem}.collection-grid article>p{color:var(--muted)}.collection-grid article>p:first-child{font-size:.78rem}.collection-grid h2{font-size:1.3rem}.collection-grid h2 a{color:var(--accent-strong)}.collection-grid strong{margin-top:.3rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.07em}@media(min-width:48rem){.collection-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
