---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SetupArtwork from '../../components/setup/SetupArtwork.astro';
import SetupArticleCard from '../../components/setup/SetupArticleCard.astro';
import { AMAZON_REQUIRED_STATEMENT } from '../../config/affiliate';
import {
  SETUP_TOPIC_DESCRIPTIONS,
  SETUP_TOPIC_IDS,
  SETUP_TOPIC_LABELS,
  countByPrimaryTopic,
  formatGuideCount,
} from '../../lib/setup-topics';

const articles = (await getCollection('setup'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishedDate.localeCompare(a.data.publishedDate) || a.data.title.localeCompare(b.data.title));

// Counted once per article, by its single primary topic. See src/lib/setup-topics.ts.
const primaryCounts = countByPrimaryTopic(articles.map((a) => a.data));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Quiet Setup',
    description:
      'Practical editorial guides for simple controls, displays, stands, desk accessories, and offline puzzles.',
    url: 'https://nocharge.net/setup/',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: a.data.title,
        url: `https://nocharge.net/setup/${a.id}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Quiet Setup', item: 'https://nocharge.net/setup/' },
    ],
  },
];
---

<BaseLayout
  title="Quiet Setup"
  description="Practical guides for choosing simple controls, displays, stands, desk accessories, and offline puzzles—without assuming a purchase is necessary."
  path="/setup/"
  schema={schema}
  showAds={false}
  feedHref="/setup/feed.xml"
  socialImage="/setup-art/hero-1200.jpg"
  socialImageAlt="Abstract Quiet Setup desk illustration"
  socialImageWidth={1200}
  socialImageHeight={675}
>
  <div class="setup-index">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Quiet Setup' }]} />

    <header class="setup-hero">
      <div class="setup-hero__text">
        <p class="eyebrow">First-party practical editorial</p>
        <h1 class="page-title">Quiet Setup</h1>
        <p class="lede">
          Practical guides for choosing simple controls, displays, stands, desk accessories, and offline
          puzzles—without assuming that buying something new is necessary.
        </p>
        <div class="setup-actions">
          <a class="btn" href="#latest">Read the latest guides</a>
          <a class="btn btn--ghost" href="/setup/feed.xml">RSS feed</a>
        </div>
      </div>
      <div class="setup-hero__art">
        <SetupArtwork
          name="hero"
          eager
          sizes="(max-width: 52rem) min(calc(100vw - 2rem), 24rem), 42vw"
        />
      </div>
    </header>

    <aside class="setup-disclosure" aria-label="Quiet Setup affiliate disclosure">
      <p>
        <strong>Affiliate disclosure:</strong> Some Quiet Setup articles contain clearly marked Amazon affiliate
        links. If you make a qualifying purchase through one, NoCharge may earn a commission. No purchase is
        needed to use NoCharge.
      </p>
      <p><strong>{AMAZON_REQUIRED_STATEMENT}</strong></p>
    </aside>

    <section aria-labelledby="topics-heading">
      <div class="section-heading">
        <p class="section-kicker">Browse the questions</p>
        <h2 id="topics-heading">Editorial topics</h2>
      </div>
      <ul class="topic-grid">
        {
          SETUP_TOPIC_IDS.map((id) => (
            <li data-setup-topic-card={id}>
              <h3>{SETUP_TOPIC_LABELS[id]}</h3>
              <p>{SETUP_TOPIC_DESCRIPTIONS[id]}</p>
              <p class="topic-grid__count" data-setup-topic-count={id}>{formatGuideCount(primaryCounts[id])}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <p class="section-kicker">Newest first</p>
        <h2 id="latest-heading">Latest setup guides</h2>
        <p>Each card shows publication and review dates, evidence level, and whether the article contains paid links.</p>
      </div>
      <div class="feed-grid">{articles.map((a) => <SetupArticleCard slug={a.id} {...a.data} />)}</div>
    </section>

    <section class="method panel" aria-labelledby="setup-tools-heading">
      <div>
        <p class="section-kicker">With NoCharge</p>
        <h2 id="setup-tools-heading">Every topic pairs with a tool and games.</h2>
      </div>
      <div class="setup-pairs">
        <table>
          <thead><tr><th>Topic</th><th>Tool</th><th>Games to try</th></tr></thead>
          <tbody>
            <tr><td>Keyboards</td><td><a href="/tools/focus-order-demo/">Focus order demo</a></td><td><a href="/games/minesweeper/">Minesweeper</a> · <a href="/games/nonogram/">Nonogram</a> · <a href="/games/beacon-lattice/">Beacon Lattice</a></td></tr>
            <tr><td>Pointing devices</td><td><a href="/tools/touch-target-checker/">Touch target checker</a></td><td><a href="/games/memory-match/">Memory Match</a> · <a href="/games/word-search/">Word Search</a> · <a href="/games/klondike/">Klondike</a></td></tr>
            <tr><td>Screens &amp; stands</td><td><a href="/tools/zoom-visualizer/">Zoom Visualizer</a></td><td><a href="/games/sudoku-9x9/">Sudoku 9×9</a> · <a href="/games/word-tile-rush/">Word Tile Rush</a> · <a href="/games/color-flip/">Color Flip</a></td></tr>
            <tr><td>Desk &amp; comfort</td><td><a href="/tools/contrast-checker/">Contrast checker</a></td><td><a href="/games/freecell/">FreeCell</a> · <a href="/games/twenty-forty-eight/">Twenty Forty-Eight</a> · <a href="/games/tile-garden/">Tile Garden</a></td></tr>
            <tr><td>Offline puzzles</td><td><a href="/tools/nonogram-clue-calculator/">Nonogram calculator</a></td><td><a href="/games/beacon-lattice/">Beacon Lattice</a> · <a href="/games/lights-out/">Lights Out</a> · <a href="/games/nonogram/">Nonogram</a></td></tr>
            <tr><td>Audio</td><td><a href="/tools/ambient-mixer/">Ambient Mixer</a></td><td><a href="/games/simon/">Simon</a> · <a href="/games/memory-match/">Memory Match</a> · <a href="/games/hangman/">Hangman</a></td></tr>
            <tr><td>Lighting</td><td><a href="/tools/contrast-checker/">Contrast checker</a> · <a href="/tools/reduced-motion-tester/">Reduced-motion tester</a></td><td><a href="/games/word-search/">Word Search</a> · <a href="/games/mini-sudoku/">Mini Sudoku</a></td></tr>
          </tbody>
        </table>
        <p>These pairings are editorial starting points, not claims that a purchase improves play. Every tool runs in the browser; every game is playable with what you already have.</p>
      </div>
    </section>

    <section class="method panel" aria-labelledby="method-heading">
      <div>
        <p class="section-kicker">How recommendations are researched</p>
        <h2 id="method-heading">Start with the task, then state the limits.</h2>
      </div>
      <div>
        <p>
          Launch articles use editorial research, compare practical criteria, name alternatives, and explain what
          NoCharge did not evaluate. Existing equipment is always considered before a purchase link.
        </p>
        <p>
          Paid links are manually authored, visibly labeled, and never placed in gameplay. Read the full
          <a href="/advertising/">Advertising policy</a> or subscribe to the
          <a href="/setup/feed.xml">Quiet Setup RSS feed</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .setup-index {
    display: grid;
    gap: clamp(2.25rem, 6vw, 4.5rem);
  }

  /* Mobile hero: the previous version filled roughly 82% of a 390x844 first
     viewport before any guide content appeared. The artwork is now capped at
     24rem and centred, spacing is tighter, and the affiliate disclosure and
     the first section heading are reachable within the first screen. */
  .setup-hero {
    display: grid;
    gap: 1.15rem;
    align-items: center;
  }

  .setup-hero__text {
    display: grid;
    gap: 0.85rem;
  }

  .setup-hero__art {
    display: grid;
    justify-items: center;
  }

  .setup-hero__art :global(.setup-artwork) {
    width: 100%;
    max-width: 24rem;
  }

  .setup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .setup-disclosure {
    display: grid;
    gap: 0.45rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid rgba(201, 139, 44, 0.55);
    border-left: 4px solid #c98b2c;
    border-radius: var(--radius);
    background: #221f1a;
    color: #f2e6cd;
    overflow-wrap: break-word;
  }

  .setup-disclosure p {
    margin: 0;
    line-height: 1.6;
  }

  .setup-disclosure strong {
    color: #ffdda6;
  }

  .section-heading {
    display: grid;
    gap: 0.4rem;
    max-width: 48rem;
    margin-bottom: 1.2rem;
  }

  .section-heading h2,
  .method h2 {
    font-size: clamp(1.6rem, 4vw, 2.35rem);
    line-height: 1.15;
  }

  .section-heading > p:last-child,
  .method p,
  .topic-grid p {
    color: var(--muted);
  }

  .section-kicker {
    color: #88d4cb !important;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* auto-fit with a real minimum: five fixed columns became unreadable
     ~9rem slivers on a 1024px screen and at 200% zoom. */
  .topic-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topic-grid li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .topic-grid h3 {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .topic-grid__count {
    margin-top: 0.35rem;
    font-size: 0.8rem;
  }

  .feed-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .method {
    display: grid;
    gap: 1.2rem 2rem;
    padding: clamp(1.2rem, 4vw, 2rem);
  }

  .method > div {
    display: grid;
    gap: 0.65rem;
  }

  .setup-pairs {
    min-width: 0;
  }

  .setup-pairs table {
    width: 100%;
    display: block;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-collapse: collapse;
    font-size: 0.84rem;
  }

  .setup-pairs th,
  .setup-pairs td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .setup-pairs a {
    color: var(--accent-strong);
  }

  .setup-pairs p {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .method a {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  @media (min-width: 52rem) {
    .setup-hero {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      padding-top: 0.75rem;
    }

    .setup-hero__art :global(.setup-artwork) {
      max-width: none;
    }

    .method {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
