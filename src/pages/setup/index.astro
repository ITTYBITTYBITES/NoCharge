---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import SetupArtwork from '../../components/setup/SetupArtwork.astro';import SetupArticleCard from '../../components/setup/SetupArticleCard.astro';import { AMAZON_REQUIRED_STATEMENT } from '../../config/affiliate';
const articles=(await getCollection('setup')).filter(a=>!a.data.draft).sort((a,b)=>b.data.publishedDate.localeCompare(a.data.publishedDate)||a.data.title.localeCompare(b.data.title));
const topics=[['keyboards','Keyboards','Layouts, key feel, and sound sources.'],['pointing-devices','Pointing devices','Mouse, trackpad, trackball, and touch tradeoffs.'],['screens-and-stands','Screens and stands','Zoom, orientation, stability, and screen placement.'],['desk-and-comfort','Desk and comfort','Practical, low-noise choices without guarantees.'],['offline-puzzles','Offline puzzles','Paper formats, progression, print, and answer keys.']] as const;
const schema=[{'@context':'https://schema.org','@type':'CollectionPage',name:'Quiet Setup',description:'Practical editorial guides for simple controls, displays, stands, desk accessories, and offline puzzles.',url:'https://nocharge.net/setup/',mainEntity:{'@type':'ItemList',numberOfItems:articles.length,itemListElement:articles.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.data.title,url:`https://nocharge.net/setup/${a.id}/`}))}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://nocharge.net/'},{'@type':'ListItem',position:2,name:'Quiet Setup',item:'https://nocharge.net/setup/'}]}];
---
<BaseLayout title="Quiet Setup" description="Practical guides for choosing simple controls, displays, stands, desk accessories, and offline puzzles—without assuming a purchase is necessary." path="/setup/" schema={schema} showAds={false} feedHref="/setup/feed.xml" socialImage="/setup-art/hero-1200.jpg" socialImageAlt="Abstract Quiet Setup desk illustration">
<div class="setup-index">
 <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Quiet Setup'}]}/>
 <header class="setup-hero"><div><p class="eyebrow">First-party practical editorial</p><h1 class="page-title">Quiet Setup</h1><p class="lede">Practical guides for choosing simple controls, displays, stands, desk accessories, and offline puzzles—without assuming that buying something new is necessary.</p><div class="setup-actions"><a class="btn" href="#latest">Read the latest guides</a><a class="btn btn--ghost" href="/setup/feed.xml">RSS feed</a></div></div><SetupArtwork name="hero" eager sizes="(max-width: 52rem) calc(100vw - 2rem), 42vw" /></header>
 <aside class="setup-disclosure" aria-label="Quiet Setup affiliate disclosure"><p><strong>Affiliate disclosure:</strong> Some Quiet Setup articles contain clearly marked Amazon affiliate links. If you make a qualifying purchase through one, NoCharge may earn a commission. No purchase is needed to use NoCharge.</p><p><strong>{AMAZON_REQUIRED_STATEMENT}</strong></p></aside>
 <section aria-labelledby="topics-heading"><div class="section-heading"><p class="section-kicker">Browse the questions</p><h2 id="topics-heading">Editorial topics</h2></div><div class="topic-grid">{topics.map(([id,label,description])=><article><h3>{label}</h3><p>{description}</p><p>{articles.filter(a=>a.data.topics.includes(id)).length} launch guides in the feed</p></article>)}</div></section>
 <section id="latest" aria-labelledby="latest-heading"><div class="section-heading"><p class="section-kicker">Newest first</p><h2 id="latest-heading">Latest setup guides</h2><p>Each card shows publication and review dates, evidence level, and whether the article contains paid links.</p></div><div class="feed-grid">{articles.map(a=><SetupArticleCard slug={a.id} {...a.data}/>)}</div></section>
 <section class="method panel" aria-labelledby="method-heading"><div><p class="section-kicker">How recommendations are researched</p><h2 id="method-heading">Start with the task, then state the limits.</h2></div><div><p>Launch articles use editorial research, compare practical criteria, name alternatives, and explain what NoCharge did not evaluate. Existing equipment is always considered before a purchase link.</p><p>Paid links are manually authored, visibly labeled, and never placed in gameplay. Read the full <a href="/advertising/">Advertising policy</a> or subscribe to the <a href="/setup/feed.xml">Quiet Setup RSS feed</a>.</p></div></section>
</div>
</BaseLayout>
<style>
.setup-index{display:grid;gap:clamp(2.5rem,7vw,5rem)}.setup-hero{display:grid;gap:1.5rem;align-items:center;padding-top:1rem}.setup-hero>div{display:grid;gap:1rem}.setup-actions{display:flex;flex-wrap:wrap;gap:.6rem}.setup-disclosure{display:grid;gap:.45rem;padding:1rem 1.15rem;border:2px solid #b7791f;border-radius:var(--radius);background:#2a2419;color:#fff4d6}.setup-disclosure p{margin:0}.section-heading{display:grid;gap:.4rem;max-width:48rem;margin-bottom:1.2rem}.section-heading h2,.method h2{font-size:clamp(1.6rem,4vw,2.35rem);line-height:1.1}.section-heading>p:last-child,.method p,.topic-grid p{color:var(--muted)}.section-kicker{color:#88d4cb!important;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.topic-grid,.feed-grid{display:grid;gap:.85rem}.topic-grid article{padding:1rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel)}.topic-grid h3{margin-bottom:.4rem}.topic-grid p:last-child{margin-top:.6rem;font-size:.78rem}.method{display:grid;gap:1.2rem 2rem;padding:clamp(1.2rem,4vw,2rem)}.method>div{display:grid;gap:.65rem}.method a{color:var(--accent-strong);text-decoration:underline}@media(min-width:52rem){.setup-hero{grid-template-columns:1fr 1fr}.topic-grid{grid-template-columns:repeat(5,1fr)}.feed-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.method{grid-template-columns:.85fr 1.15fr}}
</style>
