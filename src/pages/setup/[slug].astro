---
import { getCollection, render } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';import SetupArtwork from '../../components/setup/SetupArtwork.astro';import EvidenceLabel from '../../components/setup/EvidenceLabel.astro';import AffiliateDisclosure from '../../components/setup/AffiliateDisclosure.astro';import PaidAmazonLink from '../../components/setup/PaidAmazonLink.astro';
export async function getStaticPaths(){const entries=(await getCollection('setup')).filter(a=>!a.data.draft);return entries.map(article=>({params:{slug:article.id},props:{article}}));}
const {article}=Astro.props;const {Content}=await render(article);const path=`/setup/${article.id}/`;const canonical=`https://nocharge.net${path}`;const fmt=(d:string)=>new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});const topicLabels:Record<string,string>={keyboards:'Keyboards','pointing-devices':'Pointing devices','screens-and-stands':'Screens and stands','desk-and-comfort':'Desk and comfort','offline-puzzles':'Offline puzzles'};
const schema=[{'@context':'https://schema.org','@type':'Article',headline:article.data.title,description:article.data.description,datePublished:article.data.publishedDate,dateModified:article.data.reviewedDate,mainEntityOfPage:canonical,url:canonical,image:`https://nocharge.net/setup-art/${article.data.artwork}-1600.jpg`,author:{'@type':'Organization',name:'NoCharge Editorial'},publisher:{'@type':'Organization',name:'NoCharge',url:'https://nocharge.net/'},articleSection:topicLabels[article.data.topic],keywords:article.data.topics.map(t=>topicLabels[t]).join(', '),inLanguage:'en'},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://nocharge.net/'},{'@type':'ListItem',position:2,name:'Quiet Setup',item:'https://nocharge.net/setup/'},{'@type':'ListItem',position:3,name:article.data.title,item:canonical}]}];
---
<BaseLayout title={article.data.title} description={article.data.description} path={path} schema={schema} ogType="article" modifiedTime={article.data.reviewedDate} showAds={false} socialImage={`/setup-art/${article.data.artwork}-1200.jpg`} socialImageAlt="Abstract Quiet Setup editorial illustration">
<article class="setup-article" data-setup-article data-has-affiliate-links={String(article.data.hasAffiliateLinks)}>
 <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Quiet Setup',href:'/setup/'},{label:article.data.title}]}/>
 <header><p class="eyebrow">Quiet Setup · {topicLabels[article.data.topic]}</p><h1 class="page-title">{article.data.title}</h1><p class="lede">{article.data.description}</p><div class="article-meta"><span>Published <time datetime={article.data.publishedDate}>{fmt(article.data.publishedDate)}</time></span><span>Reviewed <time datetime={article.data.reviewedDate}>{fmt(article.data.reviewedDate)}</time></span><EvidenceLabel level={article.data.evidenceLevel}/>{article.data.hasAffiliateLinks&&<span class="paid-indicator">Contains paid links</span>}</div></header>
 <SetupArtwork name={article.data.artwork} eager />
 {article.data.hasAffiliateLinks&&<AffiliateDisclosure/>}
 <div class="setup-prose prose"><Content/></div>
 {article.data.hasAffiliateLinks&&<section class="paid-links" aria-labelledby="paid-links-heading"><h2 id="paid-links-heading">Optional comparison links</h2><p>These direct Amazon links are optional starting points after you have applied the criteria above.</p>{article.data.affiliateLinks.map(link=><PaidAmazonLink {...link}/>)}</section>}
 <nav class="article-next" aria-label="Quiet Setup next steps"><a href="/setup/">← All Quiet Setup guides</a><a href="/advertising/">How paid links work</a></nav>
</article>
</BaseLayout>
<style>
.setup-article{display:grid;gap:1.5rem;max-width:52rem;margin-inline:auto}.setup-article>header{display:grid;gap:.85rem;padding:.5rem 0 .75rem}.article-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;color:var(--muted);font-size:.82rem}.paid-indicator{padding:.22rem .55rem;border:1px solid #b7791f;border-radius:999px;color:#ffd58a;font-size:.73rem;font-weight:700}.setup-prose{display:grid;gap:1rem}.setup-prose :global(h2){margin-top:1.3rem;font-size:1.45rem}.setup-prose :global(p),.setup-prose :global(li){color:var(--muted);line-height:1.72}.setup-prose :global(a){color:var(--accent-strong);text-decoration:underline;text-underline-offset:3px}.paid-links{display:grid;gap:1rem;padding-top:1rem;border-top:1px solid var(--line)}.paid-links>p{color:var(--muted)}.article-next{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.7rem;padding-top:1.2rem;border-top:1px solid var(--line)}.article-next a{min-height:44px;color:var(--accent-strong);font-weight:700}
</style>
