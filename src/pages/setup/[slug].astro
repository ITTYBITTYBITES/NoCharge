---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SetupArtwork from '../../components/setup/SetupArtwork.astro';
import EvidenceLabel from '../../components/setup/EvidenceLabel.astro';
import AffiliateDisclosure from '../../components/setup/AffiliateDisclosure.astro';
import PaidAmazonLink from '../../components/setup/PaidAmazonLink.astro';
import { SETUP_TOPIC_LABELS } from '../../lib/setup-topics';

export async function getStaticPaths() {
  const entries = (await getCollection('setup')).filter((a) => !a.data.draft);
  return entries.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const path = `/setup/${article.id}/`;
const canonical = `https://nocharge.net${path}`;
const fmt = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const articleImages = [
  `https://nocharge.net/setup-art/${article.data.artwork}-800.jpg`,
  `https://nocharge.net/setup-art/${article.data.artwork}-1200.jpg`,
  `https://nocharge.net/setup-art/${article.data.artwork}-1600.jpg`,
];

const faqQuestions = [
  { q: `Do I need to buy ${article.data.title.toLowerCase()}?`, a: `No. Try no-purchase checks first: move, clean, adjust settings, and test existing ${SETUP_TOPIC_LABELS[article.data.topic].toLowerCase()} before browsing. This guide is useful without buying.` },
  { q: `What spec matters most for ${article.data.title.toLowerCase()}?`, a: `Size, connection type, material, adjustability, cleaning, cable routing, and return policy. Check compatibility with your desk, OS, and existing keyboard or pointing device.` },
  { q: `Does ${article.data.title.toLowerCase()} work without an account?`, a: `Yes. Quiet Setup guides are editorial research, no account needed. Any Amazon links are optional search starting points with tag nocharge-20 opening in a new tab.` },
  { q: `How does ${article.data.title.toLowerCase()} help with quiet play?`, a: `It compares observable tradeoffs like sound sources, space, and stability so you can reduce friction during browser game sessions without health or productivity promises.` },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: article.data.title,
    description: article.data.description,
    datePublished: `${article.data.publishedDate}T12:00:00Z`,
    dateModified: `${article.data.reviewedDate}T12:00:00Z`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    url: canonical,
    image: articleImages,
    author: { '@type': 'Organization', name: 'NoCharge Editorial', url: 'https://nocharge.net/' },
    publisher: {
      '@type': 'Organization',
      name: 'NoCharge',
      url: 'https://nocharge.net/',
      logo: { '@type': 'ImageObject', url: 'https://nocharge.net/icons/icon-512.png', width: 512, height: 512 },
    },
    articleSection: SETUP_TOPIC_LABELS[article.data.topic],
    keywords: article.data.topics.map((t) => SETUP_TOPIC_LABELS[t]).join(', '),
    inLanguage: 'en',
    isAccessibleForFree: true,
    isPartOf: { '@type': 'WebSite', '@id': 'https://nocharge.net/#website', name: 'NoCharge' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    '@id': `${canonical}#primaryimage`,
    contentUrl: `https://nocharge.net/setup-art/${article.data.artwork}-1600.jpg`,
    url: `https://nocharge.net/setup-art/${article.data.artwork}-1600.jpg`,
    caption: `${article.data.title} — ${SETUP_TOPIC_LABELS[article.data.topic]} editorial illustration, 16:9`,
    representativeOfPage: true,
    width: 1600,
    height: 900,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nocharge.net/' },
      { '@type': 'ListItem', position: 2, name: 'Quiet Setup', item: 'https://nocharge.net/setup/' },
      { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqQuestions.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  path={path}
  schema={schema}
  ogType="article"
  modifiedTime={article.data.reviewedDate}
  showAds={false}
  socialImage={`/setup-art/${article.data.artwork}-1200.jpg`}
  socialImageAlt={`${article.data.title} — ${SETUP_TOPIC_LABELS[article.data.topic]} illustration`}
  socialImageWidth={1200}
  socialImageHeight={675}
  additionalImages={[
    { url: `/setup-art/${article.data.artwork}-1200.jpg`, width: 1200, height: 675, alt: `${article.data.title} illustration 16:9` },
    { url: `/setup-art/${article.data.artwork}-pin-1000x1500.jpg`, width: 1000, height: 1500, alt: `Pinterest pin for ${article.data.title}` },
  ]}
>
  <article class="setup-article" data-setup-article data-has-affiliate-links={String(article.data.hasAffiliateLinks)}>
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Quiet Setup', href: '/setup/' }, { label: article.data.title }]}
    />

    <header>
      <p class="eyebrow">Quiet Setup · {SETUP_TOPIC_LABELS[article.data.topic]}</p>
      <h1 class="page-title">{article.data.title}</h1>
      <p class="lede">{article.data.description}</p>
      <div class="article-meta">
        <p class="article-meta__dates">
          <span>Published <time datetime={article.data.publishedDate}>{fmt(article.data.publishedDate)}</time></span>
          <span>Reviewed <time datetime={article.data.reviewedDate}>{fmt(article.data.reviewedDate)}</time></span>
        </p>
        <p class="article-meta__labels">
          <EvidenceLabel level={article.data.evidenceLevel} />
          {article.data.hasAffiliateLinks && <span class="paid-indicator" data-paid-indicator>Contains paid links</span>}
        </p>
      </div>
    </header>

    <SetupArtwork
      name={article.data.artwork}
      topic={article.data.topic}
      eager
      sizes="(max-width: 54rem) calc(100vw - 2rem), 52rem"
    />

    {article.data.hasAffiliateLinks && <AffiliateDisclosure />}

    <div class="setup-prose prose"><Content /></div>

    <section class="panel setup-faq" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">FAQ — {article.data.title}</h2>
      <dl>
        {faqQuestions.map(({ q, a }) => (
          <>
            <dt>{q}</dt>
            <dd>{a}</dd>
          </>
        ))}
      </dl>
    </section>

    <script>
      // Make scrollable tables keyboard accessible for axe: scrollable-region-focusable
      for (const table of document.querySelectorAll('.setup-prose table, .guide-prose table')) {
        if (table.scrollWidth > table.clientWidth) {
          table.setAttribute('tabindex', '0');
          table.setAttribute('role', 'region');
          table.setAttribute('aria-label', 'Data table, scrollable');
        }
      }
    </script>

    {
      article.data.hasAffiliateLinks && (
        <section class="paid-links" aria-labelledby="paid-links-heading">
          <h2 id="paid-links-heading">Optional comparison links</h2>
          <p>These direct Amazon links are optional starting points after you have applied the criteria above.</p>
          {article.data.affiliateLinks.map((link) => (
            <PaidAmazonLink {...link} />
          ))}
        </section>
      )
    }

    <nav class="article-next" aria-label="Quiet Setup next steps">
      <a href="/setup/">← All Quiet Setup guides</a>
      <a href="/advertising/">How paid links work</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .setup-article > header {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
    padding: 0.5rem 0 0.75rem;
  }

  /* Two deliberate metadata rows. Dates and chips never share a flex line, so
     a wrapped date can never end up beside a chip border, and the chips keep a
     visible band between them when they wrap. */
  .article-meta {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }

  .article-meta__dates,
  .article-meta__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.5rem;
    margin: 0;
    min-width: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .article-meta__labels {
    gap: 0.5rem 0.6rem;
  }

  .paid-indicator {
    display: inline-block;
    max-width: 100%;
    padding: 0.25rem 0.6rem;
    border: 1px solid #b7791f;
    border-radius: 0.55rem;
    color: #ffd58a;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .setup-prose {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .setup-article {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
    margin-inline: auto;
    min-width: 0;
  }

  .setup-faq {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    margin-top: 1rem;
  }

  .setup-faq h2 { font-size: 1.25rem; }
  .setup-faq dl { display: grid; gap: 0.6rem; margin: 0; }
  .setup-faq dt { color: var(--text); font-weight: 700; margin-top: 0.5rem; }
  .setup-faq dd { color: var(--muted); margin: 0; }

  .setup-prose :global(h2) {
    margin-top: 1.3rem;
    font-size: 1.45rem;
  }

  .setup-prose :global(p),
  .setup-prose :global(li) {
    color: var(--muted);
    line-height: 1.72;
  }

  .setup-prose :global(a) {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .setup-prose :global(table) {
    width: 100%;
    max-width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .setup-prose :global(table:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .setup-prose :global(th),
  .setup-prose :global(td) {
    border: 1px solid var(--line);
    padding: 0.5rem 0.6rem;
    text-align: left;
    font-size: 0.84rem;
    white-space: normal;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  @media (max-width: 30rem) {
    .setup-prose :global(th),
    .setup-prose :global(td) {
      font-size: 0.78rem;
      padding: 0.4rem;
    }
  }

  .setup-prose :global(th) {
    background: var(--panel-2);
    color: var(--text);
    font-weight: 700;
  }

  .setup-prose :global(blockquote) {
    margin: 0;
    padding: 0.85rem 1rem;
    border-left: 4px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--panel-2));
    border-radius: 0.5rem;
    color: var(--text);
  }

  .paid-links {
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .paid-links > p {
    color: var(--muted);
  }

  /* `space-between` put the two links flush against opposite edges and, once
     they wrapped, left them vertically adjacent with no separation. A wrapping
     row with an explicit gap keeps them apart in both states. */
  .article-next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .article-next a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .article-next a:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (min-width: 40rem) {
    .article-next {
      justify-content: space-between;
    }
  }

  @media (forced-colors: active) {
    .paid-indicator {
      border: 1px solid CanvasText;
    }
  }
</style>
