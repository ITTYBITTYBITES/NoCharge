---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GameCard from '../components/GameCard.astro';
import RecentlyPlayed from '../components/RecentlyPlayed.astro';
import { isPassPlayGameId } from '../games/shared/pass-play';
import { buildGameFacts, isNewRelease, isRecentlyUpdated } from '../lib/game-catalog';

const games = (await getCollection('games'))
  .filter((game) => !game.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const facts = buildGameFacts(games);
const chipFor = (slug: string) => {
  const item = facts.find((fact) => fact.slug === slug);
  if (!item) return [];
  const chips = [];
  if (isNewRelease(item)) chips.push({ label: 'New', kind: 'new' as const });
  else if (isRecentlyUpdated(item)) chips.push({ label: 'Updated', kind: 'updated' as const });
  return chips;
};
const cardProps = (slug: string) => {
  const item = facts.find((fact) => fact.slug === slug);
  return item
    ? {
        sessionMax: item.sessionMax,
        inputs: item.inputs,
        pressure: item.pressure,
        playersMode: item.players,
        releasedAt: item.releasedAt,
        updatedAt: item.updatedAt,
        chips: chipFor(slug),
      }
    : {};
};
const keyboardCompleteCount = facts.filter((fact) => fact.hasKeyboardComplete).length;
const untimedOrBothCount = facts.filter((fact) => fact.pressure !== 'timed').length;

// One arcade page, two sections: the solo games exactly as before, plus the
// Pass & Play section for two players on one device. The solo section keeps
// its established markup byte-for-byte; an anchor nav links the two.
const soloGames = games.filter((game) => !isPassPlayGameId(game.id));
const passPlayGames = games.filter((game) => isPassPlayGameId(game.id));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'NoCharge Arcade',
  description: 'A growing collection of quick browser games with no account required.',
  url: 'https://nocharge.net/arcade/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: games.length,
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.data.title,
      url: `https://nocharge.net/games/${game.id}/`,
    })),
  },
};
---

<BaseLayout
  title="Arcade"
  description="Play quick browser games with touch, mouse, or keyboard controls. No account required, and best scores stay on your device."
  path="/arcade/"
  schema={schema}
>
  <div class="arcade-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Arcade' }]} />

    <header class="arcade-hero">
      <p class="eyebrow">NoCharge Arcade</p>
      <h1 class="page-title">Small games built for real breaks.</h1>
      <p class="lede">
        Open a game, learn it in a minute, and play for as long as you like. Every title works in the browser,
        requires no account, and keeps its best score on this device.
      </p>
      <dl class="arcade-hero__facts">
        <div><dt>{games.length}</dt><dd>games available</dd></div>
        <div><dt>{keyboardCompleteCount}</dt><dd>keyboard-complete</dd></div>
        <div><dt>{untimedOrBothCount}</dt><dd>untimed or reduced-pressure</dd></div>
      </dl>
    </header>

    <nav class="arcade-sections-nav" aria-label="Arcade sections">
      <a href="#solo-games">Solo games</a>
      <span aria-hidden="true">·</span>
      <a href="#pass-and-play">Pass &amp; Play</a>
      <span aria-hidden="true">·</span>
      <a href="#arcade-filters">Filter</a>
    </nav>

    <RecentlyPlayed games={games} location="arcade" />

    <section class="arcade-filters panel" id="arcade-filters" aria-labelledby="arcade-filters-heading">
      <div class="arcade-filters__heading">
        <h2 id="arcade-filters-heading">Filter or sort the arcade</h2>
        <p>Filters use the same catalog facts as the Discovery Wheel: session, input, pace, and players. Without JavaScript the full list stays visible below.</p>
      </div>
      <div class="arcade-filters__controls" id="arcade-filter-controls">
        <label>Time
          <select id="arcade-time" aria-label="Filter by session length">
            <option value="any" selected>Any length</option>
            <option value="5">About 5 minutes or less</option>
            <option value="10">About 10 minutes or less</option>
            <option value="15">About 15 minutes or less</option>
          </select>
        </label>
        <label>Input
          <select id="arcade-input" aria-label="Filter by input">
            <option value="any" selected>Any input</option>
            <option value="keyboard">Keyboard</option>
            <option value="pointer">Pointer</option>
            <option value="touch">Touch</option>
          </select>
        </label>
        <label>Pressure
          <select id="arcade-pressure" aria-label="Filter by pace">
            <option value="any" selected>Any pace</option>
            <option value="untimed">Untimed / reduced pressure</option>
            <option value="timed">Timed</option>
            <option value="both">Both</option>
          </select>
        </label>
        <label>Players
          <select id="arcade-players" aria-label="Filter by players">
            <option value="any" selected>Any</option>
            <option value="solo">Solo</option>
            <option value="pass-and-play">Pass &amp; Play</option>
          </select>
        </label>
        <label>Sort
          <select id="arcade-sort" aria-label="Sort games">
            <option value="order" selected>Curated order</option>
            <option value="shortest">Shortest session first</option>
            <option value="longest">Longest session first</option>
            <option value="newest">Newest releases first</option>
            <option value="updated">Recently updated first</option>
            <option value="title">Title A–Z</option>
          </select>
        </label>
      </div>
      <p class="arcade-filters__status" id="arcade-filter-status" aria-live="polite">
        Showing {games.length} games. Chips mark catalog release dates: “New” is within 60 days of the catalog review; “Updated” means changed after release within the last 30 days.
      </p>
    </section>

    <span id="solo-games" class="arcade-anchor" aria-hidden="true"></span>
    <section class="arcade-list" aria-labelledby="all-games-heading">
      <div class="arcade-list__heading">
        <p class="section-kicker">Choose a game</p>
        <h2 id="all-games-heading">All arcade games</h2>
        <p>Memory, word, reflex, and logic play—each with a full guide when you want the details.</p>
      </div>
      <div class="arcade-grid">
        {
          soloGames.map((game) => (
            <GameCard
              slug={game.id}
              title={game.data.title}
              tagline={game.data.tagline}
              emoji={game.data.emoji}
              accent={game.data.accent}
              artwork={game.data.artwork}
              genre={game.data.genre}
              session={game.data.session}
              {...cardProps(game.id)}
            />
          ))
        }
      </div>
    </section>

    {
      passPlayGames.length > 0 && (
        <>
          <span id="pass-and-play" class="arcade-anchor" aria-hidden="true" />
          <section class="arcade-passplay" aria-labelledby="pass-and-play-heading">
            <div class="arcade-list__heading">
              <p class="section-kicker">Pass &amp; Play</p>
              <h2 id="pass-and-play-heading">Two players, one device.</h2>
              <p>
                Take turns on a single screen. Hand the device to a friend, or set it on the table and play face to
                face.
              </p>
            </div>
            <div class="arcade-grid">
              {passPlayGames.map((game) => (
                <GameCard
                  slug={game.id}
                  title={game.data.title}
                  tagline={game.data.tagline}
                  emoji={game.data.emoji}
                  accent={game.data.accent}
                  artwork={game.data.artwork}
                  genre={game.data.genre}
                  session={game.data.session}
                  {...cardProps(game.id)}
                />
              ))}
            </div>
          </section>
        </>
      )
    }

    <section class="arcade-notes panel" aria-labelledby="arcade-notes-heading">
      <div>
        <p class="section-kicker">How this arcade works</p>
        <h2 id="arcade-notes-heading">Designed around the game, not the funnel.</h2>
      </div>
      <div class="arcade-notes__grid">
        <article>
          <h3>Start without setup</h3>
          <p>There is no profile, password, download, or tutorial wall between the game page and the first move.</p>
        </article>
        <article>
          <h3>Use the controls you have</h3>
          <p>Games support touch and pointer input, with documented keyboard paths and an untimed Color Flip mode.</p>
        </article>
        <article>
          <h3>Keep your progress private</h3>
          <p>Best results use local browser storage. NoCharge does not receive or publish your game scores.</p>
          <p class="arcade-notes__link"><a href="/my-arcade/">View My Arcade</a></p>
        </article>
      </div>
    </section>

    <section class="arcade-guide-cta" aria-labelledby="arcade-guide-heading">
      <div>
        <p class="section-kicker">Need the rules?</p>
        <h2 id="arcade-guide-heading">Every game has a field guide.</h2>
        <p>Read exact controls, scoring details, accessibility notes, and strategies based on how the game works.</p>
      </div>
      <a class="btn btn--ghost" href="/guides/">Open the guide library</a>
    </section>
  </div>
</BaseLayout>

<script>
  const container = document.querySelector('#arcade-filter-controls');
  if (container) {
    const time = document.querySelector<HTMLSelectElement>('#arcade-time');
    const input = document.querySelector<HTMLSelectElement>('#arcade-input');
    const pressure = document.querySelector<HTMLSelectElement>('#arcade-pressure');
    const players = document.querySelector<HTMLSelectElement>('#arcade-players');
    const sort = document.querySelector<HTMLSelectElement>('#arcade-sort');
    const status = document.querySelector('#arcade-filter-status');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-game-card]'));

    const apply = () => {
      if (!time || !input || !pressure || !players || !sort) return;
      const maxMinutes = Number(time.value);
      const inputValue = input.value;
      const pressureValue = pressure.value;
      const playersValue = players.value;
      const sortValue = sort.value;
      const visible: HTMLElement[] = [];
      for (const card of cards) {
        const sessionMax = Number(card.dataset.sessionMax ?? 0);
        const inputs = (card.dataset.inputs ?? '').split(' ').filter(Boolean);
        const pressure = card.dataset.pressure ?? '';
        const playerMode = card.dataset.players ?? '';
        let show = true;
        if (maxMinutes > 0 && sessionMax > maxMinutes) show = false;
        if (inputValue !== 'any' && !inputs.includes(inputValue)) show = false;
        if (pressureValue !== 'any') {
          if (pressureValue === 'timed' && pressure === 'untimed') show = false;
          if (pressureValue === 'untimed' && pressure === 'timed') show = false;
          if (pressureValue === 'both' && pressure !== 'both') show = false;
        }
        if (playersValue !== 'any' && playerMode !== playersValue) show = false;
        card.hidden = !show;
        if (show) visible.push(card);
      }
      visible.sort((a, b) => {
        const aSession = Number(a.dataset.sessionMax ?? 0);
        const bSession = Number(b.dataset.sessionMax ?? 0);
        const aReleased = a.dataset.released ?? '';
        const bReleased = b.dataset.released ?? '';
        switch (sortValue) {
          case 'shortest': return aSession - bSession || a.textContent!.localeCompare(b.textContent!);
          case 'longest': return bSession - aSession || a.textContent!.localeCompare(b.textContent!);
          case 'newest': return bReleased.localeCompare(aReleased) || a.textContent!.localeCompare(b.textContent!);
          case 'updated': return (b.dataset.updated ?? '').localeCompare(a.dataset.updated ?? '') || a.textContent!.localeCompare(b.textContent!);
          case 'title': return a.textContent!.localeCompare(b.textContent!);
          default: return 0;
        }
      });
      for (const card of visible) card.parentElement?.append(card);
      const sections = Array.from(document.querySelectorAll<HTMLElement>('.arcade-list, .arcade-passplay'));
      for (const section of sections) {
        const anyCard = Array.from(section.querySelectorAll<HTMLElement>('[data-game-card]')).some((card) => !card.hidden);
        section.hidden = !anyCard;
      }
      const filterNote = [
        maxMinutes > 0 ? `up to ${maxMinutes} min` : 'any length',
        inputValue === 'any' ? 'any input' : inputValue,
        pressureValue === 'any' ? 'any pace' : pressureValue,
        playersValue === 'any' ? 'any players' : playersValue,
      ].join(' · ');
      if (status) status.textContent = `Showing ${visible.length} of ${cards.length} games — ${filterNote}.`;
    };
    for (const control of [time, input, pressure, players, sort]) control?.addEventListener('change', apply);
    apply();
  }
</script>

<style>
  .arcade-page {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
  }

  .arcade-hero {
    max-width: 54rem;
    padding: 1rem 0 0;
  }

  .arcade-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 38rem;
    margin: 1.5rem 0 0;
  }

  .arcade-hero__facts div {
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
  }

  .arcade-hero__facts dt {
    color: var(--accent-strong);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .arcade-hero__facts dd {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .arcade-filters {
    display: grid;
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }

  .arcade-filters__heading {
    display: grid;
    gap: 0.35rem;
    max-width: 46rem;
  }

  .arcade-filters__heading h2 {
    font-size: 1.3rem;
  }

  .arcade-filters__heading p,
  .arcade-filters__status {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .arcade-filters__controls {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
  }

  .arcade-filters__controls label {
    display: grid;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .arcade-filters__controls select {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--panel-2);
    color: var(--text);
  }

  .arcade-sections-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .arcade-sections-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Anchor targets sit just above each section so in-page jumps clear the
     sticky-less page header without changing section markup. */
  .arcade-anchor {
    display: block;
    scroll-margin-top: 1rem;
    height: 0;
  }

  .arcade-list,
  .arcade-passplay {
    display: grid;
    gap: 1.25rem;
  }

  .arcade-list__heading {
    display: grid;
    gap: 0.35rem;
    max-width: 44rem;
  }

  .arcade-list h2,
  .arcade-passplay h2,
  .arcade-notes h2,
  .arcade-guide-cta h2 {
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .arcade-list__heading > p:last-child,
  .arcade-guide-cta p:not(.section-kicker) {
    color: var(--muted);
  }

  .section-kicker {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .arcade-grid {
    display: grid;
    gap: 0.85rem;
  }

  .arcade-notes {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .arcade-notes > div:first-child {
    display: grid;
    gap: 0.4rem;
    max-width: 40rem;
  }

  .arcade-notes__grid {
    display: grid;
    gap: 1rem;
  }

  .arcade-notes article {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .arcade-notes h3 {
    font-size: 1rem;
  }

  .arcade-notes article p {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .arcade-notes__link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .arcade-guide-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: 0 0 1rem;
  }

  .arcade-guide-cta > div {
    display: grid;
    gap: 0.4rem;
    max-width: 44rem;
  }

  @media (min-width: 60rem) {
    .arcade-grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }

    .arcade-notes__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .arcade-hero__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
