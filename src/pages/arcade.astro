---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GameCard from '../components/GameCard.astro';
import RecentlyPlayed from '../components/RecentlyPlayed.astro';
import { isPassPlayGameId } from '../games/shared/pass-play';

const games = (await getCollection('games'))
  .filter((game) => !game.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// One arcade page, two sections: the solo games exactly as before, plus the
// Pass & Play section for two players on one device. The solo section keeps
// its established markup byte-for-byte; an anchor nav links the two.
const soloGames = games.filter((game) => !isPassPlayGameId(game.id));
const passPlayGames = games.filter((game) => isPassPlayGameId(game.id));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'NoCharge Arcade',
  description: 'A growing collection of quick browser games with no account required.',
  url: 'https://nocharge.net/arcade/',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: games.length,
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: game.data.title,
      url: `https://nocharge.net/games/${game.id}/`,
    })),
  },
};
---

<BaseLayout
  title="Arcade"
  description="Play quick browser games with touch, mouse, or keyboard controls. No account required, and best scores stay on your device."
  path="/arcade/"
  schema={schema}
>
  <div class="arcade-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Arcade' }]} />

    <header class="arcade-hero">
      <p class="eyebrow">NoCharge Arcade</p>
      <h1 class="page-title">Small games built for real breaks.</h1>
      <p class="lede">
        Open a game, learn it in a minute, and play for as long as you like. Every title works in the browser,
        requires no account, and keeps its best score on this device.
      </p>
      <dl class="arcade-hero__facts">
        <div><dt>{games.length}</dt><dd>games available</dd></div>
        <div><dt>0</dt><dd>accounts needed</dd></div>
        <div><dt>3</dt><dd>input styles supported</dd></div>
      </dl>
    </header>

    <nav class="arcade-sections-nav" aria-label="Arcade sections">
      <a href="#solo-games">Solo games</a>
      <span aria-hidden="true">·</span>
      <a href="#pass-and-play">Pass &amp; Play</a>
    </nav>

    <RecentlyPlayed games={games} location="arcade" />

    <span id="solo-games" class="arcade-anchor" aria-hidden="true"></span>
    <section class="arcade-list" aria-labelledby="all-games-heading">
      <div class="arcade-list__heading">
        <p class="section-kicker">Choose a game</p>
        <h2 id="all-games-heading">All arcade games</h2>
        <p>Memory, word, reflex, and logic play—each with a full guide when you want the details.</p>
      </div>
      <div class="arcade-grid">
        {
          soloGames.map((game) => (
            <GameCard
              slug={game.id}
              title={game.data.title}
              tagline={game.data.tagline}
              emoji={game.data.emoji}
              accent={game.data.accent}
              artwork={game.data.artwork}
              genre={game.data.genre}
              session={game.data.session}
            />
          ))
        }
      </div>
    </section>

    {
      passPlayGames.length > 0 && (
        <>
          <span id="pass-and-play" class="arcade-anchor" aria-hidden="true" />
          <section class="arcade-passplay" aria-labelledby="pass-and-play-heading">
            <div class="arcade-list__heading">
              <p class="section-kicker">Pass &amp; Play</p>
              <h2 id="pass-and-play-heading">Two players, one device.</h2>
              <p>
                Take turns on a single screen. Hand the device to a friend, or set it on the table and play face to
                face.
              </p>
            </div>
            <div class="arcade-grid">
              {passPlayGames.map((game) => (
                <GameCard
                  slug={game.id}
                  title={game.data.title}
                  tagline={game.data.tagline}
                  emoji={game.data.emoji}
                  accent={game.data.accent}
                  artwork={game.data.artwork}
                  genre={game.data.genre}
                  session={game.data.session}
                />
              ))}
            </div>
          </section>
        </>
      )
    }

    <section class="arcade-notes panel" aria-labelledby="arcade-notes-heading">
      <div>
        <p class="section-kicker">How this arcade works</p>
        <h2 id="arcade-notes-heading">Designed around the game, not the funnel.</h2>
      </div>
      <div class="arcade-notes__grid">
        <article>
          <h3>Start without setup</h3>
          <p>There is no profile, password, download, or tutorial wall between the game page and the first move.</p>
        </article>
        <article>
          <h3>Use the controls you have</h3>
          <p>Games support touch and pointer input, with documented keyboard paths and an untimed Color Flip mode.</p>
        </article>
        <article>
          <h3>Keep your progress private</h3>
          <p>Best results use local browser storage. NoCharge does not receive or publish your game scores.</p>
          <p class="arcade-notes__link"><a href="/my-arcade/">View My Arcade</a></p>
        </article>
      </div>
    </section>

    <section class="arcade-guide-cta" aria-labelledby="arcade-guide-heading">
      <div>
        <p class="section-kicker">Need the rules?</p>
        <h2 id="arcade-guide-heading">Every game has a field guide.</h2>
        <p>Read exact controls, scoring details, accessibility notes, and strategies based on how the game works.</p>
      </div>
      <a class="btn btn--ghost" href="/guides/">Open the guide library</a>
    </section>
  </div>
</BaseLayout>

<style>
  .arcade-page {
    display: grid;
    gap: clamp(2.5rem, 7vw, 5rem);
  }

  .arcade-hero {
    max-width: 54rem;
    padding: 1rem 0 0;
  }

  .arcade-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 38rem;
    margin: 1.5rem 0 0;
  }

  .arcade-hero__facts div {
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--panel);
  }

  .arcade-hero__facts dt {
    color: var(--accent-strong);
    font-size: 1.35rem;
    font-weight: 800;
  }

  .arcade-hero__facts dd {
    margin: 0.1rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .arcade-sections-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .arcade-sections-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Anchor targets sit just above each section so in-page jumps clear the
     sticky-less page header without changing section markup. */
  .arcade-anchor {
    display: block;
    scroll-margin-top: 1rem;
    height: 0;
  }

  .arcade-list,
  .arcade-passplay {
    display: grid;
    gap: 1.25rem;
  }

  .arcade-list__heading {
    display: grid;
    gap: 0.35rem;
    max-width: 44rem;
  }

  .arcade-list h2,
  .arcade-passplay h2,
  .arcade-notes h2,
  .arcade-guide-cta h2 {
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .arcade-list__heading > p:last-child,
  .arcade-guide-cta p:not(.section-kicker) {
    color: var(--muted);
  }

  .section-kicker {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .arcade-grid {
    display: grid;
    gap: 0.85rem;
  }

  .arcade-notes {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .arcade-notes > div:first-child {
    display: grid;
    gap: 0.4rem;
    max-width: 40rem;
  }

  .arcade-notes__grid {
    display: grid;
    gap: 1rem;
  }

  .arcade-notes article {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .arcade-notes h3 {
    font-size: 1rem;
  }

  .arcade-notes article p {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .arcade-notes__link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .arcade-guide-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: 0 0 1rem;
  }

  .arcade-guide-cta > div {
    display: grid;
    gap: 0.4rem;
    max-width: 44rem;
  }

  @media (min-width: 60rem) {
    .arcade-grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }

    .arcade-notes__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .arcade-hero__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
