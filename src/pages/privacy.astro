---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STORAGE_KEY_DOCS } from '../lib/storage-docs';

const documented = STORAGE_KEY_DOCS.filter((doc) => !doc.planned);
const planned = STORAGE_KEY_DOCS.filter((doc) => doc.planned);
---

<BaseLayout
  title="Privacy"
  description="How NoCharge handles analytics, Google advertising, and data stored on your device."
  path="/privacy/"
  showAds={false}
>
  <article class="privacy">
    <a class="back-link" href="/">← Home</a>
    <header>
      <h1 class="page-title">Privacy</h1>
      <p class="lede">The short version: no accounts, and game data stays on your device.</p>
      <p class="privacy__updated">Last updated: August 21, 2026</p>
    </header>

    <div class="privacy__body panel">
      <section aria-labelledby="privacy-choices">
        <h2 id="privacy-choices">Your privacy choices</h2>
        <p>
          Analytics is off by default and loads only after you allow it. You can review or withdraw that choice at
          any time; necessary storage remains available for this choice and local game features. Advertising choices
          are separate and are shown by Google&rsquo;s own consent message.
        </p>
        <button class="btn btn--ghost btn--sm" type="button" data-consent-open>Review analytics choices</button>
        <p class="privacy__status" data-consent-summary aria-live="polite">Loading your current choices…</p>
      </section>

      <section aria-labelledby="local-data">
        <h2 id="local-data">Data on your device</h2>
        <p>
          NoCharge uses your browser’s local storage for high scores, game preferences, your shared sound
          preference, Recently Played, and one most-recent match record per Pass &amp; Play game. Recently Played
          stores only up to four stable game IDs and last-played timestamps after meaningful game interactions, and
          Pass &amp; Play match records store a mode, result, match score, and date — never player names. This
          information stays only in this browser, is not uploaded to NoCharge, and remains until you clear it in
          your browser or use the button below.
        </p>
        <p>
          The newer solo games also store only local progress: Klondike and FreeCell wins and Klondike draw-mode
          preference, Nonogram puzzles revealed, the largest Twenty Forty-Eight tile, Tile Garden&rsquo;s best tier, and
          Color Flip&rsquo;s rotation preference. Clear game data removes these values along with local scores, the shared
          sound preference, Recently Played, and Pass &amp; Play match records. It does not remove your NoCharge
          analytics consent choice, which stays saved so analytics remain exactly as you left it. Google Privacy
          &amp; messaging choices are handled separately by Google.
        </p>
        <button class="btn btn--ghost btn--sm" type="button" data-clear-games>Clear game data</button>
        <p class="privacy__status" data-game-status aria-live="polite"></p>
        <h3>Every NoCharge storage key</h3>
        <p>
          The table below is generated from the same allowlist that “Clear game data” removes, so documentation and
          deletion cannot drift. Daily keys marked <em>planned</em> are listed for transparency but are not written
          until the daily games ship.
        </p>
        <section class="privacy__table" aria-label="NoCharge storage keys" tabindex="0">
          <table>
            <thead><tr><th>Key</th><th>Written by</th><th>Kind</th><th>Purpose</th></tr></thead>
            <tbody>
              {documented.map((doc) => (
                <tr>
                  <td><code>{doc.key}</code></td>
                  <td>{doc.owner}</td>
                  <td>{doc.category}</td>
                  <td>{doc.purpose}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
        {planned.length > 0 && (
          <>
            <h3>Planned keys (not yet written)</h3>
            <section class="privacy__table" aria-label="Planned NoCharge storage keys" tabindex="0">
              <table>
                <thead><tr><th>Key</th><th>Written by</th><th>Purpose</th></tr></thead>
                <tbody>
                  {planned.map((doc) => (
                    <tr><td><code>{doc.key}</code></td><td>{doc.owner}</td><td>{doc.purpose}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>
          </>
        )}
      </section>

      <section aria-labelledby="my-arcade">
        <h2 id="my-arcade">My Arcade</h2>
        <p>
          <a href="/my-arcade/">My Arcade</a> is a page that displays game information already stored in the browser
          you are using. It does not create an account, does not upload or build a player profile, and does not
          synchronize anything between browsers or devices. Its summaries are derived on demand from the same game
          scores, game progress, and Recently Played values described above; it does not create a separate store of
          its own and does not read your consent choices.
        </p>
        <p>
          Clearing game data — from this page or from the matching control on My Arcade — removes the underlying
          values, so the dashboard becomes empty. Your analytics consent choice remains separate and unchanged, and
          Google Privacy &amp; messaging choices are still handled by Google.
        </p>
      </section>

      <section aria-labelledby="analytics">
        <h2 id="analytics">Analytics</h2>
        <p>
          If you allow analytics, NoCharge loads Google Analytics to understand broad usage such as page visits
          and device types. We request IP anonymization, but your browser still connects directly to Google and
          Google may use browser identifiers or cookies. The tag is not requested when analytics is off. See the
          <a href="https://policies.google.com/privacy">Google Privacy Policy</a>. With analytics consent, NoCharge may also
          send a privacy-limited technical exception category to this same analytics path to help identify site errors.
          It does not send game selections, Word Tile Rush words, form text, local storage, URL queries, or fragments.
        </p>
      </section>

      <section aria-labelledby="advertising">
        <h2 id="advertising">Google advertising</h2>
        <p>
          NoCharge shows one manual, responsive Google AdSense banner near the bottom of eligible pages. The banner
          is labeled &ldquo;Advertisement&rdquo; and never appears over gameplay or inside game controls. Auto ads are
          off, and NoCharge does not run interstitials, anchors, popups, popunders, or sponsored Smartlink fallbacks.
        </p>
        <p>
          Google Privacy &amp; messaging is the advertising consent platform: where applicable, Google shows its
          consent message before any advertising is served. You can review or withdraw your Google advertising
          choices at any time using the Privacy and cookie settings control, which reopens Google&rsquo;s message.
          See the <a href="/advertising/">Advertising Disclosure</a> for details.
        </p>
        <button class="btn btn--ghost btn--sm" type="button" data-google-ad-choices>Privacy and cookie settings</button>
        <p>
          When a banner loads, your browser connects directly to Google, and Google may use cookies or similar
          storage and process data such as your IP address, browser and device details, page context, consent
          signals, measurement data, and information about ad interactions. This processing is governed by Google&rsquo;s
          own policies; see the
          <a href="https://policies.google.com/privacy">Google Privacy Policy</a> and
          <a href="https://policies.google.com/technologies/partner-sites">How Google uses information from sites that use Google services</a>.
        </p>
      </section>

      <section aria-labelledby="amazon-links">
        <h2 id="amazon-links">Outbound Amazon links</h2>
        <p>Some Quiet Setup articles contain clearly marked paid links that take you directly to Amazon. When you follow one, you leave NoCharge and your browser connects to Amazon; Amazon&rsquo;s own cookies, privacy practices, and checkout policies apply. NoCharge may receive commission reporting for qualifying activity, but NoCharge does not receive or claim to know your complete Amazon order details. See the <a href="/advertising/">Advertising Disclosure</a>.</p>
      </section>

      <section aria-labelledby="accounts-retention">
        <h2 id="accounts-retention">Accounts and retention</h2>
        <p>
          NoCharge has no user accounts, passwords, or database of player scores. Local game data remains on
          your device until you remove it. Google controls retention for the analytics and advertising information
          it processes under its own policies.
        </p>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">Contact</h2>
        <p>
          NoCharge is a general-audience website and is not directed to children. For privacy questions or
          requests, or to report a problematic advertisement, email
          <a href="mailto:hello@nocharge.net">hello@nocharge.net</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  import {
    CLEAR_GAME_DATA_FAILURE,
    CLEAR_GAME_DATA_SUCCESS,
    clearLocalGameData,
  } from '../lib/local-game-data';

  const clearGames = document.querySelector<HTMLButtonElement>('[data-clear-games]');
  const gameStatus = document.querySelector<HTMLElement>('[data-game-status]');

  clearGames?.addEventListener('click', () => {
    // The allowlist lives in one shared module so Privacy and My Arcade can
    // never diverge. The privacy/consent key is intentionally omitted, so
    // clearing game data never touches the consent choice, its categories,
    // timestamp, or schema version. Google's own Privacy & messaging storage
    // and unrelated origin storage are left untouched.
    let storage: Storage | undefined;
    try {
      storage = window.localStorage;
    } catch {
      storage = undefined;
    }
    const cleared = clearLocalGameData(storage);
    if (gameStatus) gameStatus.textContent = cleared ? CLEAR_GAME_DATA_SUCCESS : CLEAR_GAME_DATA_FAILURE;
  });
</script>

<style>
  .privacy {
    display: grid;
    gap: 0.85rem;
    max-width: 46rem;
  }

  .privacy__updated {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .privacy__body {
    display: grid;
    gap: 1.5rem;
    padding: 1.25rem 1.3rem;
    margin-top: 0.5rem;
    min-width: 0;
  }

  .privacy__body section {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
    min-width: 0;
  }

  .privacy__body section + section {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .privacy__body h2 {
    color: var(--text);
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }

  .privacy__body p {
    color: var(--muted);
  }

  .privacy__body a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .privacy__status {
    min-height: 1.3rem;
    font-size: 0.85rem;
  }

  .privacy__body h3 {
    margin-top: 0.6rem;
    font-size: 0.95rem;
  }

  .privacy__table {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
  }

  .privacy__table:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }

  .privacy__table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    text-align: left;
  }

  .privacy__table th,
  .privacy__table td {
    padding: 0.45rem 0.55rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .privacy__table th {
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .privacy__table code {
    color: var(--text);
  }
</style>
