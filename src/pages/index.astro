---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import GuideCard from '../components/GuideCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RecentlyPlayed from '../components/RecentlyPlayed.astro';
import { isPassPlayGameId } from '../games/shared/pass-play';

const allGames = (await getCollection('games'))
  .filter((game) => !game.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const featuredGames = allGames.filter((game) => game.data.featured);
const gameById = new Map(allGames.map((game) => [game.id, game]));
// The Pass & Play section renders only when pass-and-play content exists and
// highlights three of its games, plus a See all link to the collection.
const passPlayGames = allGames.filter((game) => isPassPlayGameId(game.id));
const passPlayHighlights = ['tic-tac-toe', 'dots-and-boxes', 'pass-the-picture']
  .map((id) => passPlayGames.find((game) => game.id === id))
  .filter((game) => game !== undefined);
const featuredGuides = (await getCollection('guides'))
  .filter((guide) => !guide.data.draft && guide.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const featuredArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured && article.data.kind === 'game')
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
---

<BaseLayout
  title="NoCharge — Free Browser Games"
  description="Play 17 browser games at no charge and without an account. Explore puzzle, card, word, and Pass & Play games with documented local-only results."
  path="/"
  feedHref="/feed.xml"
>
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow">Free browser games — no account</p>
        <h1 class="page-title" id="home-title">Quick games.<br />Clear guides. No clutter.</h1>
        <p class="lede">
          NoCharge has 17 browser games available at no charge, including solo puzzles, card games, word games, and six Pass &amp; Play choices for two people on one device. Documented results stay in this browser, and optional ambient audio stops when the page is hidden.
        </p>
        <div class="home-hero__actions">
          <a class="btn" href="/arcade/">Enter the arcade</a>
          <a class="btn btn--ghost" href="/guides/">Browse game guides</a>
        </div>
      </div>

      <aside class="home-hero__card panel" aria-label="What to expect">
        <p class="home-hero__card-label">What to expect</p>
        <ul>
          <li><span aria-hidden="true">↗</span><strong>Play immediately</strong><small>No login or install</small></li>
          <li><span aria-hidden="true">◎</span><strong>Learn the details</strong><small>Rules, scoring, and controls</small></li>
          <li><span aria-hidden="true">◇</span><strong>Keep it local</strong><small>Scores stay on this device</small></li>
        </ul>
      </aside>
    </section>

    <RecentlyPlayed games={allGames} location="home" />

    <section class="home-section" id="games" aria-labelledby="featured-games-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Featured now</p>
          <h2 id="featured-games-heading">Start in the arcade</h2>
          <p>Small games, each designed for a quick session on phone or desktop.</p>
        </div>
        <a class="section-link" href="/arcade/">See the full arcade →</a>
      </div>
      <div class="card-grid card-grid--games">
        {
          featuredGames.map((game) => (
            <GameCard
              slug={game.id}
              title={game.data.title}
              tagline={game.data.tagline}
              emoji={game.data.emoji}
              accent={game.data.accent}
              artwork={game.data.artwork}
              genre={game.data.genre}
              session={game.data.session}
              players={isPassPlayGameId(game.id) ? 2 : undefined}
            />
          ))
        }
      </div>
    </section>

    {
      passPlayHighlights.length > 0 && (
        <section class="home-section" id="pass-and-play" aria-labelledby="pass-play-heading">
          <div class="section-heading">
            <div>
              <p class="section-kicker">Play together</p>
              <h2 id="pass-play-heading">Pass &amp; Play</h2>
              <p class="home-pass-play__tagline">Two players, one device.</p>
              <p>
                Take turns on a single screen. Hand the device to a friend, or set it on the table and play face to
                face. No accounts, no setup — the device keeps the score, and you pass it back and forth.
              </p>
            </div>
            <a class="section-link" href="/collections/pass-and-play/">
              See all<span class="sr-only"> Pass &amp; Play games</span> →
            </a>
          </div>
          <div class="card-grid card-grid--games">
            {passPlayHighlights.map((game) => (
              <GameCard
                slug={game.id}
                title={game.data.title}
                tagline={game.data.tagline}
                emoji={game.data.emoji}
                accent={game.data.accent}
                artwork={game.data.artwork}
                genre={game.data.genre}
                session={game.data.session}
                players={2}
              />
            ))}
          </div>
        </section>
      )
    }

    <section class="home-library panel" aria-labelledby="library-heading">
      <div class="home-library__intro">
        <p class="section-kicker">More than a game grid</p>
        <h2 id="library-heading">A growing play library</h2>
        <p>
          The arcade is one part of NoCharge. Around it is a small reference shelf for choosing a game, learning its
          controls, and finding a useful next read when you want more context.
        </p>
      </div>
      <div class="home-library__points">
        <article>
          <span aria-hidden="true">01</span>
          <h3>Instant play</h3>
          <p>Open a game and start without an account, download, or onboarding maze.</p>
        </article>
        <article>
          <span aria-hidden="true">02</span>
          <h3>Useful explanations</h3>
          <p>Guides document real controls and scoring instead of padding pages with generic advice.</p>
        </article>
        <article>
          <span aria-hidden="true">03</span>
          <h3>Respectful defaults</h3>
          <p>Optional analytics stays off until you allow it. Privacy and data choices are explained on the trust pages.</p>
        </article>
      </div>
    </section>

    <section class="home-section" aria-labelledby="featured-guides-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Player notes</p>
          <h2 id="featured-guides-heading">Understand the game before the next run</h2>
          <p>Short, specific guides to rules, controls, scoring, and better decisions.</p>
        </div>
        <a class="section-link" href="/guides/">Explore all guides →</a>
      </div>
      <div class="card-grid card-grid--guides">
        {
          featuredGuides.map((guide) => {
            const game = gameById.get(guide.data.game);
            if (!game) return null;
            return (
              <GuideCard
                slug={guide.id}
                title={guide.data.title}
                description={guide.data.description}
                gameTitle={game.data.title}
                emoji={game.data.emoji}
                accent={game.data.accent}
                readTime={guide.data.readTime}
              />
            );
          })
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="featured-articles-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Play notes</p>
          <h2 id="featured-articles-heading">One useful idea for the next run</h2>
          <p>Focused original articles on the systems inside each game.</p>
        </div>
        <a class="section-link" href="/articles/">Explore all articles →</a>
      </div>
      <div class="card-grid card-grid--articles">
        {
          featuredArticles.map((article) => {
            if (article.data.kind !== 'game') return null;
            const game = gameById.get(article.data.game);
            if (!game) return null;
            return (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                label={game.data.title}
                readTime={article.data.readTime}
                published={article.data.published}
                topics={article.data.topics}
                accent={game.data.accent}
              />
            );
          })
        }
      </div>
    </section>

    <section class="home-faq" aria-labelledby="home-faq-heading">
      <div class="home-faq__heading">
        <p class="section-kicker">Good to know</p>
        <h2 id="home-faq-heading">Before you play</h2>
      </div>
      <div class="home-faq__items">
        <details>
          <summary>Are the browser games available at no charge?</summary>
          <p>Yes. Every published game opens without an account, subscription, or required purchase. Eligible pages can show one labeled advertisement outside gameplay.</p>
        </details>
        <details>
          <summary>What does the name NoCharge mean?</summary>
          <p>NoCharge is the one-word brand name for this free browser-game library. It refers to game access; it does not claim that internet service, hardware, electricity, or optional third-party purchases have no cost.</p>
        </details>
        <details>
          <summary>Where are best scores stored?</summary>
          <p>Scores are stored in local storage on your current browser. They are not uploaded or synced. Clear via Privacy or My Arcade.</p>
        </details>
        <details>
          <summary>Do the games work on mobile and keyboard?</summary>
          <p>
            Each game supports phone and desktop input. Memory Match, Word Tile Rush, and Beacon Lattice have native keyboard
            controls, and Color Flip includes both keyboard play and an untimed turn-based mode. Game Mode expands the board to fill viewport with no scroll.
          </p>
        </details>
        <details>
          <summary>What else will NoCharge publish?</summary>
          <p>
            The library will grow with more small games, detailed player guides, accessibility notes, and useful
            explainers connected to the arcade. Quiet Setup has 30 guides in each of seven topics—210 total—covering keyboards, pointing devices, screens, desks, puzzles, audio, and lighting.
          </p>
        </details>
        <details>
          <summary>Where can I compare all games?</summary>
          <p>The Arcade lists every published game. The collections narrow the catalog by practical criteria, and the Discovery Wheel filters it by time, input, pace, and number of players.</p>
        </details>
      </div>
    </section>

    <section class="home-cta panel" aria-labelledby="home-cta-heading">
      <div>
        <p class="section-kicker">Choose your next stop</p>
        <h2 id="home-cta-heading">Play a round or learn the system.</h2>
        <p>Both sides of the library are open—no account required.</p>
      </div>
      <div class="home-cta__actions">
        <a class="btn" href="/arcade/">Open the arcade</a>
        <a class="btn btn--ghost" href="/guides/">Read the guides</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    gap: clamp(3.25rem, 8vw, 6.5rem);
  }

  .home-hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    min-height: min(40rem, 72vh);
    padding: clamp(2rem, 8vw, 6rem) 0;
  }

  .home-hero__copy {
    max-width: 47rem;
  }

  .home-hero .page-title {
    max-width: 46rem;
    font-size: clamp(2.75rem, 8vw, 5.8rem);
  }

  .home-hero .lede {
    max-width: 43rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
  }

  .home-hero__actions,
  .home-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.4rem;
  }

  .home-hero__card {
    padding: 1.2rem;
    background:
      linear-gradient(145deg, rgba(15, 157, 88, 0.12), transparent 55%),
      var(--panel);
  }

  .home-hero__card-label {
    margin-bottom: 0.8rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__card ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-hero__card li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.05rem 0.7rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .home-hero__card li > span {
    grid-row: 1 / 3;
    color: var(--accent-strong);
    font-size: 1.25rem;
  }

  .home-hero__card strong {
    font-size: 0.94rem;
  }

  .home-hero__card small {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .home-section {
    display: grid;
    gap: 1.25rem;
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .section-heading > div {
    display: grid;
    gap: 0.35rem;
    max-width: 45rem;
  }

  .section-heading h2,
  .home-library h2,
  .home-faq h2,
  .home-cta h2 {
    font-size: clamp(1.65rem, 4vw, 2.45rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .section-heading p:not(.section-kicker),
  .home-library__intro > p:last-child,
  .home-cta p:not(.section-kicker) {
    color: var(--muted);
  }

  .section-kicker {
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-pass-play__tagline {
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .card-grid {
    display: grid;
    gap: 0.85rem;
  }

  .home-library {
    display: grid;
    gap: 2rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }

  .home-library__intro {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    max-width: 42rem;
  }

  .home-library__points {
    display: grid;
    gap: 1rem;
  }

  .home-library__points article {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .home-library__points span {
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .home-library__points h3 {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .home-library__points p {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .home-faq {
    display: grid;
    gap: 1.25rem 3rem;
  }

  .home-faq__heading {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .home-faq__items {
    border-top: 1px solid var(--line);
  }

  .home-faq details {
    border-bottom: 1px solid var(--line);
  }

  .home-faq summary {
    padding: 1rem 0;
    cursor: pointer;
    font-weight: 700;
  }

  .home-faq details p {
    max-width: 46rem;
    padding: 0 0 1.1rem;
    color: var(--muted);
  }

  .home-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: 1rem;
  }

  .home-cta > div:first-child {
    display: grid;
    gap: 0.45rem;
    max-width: 42rem;
  }

  .home-cta__actions {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.75fr);
    }

    .home-library {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 1fr);
    }

    .home-faq {
      grid-template-columns: minmax(14rem, 0.55fr) minmax(0, 1.45fr);
    }
  }

  @media (min-width: 60rem) {
    .card-grid--games,
    .card-grid--guides,
    .card-grid--articles,
    .home-library__points {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }

    .home-library {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .home-hero__actions .btn,
    .home-cta__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
