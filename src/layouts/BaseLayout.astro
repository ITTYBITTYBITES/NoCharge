---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSenseBanner from '../components/AdSenseBanner.astro';
import ConsentManager from '../components/ConsentManager.astro';
import SeoHead from '../components/SeoHead.astro';
import { ADSENSE_CONSENT_TAG_URL } from '../config/adsense';
import { siteModeBootstrapScript } from '../lab/mode/mode-toggle';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  showAds?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  modifiedTime?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  feedHref?: string;
  additionalImages?: { url: string; width: number; height: number; alt?: string }[];
  /**
   * Which section this page belongs to. Rendered server-side as
   * `data-site-mode` so it is correct on the first byte and can never flash.
   *
   * This is not the visitor's stored preference — that is
   * `data-site-preference`, applied by the bootstrap script in <head>. The two
   * answer different questions: "what is this page?" versus "what did this
   * visitor choose?". See src/lab/mode/mode-toggle.ts.
   */
  siteMode?: 'calm' | 'lab';
  /**
   * Narrowly-scoped Content-Security-Policy additions.
   *
   * The Lab section may need to load a non-Google ad network. Those hosts are
   * added here, per route, so the calm site's policy is never widened to
   * accommodate a section a given visitor may never open. Sources are host
   * names only — no scheme wildcards, no 'unsafe-eval'.
   */
  /**
   * Lab identity token set. Applied as `data-lab-theme` on <html>; see
   * src/styles/lab.css for the three candidate identities.
   */
  labTheme?: 'lab' | 'overdrive' | 'raw';
  /**
   * Drop the site header, footer, and ad banner and let the page fill the
   * viewport. Used by Lab prototypes, which supply their own HUD and exit
   * control — the same reasoning as the calm site's Game Mode, where page
   * chrome is out of view during play.
   */
  fullBleed?: boolean;
  extraCsp?: {
    scriptSrc?: readonly string[];
    frameSrc?: readonly string[];
    imgSrc?: readonly string[];
    connectSrc?: readonly string[];
  };
}

const {
  title = 'NoCharge',
  description = 'Quick browser games, clear player guides, and no account required.',
  path = '/',
  canonicalPath,
  noIndex = false,
  showAds = true,
  schema,
  ogType = 'website',
  modifiedTime,
  socialImage,
  socialImageAlt,
  socialImageWidth,
  socialImageHeight,
  feedHref,
  additionalImages = [],
  siteMode = 'calm',
  extraCsp,
  labTheme,
  fullBleed = false,
} = Astro.props;

const isProd = import.meta.env.PROD;

/**
 * Build the Content-Security-Policy. Identical to the calm site's policy
 * unless `extraCsp` widens a specific directive for this route.
 */
const sources = (base: string, added: readonly string[] | undefined) =>
  added && added.length ? `${base} ${added.join(' ')}` : base;

const CONTENT_SECURITY_POLICY = [
  `default-src 'self'`,
  `base-uri 'self'`,
  `object-src 'none'`,
  sources(
    `script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://fundingchoicesmessages.google.com`,
    extraCsp?.scriptSrc,
  ),
  `style-src 'self' 'unsafe-inline'`,
  sources(
    `img-src 'self' data: https://www.google-analytics.com https://*.google-analytics.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net https://securepubads.g.doubleclick.net https://www.google.com`,
    extraCsp?.imgSrc,
  ),
  `font-src 'self'`,
  `media-src 'self'`,
  sources(
    `connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://securepubads.g.doubleclick.net https://tpc.googlesyndication.com https://fundingchoicesmessages.google.com https://www.google.com https://*.adtrafficquality.google`,
    extraCsp?.connectSrc,
  ),
  sources(
    `frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://fundingchoicesmessages.google.com`,
    extraCsp?.frameSrc,
  ),
  `form-action 'self'`,
].join(';');
const release = import.meta.env.PUBLIC_RELEASE ?? '1.0.0';
---

<!doctype html>
<html lang="en" data-release={release} data-site-mode={siteMode} data-lab-theme={labTheme}>
  <head>
    <meta charset="utf-8" />
    <!--
      Site-mode bootstrap. Runs blocking and before any stylesheet resolves so
      the Lab navigation link never paints and then disappear. Kept to a few
      statements on purpose; see src/lab/mode/mode-toggle.ts.
    -->
    <script is:inline set:html={siteModeBootstrapScript()} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <SeoHead
      title={title}
      description={description}
      path={path}
      canonicalPath={canonicalPath}
      noIndex={noIndex}
      schema={schema}
      ogType={ogType}
      modifiedTime={modifiedTime}
      socialImage={socialImage}
      socialImageAlt={socialImageAlt}
      socialImageWidth={socialImageWidth}
      socialImageHeight={socialImageHeight}
      feedHref={feedHref}
      additionalImages={additionalImages}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#121212" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={CONTENT_SECURITY_POLICY} />
    {
      isProd && (
        <>
          <!--
            Official Google Privacy & messaging (Funding Choices) message tag.
            Google's consent message is the advertising consent platform; the
            AdSense tag reads its choices itself. Loaded on every page so the
            "Privacy and cookie settings" revocation link works everywhere.
          -->
          <script is:inline async src={ADSENSE_CONSENT_TAG_URL}></script>
          <script is:inline>
            (function() {function signalGooglefcPresent() {if (!window.frames['googlefcPresent']) {if (document.body) {const iframe = document.createElement('iframe'); iframe.style = 'width: 0; height: 0; border: none; z-index: -1000; left: -1000px; top: -1000px;'; iframe.style.display = 'none'; iframe.name = 'googlefcPresent'; document.body.appendChild(iframe);} else {setTimeout(signalGooglefcPresent, 0);}}}signalGooglefcPresent();})();
          </script>
        </>
      )
    }
    {
      isProd && (
        <script is:inline>
          (() => {
            const measurementId = 'G-GYQ8TEM6DS';
            let loaded = false;

            const removeAnalyticsCookies = () => {
              document.cookie.split(';').forEach((cookie) => {
                const name = cookie.split('=')[0]?.trim();
                if (!name?.startsWith('_ga')) return;
                document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax`;
                document.cookie = `${name}=; Max-Age=0; Path=/; Domain=${location.hostname}; SameSite=Lax`;
              });
            };

            const loadAnalytics = () => {
              if (loaded) return;
              loaded = true;
              window[`ga-disable-${measurementId}`] = false;
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                window.dataLayer.push(arguments);
              };
              window.gtag('consent', 'default', {
                analytics_storage: 'granted',
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied',
              });
              window.gtag('js', new Date());
              window.gtag('config', measurementId, {
                page_path: location.pathname,
                anonymize_ip: true,
              });

              const script = document.createElement('script');
              script.async = true;
              script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
              document.head.appendChild(script);
            };

            const applyAnalyticsConsent = (allowed) => {
              if (allowed) {
                if (loaded) {
                  window[`ga-disable-${measurementId}`] = false;
                  window.gtag?.('consent', 'update', { analytics_storage: 'granted' });
                } else {
                  loadAnalytics();
                }
                return;
              }

              window[`ga-disable-${measurementId}`] = true;
              window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
              removeAnalyticsCookies();
            };

            window.addEventListener('nocharge:consentchange', (event) => {
              applyAnalyticsConsent(!!event.detail?.analytics);
            });
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {
      fullBleed ? (
        <main class="site-main site-main--bleed" id="main-content">
          <slot />
        </main>
      ) : (
        <div class="site-shell">
          <Header />
          <main class="site-main" id="main-content">
            <slot />
          </main>
          {isProd && showAds && <AdSenseBanner />}
          <Footer />
        </div>
      )
    }
    <ConsentManager />
    <script>
      import { startPrivacyAwareErrorReporting } from '../lib/error-monitoring';

      startPrivacyAwareErrorReporting(document.documentElement.dataset.release ?? '1.0.0');
    </script>
  </body>
</html>
